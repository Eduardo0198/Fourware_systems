<aside class="sidebar" id="sidebar">
    <div>
        <div class="sidebar-header">
            <h2 class="logo">PPG</h2>
        </div>

        <% if (usuario) { %>

            <% if (usuario.roles.includes('Administrador')) { %>

                <p class="section-title">Administrador</p>

                <a href="/admin/inicio" class="menu">
                    <i class="bi bi-house"></i>
                    <span>Inicio</span>
                </a>

                <a href="/admin/catalogo" class="menu">
                    <i class="bi bi-box"></i>
                    <span>Catálogo</span>
                </a>

                <a href="/admin/campanas" class="menu">
                    <i class="bi bi-megaphone"></i>
                    <span>Campañas</span>
                </a>

                <a href="/admin/reportes" class="menu">
                    <i class="bi bi-bar-chart"></i>
                    <span>Reportes</span>
                </a>
      
                <a href="/admin/auditoria" class="menu">
                    <i class="bi bi-journal-text"></i>
                    <span>Bitácora</span>
                </a>

                <p class="section-title">Vista concesionario</p>

                <a href="/concesionario/home" class="menu">
                    <i class="bi bi-eye"></i>
                    <span>Inicio</span>
                </a>

                <a href="/concesionario/catalogo" class="menu">
                    <i class="bi bi-grid"></i>
                    <span>Catálogo</span>
                </a>

            <% } %>

            <% if (usuario.roles.includes('Logistica')) { %>

                <p class="section-title">Logística</p>

                <a href="/logistica/reservas-confirmadas" class="menu">
                    <i class="bi bi-truck"></i>
                    <span>Reservas</span>
                </a>

                <a href="/logistica/metricas" class="menu">
                    <i class="bi bi-speedometer"></i>
                    <span>Métricas</span>
                </a>

            <% } %>

            <% if (usuario.roles.includes('Marketing')) { %>

                <p class="section-title">Marketing</p>

                <a href="/marketing/metricas-comparativas" class="menu">
                    <i class="bi bi-graph-up"></i>
                    <span>Métricas</span>
                </a>

                <a href="/marketing/metricas-ranking" class="menu">
                    <i class="bi bi-trophy"></i>
                    <span>Calificaciones</span>
                </a>

            <% } %>

            <% if (usuario.roles.includes('Concesionario')) { %>

                <p class="section-title">Concesionario</p>

                <a href="/concesionario/home" class="menu">
                    <i class="bi bi-house"></i>
                    <span>Inicio</span>
                </a>

                <a href="/concesionario/catalogo" class="menu">
                    <i class="bi bi-grid"></i>
                    <span>Catálogo</span>
                </a>

                <a href="/concesionario/carrito" class="menu"> 
                    <i class="bi bi-cart"></i>
                    <span>Carrito</span>
                </a>

                <a href="/concesionario/reservas" class="menu">
                    <i class="bi bi-person-check"></i>
                    <span>Mis Reservas</span>
                </a>

            <% } %>

        <% } %>
    </div>
    <% if (usuario) { %>
    <div class="sidebar-user">
        <div class="user-click" id="userToggle">
            <img src="/img/user.png" class="user-avatar" alt="Usuario">
            <span class="user-name">
                <%= usuario.nombre %> ▼
            </span>
        </div>
        <div id="userMenu" class="user-menu">
            <a href="/logout" class="logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                Cerrar sesión
            </a>
        </div>
    </div>
    <% } %>
</aside>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const userBtn = document.getElementById("userToggle");
        const menu = document.getElementById("userMenu");
        if (userBtn && menu) {
            userBtn.addEventListener("click", () => {
                menu.classList.toggle("active");
            });
        }
    });
</script>
