<aside class="sidebar" id="sidebar">
    <div>
        <div class="sidebar-header">
            <h2 class="logo">PPG</h2>
        </div>

        <% if (usuario) { %>

            <% if (usuario.roles.includes('Administrador')) { %>

                <p class="section-title">Administrador</p>

                <a href="/admin/inicio" data-tooltip="Inicio" class="menu <%= req.path === '/admin/inicio' ? 'active' : '' %>">
                    <i class="bi bi-house"></i>
                    <span>Inicio</span>
                </a>

                <a href="/admin/catalogo" data-tooltip="Catálogo" class="menu <%= req.path.startsWith('/admin/catalogo') ? 'active' : '' %>">
                    <i class="bi bi-box"></i>
                    <span>Catálogo</span>
                </a>

                <a href="/admin/campanas" data-tooltip="Campañas" class="menu <%= req.path.startsWith('/admin/campanas') ? 'active' : '' %>">
                    <i class="bi bi-megaphone"></i>
                    <span>Campañas</span>
                </a>

                <a href="/admin/reportes" data-tooltip="Reportes" class="menu <%= req.path.startsWith('/admin/reportes') ? 'active' : '' %>">
                    <i class="bi bi-bar-chart"></i>
                    <span>Reportes</span>
                </a>

                <a href="/admin/auditoria" data-tooltip="Bitácora" class="menu <%= req.path.startsWith('/admin/auditoria') ? 'active' : '' %>">
                    <i class="bi bi-journal-text"></i>
                    <span>Bitácora</span>
                </a>

                <p class="section-title">Vista concesionario</p>

                <a href="/concesionario/home" data-tooltip="Inicio" class="menu <%= req.path === '/concesionario/home' ? 'active' : '' %>">
                    <i class="bi bi-eye"></i>
                    <span>Inicio</span>
                </a>

                <a href="/concesionario/catalogo" data-tooltip="Catálogo" class="menu <%= req.path === '/concesionario/catalogo' ? 'active' : '' %>">
                    <i class="bi bi-grid"></i>
                    <span>Catálogo</span>
                </a>

            <% } %>

            <% if (usuario.roles.includes('Logistica')) { %>

                <p class="section-title">Logística</p>

                <a href="/logistica/reservas-confirmadas" data-tooltip="Reservas" class="menu <%= req.path.startsWith('/logistica/reservas') ? 'active' : '' %>">
                    <i class="bi bi-truck"></i>
                    <span>Reservas</span>
                </a>

                <a href="/logistica/metricas" data-tooltip="Métricas" class="menu <%= req.path.startsWith('/logistica/metricas') ? 'active' : '' %>">
                    <i class="bi bi-speedometer"></i>
                    <span>Métricas</span>
                </a>

                <a href="/logistica/reporte-operativo" data-tooltip="Reporte operativo" class="menu <%= req.path.startsWith('/logistica/reporte-operativo') ? 'active' : '' %>">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reporte operativo</span>
                </a>

            <% } %>

            <% if (usuario.roles.includes('Marketing')) { %>

                <p class="section-title">Marketing</p>

                <a href="/marketing/inicio" data-tooltip="Inicio" class="menu <%= req.path === '/marketing/inicio' ? 'active' : '' %>">
                    <i class="bi bi-house"></i>
                    <span>Inicio</span>
                </a>

                <a href="/marketing/ranking-productos" data-tooltip="Calificaciones" class="menu <%= req.path.startsWith('/marketing/ranking') ? 'active' : '' %>">
                    <i class="bi bi-star"></i>
                    <span>Calificaciones</span>
                </a>

                <a href="/marketing/metricas-ranking" data-tooltip="Ranking" class="menu <%= req.path.startsWith('/marketing/metricas') ? 'active' : '' %>">
                    <i class="bi bi-trophy"></i>
                    <span>Ranking</span>
                </a>

                <p class="section-title">Vista de concesionario</p>

                <a href="/marketing/catalogo" data-tooltip="Catálogo" class="menu <%= req.path.startsWith('/marketing/catalogo') ? 'active' : '' %>">
                    <i class="bi bi-grid"></i>
                    <span>Catálogo</span>
                </a>

            <% } %>

            <% if (usuario.roles.includes('Concesionario')) { %>

                <p class="section-title">Concesionario</p>

                <a href="/concesionario/home" data-tooltip="Inicio" class="menu <%= req.path === '/concesionario/home' ? 'active' : '' %>">
                    <i class="bi bi-house"></i>
                    <span>Inicio</span>
                </a>

                <a href="/concesionario/catalogo" data-tooltip="Catálogo" class="menu <%= req.path.startsWith('/concesionario/catalogo') ? 'active' : '' %>">
                    <i class="bi bi-grid"></i>
                    <span>Catálogo</span>
                </a>

                <a href="/concesionario/carrito" data-tooltip="Carrito" class="menu <%= req.path.startsWith('/concesionario/carrito') ? 'active' : '' %>">
                    <i class="bi bi-cart"></i>
                    <span>Carrito</span>
                </a>

                <a href="/concesionario/reservas" data-tooltip="Mis Reservas" class="menu <%= req.path.startsWith('/concesionario/reservas') ? 'active' : '' %>">
                    <i class="bi bi-person-check"></i>
                    <span>Mis Reservas</span>
                </a>

            <% } %>

        <% } %>
    </div>
    <% if (usuario) { %>
    <div class="sidebar-user">
        <div class="user-click" id="userToggle">
            <img src="/img/user.png" class="user-avatar" alt="Usuario">
            <span class="user-name">
                <%= usuario.nombre %> ▼
            </span>
        </div>
        <div id="userMenu" class="user-menu">
            <a href="/logout" class="logout-btn logout-sidebar-btn">
                <i class="bi bi-box-arrow-right"></i>
                Cerrar sesión
            </a>
        </div>
    </div>
    <% } %>
</aside>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const userBtn = document.getElementById("userToggle");
        const menu = document.getElementById("userMenu");
        if (userBtn && menu) {
            userBtn.addEventListener("click", () => {
                menu.classList.toggle("active");
            });
        }
    });
</script>
