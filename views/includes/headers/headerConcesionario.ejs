<header class="topbar">
    <% const cuentaActiva = usuario?.cuentaActiva || null; %>
    <% const cuentas = Array.isArray(usuario?.cuentas) ? usuario.cuentas : []; %>
    <% const cuentasActivas = cuentas.filter(cuenta => cuenta.activo); %>
    <% function getInitials(nombre) {
        if (!nombre) return 'C';
        return nombre
            .split(' ')
            .filter(Boolean)
            .slice(0, 2)
            .map(parte => parte.charAt(0).toUpperCase())
            .join('');
    } %>
    <div class="left-section">
        <button id="toggleSidebar" class="btn btn-light px-2" title="Menú">
            <i class="bi bi-list fs-5"></i>
        </button>
        <a href="/concesionario/home" class="d-flex align-items-center gap-2 text-decoration-none text-reset">
            <img src="/img/ppg-logo.png" class="logo">
            <span class="fw-bold">PPG Preventa</span>
        </a>
    </div>
    <div class="actions">
        <a href="/concesionario/carrito" id="cartHeaderIcon" class="btn btn-light position-relative px-3" title="Ver carrito">
            <i class="bi bi-cart3 fs-5"></i>
            <% if (carritoCount > 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;min-width:18px">
                    <%= carritoCount %>
                </span>
            <% } %>
        </a>

        <div class="dropdown">
            <button class="btn btn-light account-trigger" data-bs-toggle="dropdown">
                <span class="account-trigger-avatar"><%= getInitials(cuentaActiva?.nombre || usuario?.nombre) %></span>
                <span class="account-trigger-text">
                    <strong><%= usuario?.nombre %></strong>
                    <small><%= cuentaActiva ? cuentaActiva.nombre : 'Sin cuenta activa' %></small>
                </span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end account-dropdown">
                <li class="account-dropdown-header">
                    <div class="account-current-card">
                        <span class="account-avatar account-avatar-current">
                            <%= getInitials(cuentaActiva?.nombre || usuario?.nombre) %>
                        </span>
                        <div class="account-current-copy">
                            <strong><%= cuentaActiva ? cuentaActiva.nombre : 'Sin cuenta activa' %></strong>
                            <small><%= cuentaActiva ? cuentaActiva.estatus : 'Selecciona una cuenta para continuar' %></small>
                        </div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>

                <% if (cuentasActivas.length <= 1 && cuentaActiva) { %>
                    <li class="account-helper-text">
                        <span class="dropdown-item-text small text-muted">
                            Tu cuenta activa fue asignada automáticamente.
                        </span>
                    </li>
                <% } %>

                <% cuentas.forEach(cuenta => { %>
                    <% const esActiva = cuentaActiva && cuentaActiva.id_cuenta === cuenta.id_cuenta; %>
                    <li>
                        <% if (esActiva) { %>
                            <button
                                type="button"
                                class="dropdown-item account-option active-account"
                                data-bs-toggle="modal"
                                data-bs-target="#modalPerfilCuenta"
                            >
                                <span class="account-avatar account-avatar-selected">
                                    <%= getInitials(cuenta.nombre) %>
                                </span>
                                <span class="account-option-copy">
                                    <span class="account-option-title"><%= cuenta.nombre %></span>
                                    <small class="account-option-subtitle"><%= cuenta.codigo %> · <%= cuenta.estatus %></small>
                                </span>
                                <span class="account-check">
                                    <i class="bi bi-check-circle-fill"></i>
                                </span>
                            </button>
                        <% } else { %>
                            <form method="POST" action="/concesionario/cuenta-activa" class="dropdown-account-form">
                                <input type="hidden" name="id_cuenta" value="<%= cuenta.id_cuenta %>">
                                <button
                                    type="submit"
                                    class="dropdown-item account-option <%= !cuenta.activo ? 'inactive-account' : '' %>"
                                >
                                    <span class="account-avatar"><%= getInitials(cuenta.nombre) %></span>
                                    <span class="account-option-copy">
                                        <span class="account-option-title"><%= cuenta.nombre %></span>
                                        <small class="account-option-subtitle"><%= cuenta.codigo %> · <%= cuenta.estatus %></small>
                                    </span>
                                    <% if (!cuenta.activo) { %>
                                        <span class="account-inactive-pill">Inactiva</span>
                                    <% } %>
                                </button>
                            </form>
                        <% } %>
                    </li>
                <% }) %>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a href="/logout" class="dropdown-item logout-account-link">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Cerrar sesión</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<% if (cuentaActiva) { %>
<div class="modal fade" id="modalPerfilCuenta" tabindex="-1" aria-labelledby="modalPerfilCuentaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <div class="modal-header border-0 px-4 pt-4 pb-3" style="background:linear-gradient(135deg,#0f172a 0%,#163a63 60%,#14532d 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="account-avatar account-avatar-selected fs-4" style="width:52px;height:52px;font-size:1.2rem;">
                        <%= getInitials(cuentaActiva.nombre) %>
                    </div>
                    <div>
                        <h5 class="modal-title text-white fw-bold mb-0" id="modalPerfilCuentaLabel"><%= cuentaActiva.nombre %></h5>
                        <span class="badge rounded-pill mt-1" style="background:rgba(255,255,255,0.15);color:#fff;font-size:11px;">
                            <i class="bi bi-circle-fill me-1" style="font-size:7px;color:#4ade80;"></i><%= cuentaActiva.estatus %>
                        </span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body px-4 py-3">
                <p class="text-muted small mb-3 fw-semibold text-uppercase" style="letter-spacing:.06em;">Datos de la cuenta</p>
                <ul class="list-group list-group-flush border rounded-3 overflow-hidden mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-start gap-3 py-3">
                        <span class="text-muted small" style="min-width:110px;">RFC</span>
                        <strong class="text-end"><%= cuentaActiva.codigo %></strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start gap-3 py-3 bg-light">
                        <span class="text-muted small" style="min-width:110px;">Razón social</span>
                        <strong class="text-end"><%= cuentaActiva.razon_social || '—' %></strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start gap-3 py-3">
                        <span class="text-muted small" style="min-width:110px;">Dirección</span>
                        <span class="text-end text-body-secondary small"><%= cuentaActiva.direccion || '—' %></span>
                    </li>
                </ul>

                <p class="text-muted small mb-3 fw-semibold text-uppercase" style="letter-spacing:.06em;">Usuario</p>
                <ul class="list-group list-group-flush border rounded-3 overflow-hidden">
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-3 py-3">
                        <span class="text-muted small" style="min-width:110px;">Nombre</span>
                        <strong><%= usuario.nombre %></strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-3 py-3 bg-light">
                        <span class="text-muted small" style="min-width:110px;">Correo</span>
                        <span class="text-body-secondary small"><%= usuario.correo %></span>
                    </li>
                </ul>
            </div>

            <div class="modal-footer border-0 px-4 pb-4 pt-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>
<% } %>
