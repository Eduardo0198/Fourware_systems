<header class="topbar">
    <div class="logo-area">
        <img src="/img/ppg-logo.png" class="logo" alt="PPG Logo">
        <div>
            <span class="brand">
            PPG Preventa
            </span>
            <p class="brand-subtitle">
            Modulo administrativo
            </p>
        </div>
    </div>

    <div class="campaign-timer">
        <% if (activeCampaign) { %>
        <span class="timer-label">
        Campana activa:
        </span>
        <strong><%= activeCampaign.name %></strong>
        <span class="timer-value">
        Cierra en <%= campaignTimerLabel %>
        </span>
        <% } else { %>
        <span class="timer-value">
        Sin campana activa configurada
        </span>
        <% } %>
    </div>

    <div class="actions">
        <div class="account-chip">
            <strong><%= currentUser ? currentUser.role : 'Invitado' %></strong>
            <span><%= currentUser ? currentUser.email : 'Sesion no iniciada' %></span>
        </div>
        <% if (currentUser) { %>
        <form method="post" action="/logout">
            <button class="btn btn-light" type="submit">
            Cerrar sesion
            </button>
        </form>
        <% } %>
    </div>
</header>
