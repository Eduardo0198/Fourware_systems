<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= codigo %> — PPG Preventa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f0f4f8;
            font-family: 'Segoe UI', sans-serif;
            overflow: hidden;
        }

        /* Círculos decorativos de fondo */
        body::before, body::after {
            content: '';
            position: fixed;
            border-radius: 50%;
            opacity: 0.06;
            background: #1e3a5f;
            z-index: 0;
        }
        body::before { width: 600px; height: 600px; top: -200px; left: -200px; }
        body::after  { width: 400px; height: 400px; bottom: -150px; right: -100px; }

        .error-container {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 48px 32px;
            max-width: 520px;
            width: 100%;
        }

        /* Wrapper que flota */
        .error-code-wrap {
            display: inline-block;
            animation: flotar 3s ease-in-out infinite;
        }

        /* Número con efecto glitch */
        .error-code {
            display: inline-block;
            font-size: clamp(5rem, 20vw, 9rem);
            font-weight: 900;
            line-height: 1;
            color: #1e3a5f;
            letter-spacing: -4px;
            animation: glitch 5s infinite;
            position: relative;
        }

        @keyframes flotar {
            0%, 100% { transform: translateY(0px); }
            50%       { transform: translateY(-14px); }
        }

        @keyframes glitch {
            0%, 80%, 100% {
                text-shadow: none;
                transform: none;
            }
            81% {
                text-shadow: -4px 0 #e63946, 4px 0 #1e8cd8;
                transform: skewX(-3deg);
            }
            82% {
                text-shadow: 4px 0 #e63946, -4px 0 #1e8cd8;
                transform: skewX(3deg);
            }
            83% {
                text-shadow: -2px 0 #e63946, 2px 0 #1e8cd8;
                transform: skewX(0deg);
            }
            84% {
                text-shadow: none;
                transform: none;
            }
            85% {
                text-shadow: 3px 0 #e63946;
                transform: skewX(-1deg);
            }
            86% {
                text-shadow: none;
                transform: none;
            }
        }

        /* Ícono con pulso */
        .error-icon {
            font-size: 3.5rem;
            color: #e63946;
            display: block;
            margin: 16px auto 0;
            animation: pulsar 2s ease-in-out infinite;
        }

        @keyframes pulsar {
            0%, 100% { transform: scale(1);    opacity: 1;    }
            50%       { transform: scale(1.15); opacity: 0.75; }
        }

        .error-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1e3a5f;
            margin: 24px 0 8px;
        }

        .error-message {
            color: #6c757d;
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        .error-divider {
            width: 60px;
            height: 4px;
            background: linear-gradient(90deg, #1e3a5f, #e63946);
            border-radius: 2px;
            margin: 16px auto 24px;
        }

        .btn-home {
            background: #1e3a5f;
            color: #fff;
            border: none;
            padding: 12px 32px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: background 0.2s, transform 0.15s;
        }
        .btn-home:hover {
            background: #2a4f80;
            color: #fff;
            transform: translateY(-2px);
        }

        .btn-back {
            background: transparent;
            color: #1e3a5f;
            border: 2px solid #1e3a5f;
            padding: 11px 28px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        .btn-back:hover {
            background: #1e3a5f;
            color: #fff;
            transform: translateY(-2px);
        }

        .error-brand {
            margin-top: 40px;
            font-size: 0.8rem;
            color: #adb5bd;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-code-wrap">
            <span class="error-code"><%= codigo %></span>
        </div>
        <i class="bi <%= icono %> error-icon"></i>

        <div class="error-divider"></div>

        <h1 class="error-title"><%= titulo %></h1>
        <p class="error-message"><%= descripcion %></p>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="javascript:history.back()" class="btn-back">
                <i class="bi bi-arrow-left"></i> Regresar
            </a>
            <a href="<%= destino %>" class="btn-home">
                <i class="bi bi-house-fill"></i> Ir al inicio
            </a>
        </div>

        <p class="error-brand">PPG Preventa</p>
    </div>
</body>
</html>
