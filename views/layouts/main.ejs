<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PPG Preventa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <%- include('../includes/header') %>
    <div class="layout">
        <%- include('../includes/sidebar') %>
        <div class="main-wrapper">
            <% if (campania && (usuario && (usuario.roles.includes('Concesionario') || (typeof mostrarBanner !== 'undefined' && mostrarBanner)))) { %>
                <%
                    let fechaFinTexto = '';
                    if (campania.fecha_fin) {
                        try {
                            const d = new Date(campania.fecha_fin + (String(campania.fecha_fin).includes('T') ? '' : 'T12:00:00'));
                            fechaFinTexto = d.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
                        } catch(e) { fechaFinTexto = ''; }
                    }
                %>
                <div class="promo-bar"
                     style="background: linear-gradient(to right, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.45) 55%, rgba(0,0,0,0.65) 100%), url('<%= campania.banner %>') center/cover no-repeat;">
                    <div class="promo-content">
                        <div class="promo-left">
                            <span class="promo-badge">CAMPAÑA ACTIVA</span>
                            <h3 class="promo-name"><%= campania.nombre %></h3>
                            <% if (fechaFinTexto) { %>
                                <span class="promo-fecha">
                                    <i class="bi bi-calendar3 me-1"></i>Termina el <%= fechaFinTexto %>
                                </span>
                            <% } %>
                        </div>
                        <div class="promo-timer-wrap">
                            <span class="promo-timer-label">Tiempo restante</span>
                            <div class="promo-timer-box">
                                <div class="time-unit">
                                    <span class="time-value" id="d">00</span>
                                    <span class="time-label">DÍAS</span>
                                </div>
                                <span class="time-sep">:</span>
                                <div class="time-unit">
                                    <span class="time-value" id="h">00</span>
                                    <span class="time-label">HRS</span>
                                </div>
                                <span class="time-sep">:</span>
                                <div class="time-unit">
                                    <span class="time-value" id="m">00</span>
                                    <span class="time-label">MIN</span>
                                </div>
                                <span class="time-sep">:</span>
                                <div class="time-unit">
                                    <span class="time-value" id="s">00</span>
                                    <span class="time-label">SEG</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
            <main class="content">
                <%- body %>
            </main>
            <%- include('../includes/footer') %>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const hint = document.createElement('div');
        hint.id = 'campo-ayuda';
        hint.style.cssText = 'display:none;position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#1e3a5f;color:#fff;padding:8px 18px;border-radius:8px;font-size:13px;box-shadow:0 4px 16px rgba(0,0,0,0.25);z-index:9999;max-width:420px;text-align:center;pointer-events:none;';
        document.body.appendChild(hint);

        document.addEventListener('focusin', (e) => {
            const texto = e.target.dataset?.hint;
            if (texto) {
                hint.textContent = texto;
                hint.style.display = 'block';
            }
        });

        document.addEventListener('focusout', () => {
            hint.style.display = 'none';
        });
    });
    </script>
    <% if (campania) { %>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const endDate = new Date("<%= campania.fecha_fin %>").getTime();
            function pad(n) { return String(n).padStart(2, "0"); }
            function updateTimer() {
                const dEl = document.getElementById("d");
                if (!dEl) return;
                const distance = endDate - Date.now();
                if (distance <= 0) {
                    ["d","h","m","s"].forEach(id => { document.getElementById(id).textContent = "00"; });
                    return;
                }
                document.getElementById("d").textContent = pad(Math.floor(distance / 86400000));
                document.getElementById("h").textContent = pad(Math.floor((distance / 3600000) % 24));
                document.getElementById("m").textContent = pad(Math.floor((distance / 60000) % 60));
                document.getElementById("s").textContent = pad(Math.floor((distance / 1000) % 60));
            }
            updateTimer();
            setInterval(updateTimer, 1000);
        });
    </script>
    <% } %>
   <script>
        document.addEventListener("DOMContentLoaded", () => {
            const btn = document.getElementById("toggleSidebar");
            const sidebar = document.getElementById("sidebar");
            if (btn && sidebar) {
                btn.addEventListener("click", () => {
                    if (window.innerWidth <= 768) {
                        sidebar.classList.toggle("active");
                    } else {
                        document.body.classList.toggle("sidebar-hidden");
                    }
                });
            }
        });
    </script>
</body>
</html>