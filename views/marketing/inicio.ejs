<section class="d-flex flex-column gap-4">

    <%# Hero %>
    <div class="dealer-home-hero card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge text-bg-light text-uppercase fw-semibold mb-3">Panel Marketing</span>
                    <h2 class="display-6 fw-bold mb-2">Hola, <%= saludo %>.</h2>
                    <p class="lead mb-4">
                        Consulta el rendimiento de los productos, revisa calificaciones y analiza métricas por campaña.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/marketing/metricas-ranking" class="btn btn-light px-4">
                            <i class="bi bi-trophy me-2"></i>Ranking
                        </a>
                        <a href="/marketing/ranking-productos" class="btn btn-outline-light px-4">
                            <i class="bi bi-star me-2"></i>Calificaciones
                        </a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="dealer-home-hero-panel">
                        <div class="dealer-home-hero-item">
                            <span>Campaña vigente</span>
                            <strong><%= campania ? campania.nombre : 'Sin campaña activa' %></strong>
                        </div>
                        <div class="dealer-home-hero-item">
                            <span>Reservas confirmadas</span>
                            <strong><%= resumen.confirmadas %></strong>
                        </div>
                        <div class="dealer-home-hero-item">
                            <span>Reservas canceladas</span>
                            <strong><%= resumen.canceladas %></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%# KPIs %>
    <div class="row g-3">
        <div class="col-sm-6 col-xl-4">
            <article class="card border-0 shadow-sm h-100 dealer-home-stat">
                <div class="card-body">
                    <span class="dealer-home-stat-label">Reservas totales</span>
                    <strong class="dealer-home-stat-value"><%= resumen.total %></strong>
                    <p class="text-muted mb-0">Historial completo del sistema.</p>
                </div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-4">
            <article class="card border-0 shadow-sm h-100 dealer-home-stat">
                <div class="card-body">
                    <span class="dealer-home-stat-label">Confirmadas</span>
                    <strong class="dealer-home-stat-value text-success"><%= resumen.confirmadas %></strong>
                    <p class="text-muted mb-0">Preventas vigentes registradas.</p>
                </div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-4">
            <article class="card border-0 shadow-sm h-100 dealer-home-stat">
                <div class="card-body">
                    <span class="dealer-home-stat-label">Canceladas</span>
                    <strong class="dealer-home-stat-value text-secondary"><%= resumen.canceladas %></strong>
                    <p class="text-muted mb-0">Operaciones anuladas o vencidas.</p>
                </div>
            </article>
        </div>
    </div>

    <%# Top productos + Acciones %>
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="h5 mb-1">Top 3 productos</h3>
                            <p class="text-muted mb-0 small">Productos con más unidades reservadas.</p>
                        </div>
                        <a href="/marketing/metricas-ranking" class="btn btn-outline-secondary btn-sm">
                            Ver ranking completo
                        </a>
                    </div>
                    <% if (topProductos.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Producto</th>
                                    <th class="text-end">Reservas</th>
                                    <th class="text-end">Calificación</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topProductos.forEach((p, i) => { %>
                                <tr>
                                    <td>
                                        <% if (i === 0) { %>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill"></i> 1</span>
                                        <% } else if (i === 1) { %>
                                            <span class="badge bg-secondary">2</span>
                                        <% } else { %>
                                            <span class="badge" style="background:#cd7f32;color:#fff;">3</span>
                                        <% } %>
                                    </td>
                                    <td class="fw-semibold"><%= p.nombre_comercial %></td>
                                    <td class="text-end"><%= p.total %></td>
                                    <td class="text-end">
                                        <% if (Number(p.promedio_estrellas) > 0) { %>
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <%= Number(p.promedio_estrellas).toFixed(1) %>
                                        <% } else { %>
                                            <span class="text-muted small">Sin reseñas</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="dealer-home-empty dealer-home-empty-soft">
                        <i class="bi bi-box-seam"></i>
                        <h4 class="h6">Sin datos de productos</h4>
                        <p class="text-muted mb-0">Aún no hay reservas registradas en el sistema.</p>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h3 class="h5 mb-3">Acciones rápidas</h3>
                    <div class="d-grid gap-3">
                        <a href="/marketing/metricas-ranking" class="dealer-home-action text-decoration-none">
                            <div>
                                <strong>Ranking</strong>
                                <p class="mb-0">Consulta el ranking de productos por campaña.</p>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="/marketing/ranking-productos" class="dealer-home-action text-decoration-none">
                            <div>
                                <strong>Calificaciones</strong>
                                <p class="mb-0">Revisa opiniones y comentarios de concesionarios.</p>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
