<div class="container-fluid mt-4">
    <h2><i class="bi bi-trophy me-2"></i>Ranking de Productos y Métricas Comparativas</h2>
    <hr>

    <% if (pageMessage) { %>
    <div class="alert alert-<%= pageMessage.tipo %> alert-dismissible fade show" role="alert">
        <i class="bi bi-<%= pageMessage.tipo === 'danger' ? 'exclamation-triangle' : pageMessage.tipo === 'warning' ? 'exclamation-circle' : 'info-circle' %> me-2"></i>
        <%= pageMessage.texto %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (!sinCampanias) { %>
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">
            <i class="bi bi-funnel me-2"></i>Filtros
        </div>
        <div class="card-body">
            <form method="POST" action="/marketing/consultar-metricas" id="formFiltros">
                <input type="hidden" id="tabActivoInput" name="tabActivo" value="<%= filtros.tabActivo || 'ranking' %>">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="idCampania" class="form-label">Campaña</label>
                        <select name="idCampania" id="idCampania" class="form-select">
                            <option value="">Todas las campañas</option>
                            <% campanias.forEach(c => { %>
                            <%
                                const seleccionada = filtros.idCampania
                                    ? String(filtros.idCampania) === String(c.id_campania)
                                    : String(campaniaActivaId) === String(c.id_campania);
                            %>
                            <option value="<%= c.id_campania %>" <%= seleccionada ? 'selected' : '' %>>
                                <%= c.nombre %>
                            </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="fechaInicio" class="form-label">Fecha inicio</label>
                        <input type="date" name="fechaInicio" id="fechaInicio" class="form-control"
                               value="<%= filtros.fechaInicio || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label for="fechaFin" class="form-label">Fecha fin</label>
                        <input type="date" name="fechaFin" id="fechaFin" class="form-control"
                               value="<%= filtros.fechaFin || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label for="producto" class="form-label">Producto (SKU o nombre)</label>
                        <input type="text" name="producto" id="producto" class="form-control"
                               placeholder="Buscar producto..." value="<%= filtros.producto || '' %>">
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>Consultar
                    </button>
                    <a href="/marketing/metricas-ranking" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Limpiar filtros
                    </a>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <% if (resultados) { %>

    <% const hayRanking  = resultados.ranking.length > 0; %>
    <% const hayMetricas = resultados.metricas.length > 0; %>
    <% const hayGeo      = resultados.geografico && resultados.geografico.estados.length > 0; %>
    <% const mostrarTabGeo = hayRanking || hayMetricas; %>

    <% if (hayRanking || hayMetricas || hayGeo) { %>
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">
            <i class="bi bi-bar-chart me-2"></i>Gráficas
        </div>
        <div class="card-body">
            <ul class="nav nav-tabs mb-3" id="chartTabs" role="tablist">
                <% if (hayRanking) { %>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-ranking" data-bs-toggle="tab"
                            data-bs-target="#pane-ranking" type="button" role="tab" data-tab="ranking">
                        <i class="bi bi-list-ol me-1"></i>Ranking de productos
                    </button>
                </li>
                <% } %>
                <% if (hayMetricas) { %>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-metricas" data-bs-toggle="tab"
                            data-bs-target="#pane-metricas" type="button" role="tab" data-tab="metricas">
                        <i class="bi bi-bar-chart-line me-1"></i>Métricas comparativas
                    </button>
                </li>
                <% } %>
                <% if (mostrarTabGeo) { %>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-geo" data-bs-toggle="tab"
                            data-bs-target="#pane-geo" type="button" role="tab" data-tab="geo">
                        <i class="bi bi-map me-1"></i>Segmentación geográfica
                    </button>
                </li>
                <% } %>
            </ul>
            <div class="tab-content">
                <% if (hayRanking) { %>
                <div class="tab-pane fade" id="pane-ranking" role="tabpanel">
                    <canvas id="chartRanking"></canvas>
                </div>
                <% } %>
                <% if (hayMetricas) { %>
                <div class="tab-pane fade" id="pane-metricas" role="tabpanel">
                    <canvas id="chartMetricas"></canvas>
                </div>
                <% } %>
                <% if (mostrarTabGeo) { %>
                <div class="tab-pane fade" id="pane-geo" role="tabpanel">
                    <% if (!hayGeo) { %>
                    <p class="text-muted text-center py-4">
                        <i class="bi bi-geo-alt me-1"></i>Sin datos geográficos para los filtros aplicados.
                        Las reservas deben tener sucursal asignada para mostrar esta segmentación.
                    </p>
                    <% } else { %>
                    <canvas id="chartGeo" class="mb-4"></canvas>
                    <h6 class="fw-semibold mb-2">Tabla de calor: unidades por región y producto</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle mb-0" id="tablaGeo">
                            <thead class="table-dark">
                                <tr>
                                    <th>Región</th>
                                    <% resultados.geografico.productos.forEach(p => { %>
                                    <th class="text-center" title="<%= p.nombre %>">
                                        <span style="font-size:.75rem;"><%= p.nombre.length > 18 ? p.nombre.slice(0,18)+'…' : p.nombre %></span>
                                    </th>
                                    <% }) %>
                                    <th class="text-center">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% resultados.geografico.estados.forEach(estado => { %>
                                <tr>
                                    <td class="fw-semibold"><%= estado %></td>
                                    <% resultados.geografico.productos.forEach(p => { %>
                                    <%
                                        const val = (resultados.geografico.matrix[estado] || {})[p.sku] || 0;
                                        const intensidad = Math.round((val / resultados.geografico.maxVal) * 100);
                                        const bg = val === 0 ? '' : `background:rgba(13,110,253,${(intensidad/100)*0.7 + 0.05});color:${intensidad > 55 ? '#fff' : '#212529'}`;
                                    %>
                                    <td class="text-center" style="<%= bg %>"><%= val || '' %></td>
                                    <% }) %>
                                    <td class="text-center fw-bold"><%= resultados.geografico.totalesPorEstado[estado] || 0 %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    <% } %>

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
            <span><i class="bi bi-list-ol me-2"></i>Ranking de Productos</span>
            <% if (resultados.ranking.length > 0) { %>
            <button id="btnExportar" class="btn btn-sm btn-success">
                <i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel
            </button>
            <% } %>
        </div>
        <div class="card-body p-0">
            <% if (resultados.ranking.length === 0) { %>
            <p class="text-muted text-center py-4">Sin resultados para los filtros aplicados.</p>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>SKU</th>
                            <th>Producto</th>
                            <th class="text-end">Unidades vendidas</th>
                            <th>Campaña</th>
                            <th class="text-end">Órdenes campaña</th>
                            <th class="text-end">Monto campaña</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% resultados.ranking.forEach(r => { %>
                        <tr>
                            <td>
                                <% if (r.posicion == 1) { %>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill"></i> 1</span>
                                <% } else if (r.posicion == 2) { %>
                                    <span class="badge bg-secondary">2</span>
                                <% } else if (r.posicion == 3) { %>
                                    <span class="badge" style="background:#cd7f32;color:#fff;">3</span>
                                <% } else { %>
                                    <%= r.posicion %>
                                <% } %>
                            </td>
                            <td><code><%= r.SKU %></code></td>
                            <td><%= r.nombre_comercial %></td>
                            <td class="text-end fw-bold"><%= r.total_unidades %></td>
                            <td><%= r.nombre_campania %></td>
                            <td class="text-end"><%= r.total_ordenes_campania %></td>
                            <td class="text-end">$<%= Number(r.monto_total_campania).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">
            <i class="bi bi-bar-chart-line me-2"></i>Métricas Comparativas por Campaña
        </div>
        <div class="card-body p-0">
            <% if (resultados.metricas.length === 0) { %>
            <p class="text-muted text-center py-4">Sin métricas para los filtros aplicados.</p>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Campaña</th>
                            <th class="text-end">Total órdenes</th>
                            <th class="text-end">Monto total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% resultados.metricas.forEach(m => { %>
                        <tr>
                            <td><%= m.nombre_campania %></td>
                            <td class="text-end"><%= m.total_ordenes %></td>
                            <td class="text-end">$<%= Number(m.monto_total).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Total</td>
                            <td class="text-end"><%= resultados.metricas.reduce((s, m) => s + Number(m.total_ordenes), 0) %></td>
                            <td class="text-end">$<%= resultados.metricas.reduce((s, m) => s + Number(m.monto_total), 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <% } %>
        </div>
    </div>

    <% } %>
</div>

<% if (resultados && (resultados.ranking.length > 0 || resultados.metricas.length > 0)) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
const TAB_ACTIVO = '<%= filtros.tabActivo || (resultados.ranking.length > 0 ? "ranking" : resultados.metricas.length > 0 ? "metricas" : "geo") %>';
const chartInstancias = {};

function activarTab(tabId) {
    const btn = document.querySelector(`[data-tab="${tabId}"]`);
    if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
}

document.querySelectorAll('[data-tab]').forEach(btn => {
    btn.addEventListener('shown.bs.tab', () => {
        const tab = btn.dataset.tab;
        document.getElementById('tabActivoInput').value = tab;
        if (!chartInstancias[tab]) iniciarChart(tab);
    });
});

function iniciarChart(tab) {
    chartInstancias[tab] = true;

    <% if (resultados.ranking.length > 0) { %>
    if (tab === 'ranking') {
        const labels = <%- JSON.stringify(resultados.ranking.slice(0, 10).map(r => r.nombre_comercial)) %>;
        const data   = <%- JSON.stringify(resultados.ranking.slice(0, 10).map(r => Number(r.total_unidades))) %>;
        const colores = data.map((_, i) => {
            if (i === 0) return 'rgba(255,193,7,0.85)';
            if (i === 1) return 'rgba(173,181,189,0.85)';
            if (i === 2) return 'rgba(205,127,50,0.85)';
            return 'rgba(13,110,253,0.72)';
        });
        new Chart(document.getElementById('chartRanking'), {
            type: 'bar',
            data: { labels, datasets: [{ label: 'Unidades vendidas', data, backgroundColor: colores, borderRadius: 4 }] },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    legend: { display: false },
                    title: { display: true, text: 'Top 10 productos por unidades vendidas', font: { size: 14 } },
                    tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.x.toLocaleString('es-MX')} unidades` } }
                },
                scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    }
    <% } %>

    <% if (resultados.metricas.length > 0) { %>
    if (tab === 'metricas') {
        new Chart(document.getElementById('chartMetricas'), {
            type: 'bar',
            data: {
                labels: <%- JSON.stringify(resultados.metricas.map(m => m.nombre_campania)) %>,
                datasets: [
                    {
                        label: 'Total órdenes',
                        data: <%- JSON.stringify(resultados.metricas.map(m => Number(m.total_ordenes))) %>,
                        backgroundColor: 'rgba(25,135,84,0.75)', borderRadius: 4, yAxisID: 'yOrdenes'
                    },
                    {
                        label: 'Monto total ($)',
                        data: <%- JSON.stringify(resultados.metricas.map(m => Number(m.monto_total))) %>,
                        backgroundColor: 'rgba(255,193,7,0.75)', borderRadius: 4, yAxisID: 'yMonto'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: { title: { display: true, text: 'Comparativa de campañas: órdenes vs monto', font: { size: 14 } } },
                scales: {
                    yOrdenes: { type: 'linear', position: 'left', beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Órdenes' } },
                    yMonto:   { type: 'linear', position: 'right', beginAtZero: true, grid: { drawOnChartArea: false }, title: { display: true, text: 'Monto ($)' } }
                }
            }
        });
    }
    <% } %>

    <% if (resultados.geografico && resultados.geografico.estados.length > 0) { %>
    if (tab === 'geo') {
        const geoEstados  = <%- JSON.stringify(resultados.geografico.estados) %>;
        const geoTotales  = <%- JSON.stringify(resultados.geografico.estados.map(e => resultados.geografico.totalesPorEstado[e] || 0)) %>;
        new Chart(document.getElementById('chartGeo'), {
            type: 'bar',
            data: { labels: geoEstados, datasets: [{ label: 'Unidades totales', data: geoTotales, backgroundColor: 'rgba(13,110,253,0.72)', borderRadius: 4 }] },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    legend: { display: false },
                    title: { display: true, text: 'Unidades vendidas por región', font: { size: 14 } },
                    tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.x.toLocaleString('es-MX')} unidades` } }
                },
                scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    }
    <% } %>
}

// Restaurar tab activo al cargar
document.addEventListener('DOMContentLoaded', () => activarTab(TAB_ACTIVO));

// ── EXPORTAR EXCEL ────────────────────────────────────────────────────────────
const btnExportar = document.getElementById('btnExportar');
if (btnExportar) {
    btnExportar.addEventListener('click', async () => {
        btnExportar.disabled = true;
        btnExportar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generando...';

        const [imgRanking, imgMetricas] = await Promise.all([
            capturarGraficaExport('ranking'),
            capturarGraficaExport('metricas')
        ]);

        try {
            const res = await fetch('/marketing/exportar-metricas', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    idCampania:  '<%= filtros.idCampania  || "" %>',
                    fechaInicio: '<%= filtros.fechaInicio || "" %>',
                    fechaFin:    '<%= filtros.fechaFin    || "" %>',
                    producto:    '<%= filtros.producto    || "" %>',
                    chartRankingImg:  imgRanking  || '',
                    chartMetricasImg: imgMetricas || ''
                })
            });
            if (!res.ok) throw new Error();
            const blob = await res.blob();
            const cd   = res.headers.get('Content-Disposition') || '';
            const name = (cd.match(/filename="([^"]+)"/) || [])[1] || 'ranking_PPG.xlsx';
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href = url; a.download = name; a.click();
            URL.revokeObjectURL(url);
        } catch {
            alert('Error al exportar. Intente nuevamente.');
        } finally {
            btnExportar.disabled = false;
            btnExportar.innerHTML = '<i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel';
        }
    });
}

async function capturarGraficaExport(tab) {
    return new Promise(resolve => {
        const canvas = document.createElement('canvas');
        canvas.width = 800; canvas.height = 380;

        let cfg = null;
        <% if (resultados.ranking.length > 0) { %>
        if (tab === 'ranking') {
            const labels = <%- JSON.stringify(resultados.ranking.slice(0,10).map(r => r.nombre_comercial)) %>;
            const data   = <%- JSON.stringify(resultados.ranking.slice(0,10).map(r => Number(r.total_unidades))) %>;
            cfg = {
                type: 'bar',
                data: { labels, datasets: [{ label: 'Unidades vendidas', data,
                    backgroundColor: data.map((_,i) => i===0?'rgba(255,193,7,0.85)':i===1?'rgba(173,181,189,0.85)':i===2?'rgba(205,127,50,0.85)':'rgba(13,110,253,0.72)'),
                    borderRadius: 4 }] },
                options: { indexAxis: 'y', responsive: false, animation: false,
                    plugins: { legend: { display: false }, title: { display: true, text: 'Top 10 productos por unidades vendidas', font: { size: 14 } } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 } } } }
            };
        }
        <% } %>
        <% if (resultados.metricas.length > 0) { %>
        if (tab === 'metricas') {
            cfg = {
                type: 'bar',
                data: {
                    labels: <%- JSON.stringify(resultados.metricas.map(m => m.nombre_campania)) %>,
                    datasets: [
                        { label: 'Total órdenes', data: <%- JSON.stringify(resultados.metricas.map(m => Number(m.total_ordenes))) %>, backgroundColor: 'rgba(25,135,84,0.75)', borderRadius: 4, yAxisID: 'yOrdenes' },
                        { label: 'Monto total ($)', data: <%- JSON.stringify(resultados.metricas.map(m => Number(m.monto_total))) %>, backgroundColor: 'rgba(255,193,7,0.75)', borderRadius: 4, yAxisID: 'yMonto' }
                    ]
                },
                options: { responsive: false, animation: false,
                    plugins: { title: { display: true, text: 'Comparativa de campañas: órdenes vs monto', font: { size: 14 } } },
                    scales: {
                        yOrdenes: { type: 'linear', position: 'left',  beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Órdenes' } },
                        yMonto:   { type: 'linear', position: 'right', beginAtZero: true, grid: { drawOnChartArea: false }, title: { display: true, text: 'Monto ($)' } }
                    } }
            };
        }
        <% } %>

        if (!cfg) return resolve(null);
        const chart = new Chart(canvas, cfg);
        setTimeout(() => { resolve(canvas.toDataURL('image/png')); chart.destroy(); }, 150);
    });
}
</script>
<% } %>
