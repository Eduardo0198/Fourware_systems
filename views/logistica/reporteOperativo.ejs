<%
    function formatInteger(value) {
        return Number(value || 0).toLocaleString('es-MX', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        });
    }
%>

<section class="admin-shell">
    <div class="admin-hero admin-hero-campaigns">
        <div>
            <span class="admin-eyebrow">Logística</span>
            <h2 class="admin-title">Reporte Operativo</h2>
            <p class="admin-subtitle">
                Consulta el detalle de reservas por campaña, cuenta y periodo. Exporta el reporte en CSV.
            </p>
        </div>
        <div class="admin-hero-note">
            <span>Total registros</span>
            <strong><%= formatInteger(resumen.totalLineas) %></strong>
            <small><%= formatInteger(resumen.totalReservas) %> reserva(s) únicas.</small>
        </div>
    </div>

    <div class="admin-table-card">
        <div class="admin-table-head">
            <div>
                <h4>Filtros de consulta</h4>
                <p>Filtra por fecha, campaña y cuenta para generar el reporte.</p>
            </div>
        </div>

        <form method="GET" action="/logistica/reporte-operativo" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Fecha inicio</label>
                <input type="date" name="fecha_inicio" class="form-control" value="<%= filtros.fecha_inicio %>">
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha fin</label>
                <input type="date" name="fecha_fin" class="form-control" value="<%= filtros.fecha_fin %>">
            </div>
            <div class="col-md-3">
                <label class="form-label">Campaña</label>
                <select name="id_campania" class="form-select">
                    <option value="">Todas las campañas</option>
                    <% campanias.forEach((campania) => { %>
                        <option value="<%= campania.id_campania %>" <%= filtros.id_campania == campania.id_campania ? 'selected' : '' %>>
                            <%= campania.nombre %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Cuenta</label>
                <select name="id_cuenta" class="form-select">
                    <option value="">Todas las cuentas</option>
                    <% cuentas.forEach((cuenta) => { %>
                        <option value="<%= cuenta.id_cuenta %>" <%= filtros.id_cuenta == cuenta.id_cuenta ? 'selected' : '' %>>
                            <%= cuenta.nombre %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn admin-action-btn" type="submit">Generar reporte</button>
                <button type="button" id="btnLimpiarReporte" class="btn btn-outline-secondary">Limpiar</button>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('btnLimpiarReporte')?.addEventListener('click', () => {
            location.href = '/logistica/reporte-operativo';
        });
    </script>

    <div class="admin-stats-grid">
        <article class="admin-stat-card">
            <span class="admin-stat-label">Total registros</span>
            <strong><%= formatInteger(resumen.totalLineas) %></strong>
            <p><%= formatInteger(resumen.totalReservas) %> reserva(s) única(s) con los filtros aplicados.</p>
        </article>
    </div>

    <div class="admin-table-card">
        <div class="admin-table-head">
            <div>
                <h4>Detalle operativo</h4>
                <p>ID de reserva, cuenta, usuario, campaña, producto, cantidad, dirección y fecha.</p>
            </div>
            <form method="POST" action="/logistica/reporte-operativo/exportar" class="d-flex gap-2">
                <input type="hidden" name="fecha_inicio" value="<%= filtros.fecha_inicio %>">
                <input type="hidden" name="fecha_fin" value="<%= filtros.fecha_fin %>">
                <input type="hidden" name="id_campania" value="<%= filtros.id_campania %>">
                <input type="hidden" name="id_cuenta" value="<%= filtros.id_cuenta %>">
                <button class="btn admin-action-btn" type="submit" name="formato" value="csv">Exportar CSV</button>
                <button class="btn btn-outline-secondary" type="submit" name="formato" value="xlsx">Exportar Excel</button>
            </form>
        </div>
        <div class="admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID Reserva</th>
                        <th>Cuenta</th>
                        <th>Usuario</th>
                        <th>Campaña</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Dirección</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (detalle && detalle.length > 0) { %>
                        <% detalle.forEach((item) => { %>
                            <tr>
                                <td><strong><%= item.folio %></strong></td>
                                <td><%= item.cuenta %></td>
                                <td><%= item.distribuidor %></td>
                                <td><%= item.campania %></td>
                                <td><%= item.producto %></td>
                                <td><%= formatInteger(item.cantidad) %></td>
                                <td><%= item.direccion_entrega %></td>
                                <td><%= item.fecha %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center">
                                No hay resultados. Aplica filtros y genera el reporte.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</section>
