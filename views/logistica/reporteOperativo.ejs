<h2>Reporte Operativo</h2>
<hr>
<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-header">
            Filtros
        </div>
        <div class="card-body">
            <!-- lau y eduardo inicio formulario cu-18 -->
            <!-- aqui empieza el formulario que manda los filtros al controlador -->
            <form method="GET" action="/logistica/reporte-operativo">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">
                            Fecha inicio
                        </label>
                        <!-- aqui guardo la fecha inicial seleccionada -->
                        <input type="date" name="fecha_inicio" class="form-control" value="<%= filtros.fecha_inicio %>">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">
                            Fecha fin
                        </label>
                        <!-- aqui guardo la fecha final seleccionada -->
                        <input type="date" name="fecha_fin" class="form-control" value="<%= filtros.fecha_fin %>">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">
                            Campaña
                        </label>
                        <!-- aqui muestro las campañas que vienen del controlador -->
                        <select name="id_campania" class="form-select">
                            <option value="">
                                Seleccionar campaña
                            </option>
                            <% campanias.forEach((campania) => { %>
                                <option value="<%= campania.id_campania %>" <% if (filtros.id_campania == campania.id_campania) { %>selected<% } %>>
                                 <%= campania.nombre %>
                                    </option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="mt-3">
                    <!-- aqui se manda el formulario para consultar el reporte -->
                    <button class="btn btn-primary">
                        Generar reporte
                    </button>
                </div>
            </form>
            <!-- lau y eduardo final formulario cu-18 -->
        </div>
    </div>
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card text-center">
                            <div class="card-body">
                                <!-- lau  y eduardo inicio resumen cu-18 -->
                                <h6>
                                    Total Reservas
                                </h6>
                                <h2>
                                <!-- aqui muestro el total de reservas que mando el controlador -->
                                <%= resumen.totalReservas %>
                                </h2>
                                <!-- lau y eduardo final resumen cu-18 -->
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header">
                        Detalle Operativo
                    </div>
                    <div class="card-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID Reserva</th>
                                    <th>Cuenta</th>
                                    <th>Usuario</th>
                                    <th>Campaña</th>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Dirección</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>
                            <tbody>
                                    <!-- lau inicio tabla cu-18 -->
                                    <% if (detalle && detalle.length > 0) { %>
                                        <!-- aqui recorro cada fila que llega del controlador -->
                                        <% detalle.forEach((item) => { %>
                                            <tr>
                                                <td><%= item.folio %></td>
                                                <td><%= item.cuenta %></td>
                                                <td><%= item.distribuidor %></td>
                                                <td><%= item.campania %></td>
                                                <td><%= item.producto %></td>
                                                <td><%= item.cantidad %></td>
                                                <td><%= item.direccion_entrega %></td>
                                                <td><%= item.fecha %></td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <!-- aqui se muestra este mensaje si no hay resultados -->
                                        <tr>
                                            <td colspan="8" class="text-center">
                                                Aquí se mostrarán los resultados del reporte.
                                            </td>
                                        </tr>
                                    <% } %>
                                    <!-- lau final tabla cu-18 -->
                            </tbody>
                        </table>
                    </div>
                </div>
</div>
