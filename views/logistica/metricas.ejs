<%
    function formatDecimal(value) {
        return Number(value || 0).toLocaleString('es-MX', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function formatInteger(value) {
        return Number(value || 0).toLocaleString('es-MX', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        });
    }

    const safeFiltros = (typeof filtros !== 'undefined' && filtros) ? filtros : {};
    const safeMetricas = (typeof metricas !== 'undefined' && Array.isArray(metricas)) ? metricas : [];
    const safeSerieTiempo = (typeof serieTiempo !== 'undefined' && Array.isArray(serieTiempo)) ? serieTiempo : [];
    // aqui valido que rendimientoProductos exista y que de verdad sea un arreglo
    // si todavia no llega informacion desde el controller, uso un arreglo vacio para que la vista no falle
    const safeRendimientoProductos = (typeof rendimientoProductos !== 'undefined' && Array.isArray(rendimientoProductos))
        ? rendimientoProductos
        : [];

    const safeCampanias = (typeof campanias !== 'undefined' && Array.isArray(campanias)) ? campanias : [];
    const safeCuentas = (typeof cuentas !== 'undefined' && Array.isArray(cuentas)) ? cuentas : [];
    const safeResumen = (typeof resumen !== 'undefined' && resumen) ? resumen : {};
    const safePageMessage = (typeof pageMessage !== 'undefined' && pageMessage) ? pageMessage : null;
    const filtroAgruparPor = safeFiltros.agrupar_por === 'cuenta' ? 'cuenta' : 'campania';
    const filtroFechaInicio = safeFiltros.fecha_inicio || '';
    const filtroFechaFin = safeFiltros.fecha_fin || '';
    const filtroIdCampania = safeFiltros.id_campania || '';
    const filtroIdCuenta = safeFiltros.id_cuenta || '';
    const maxPesoComparativo = Math.max(1, ...safeMetricas.map(item => Number(item.peso_total || 0)));
    const maxVolumenComparativo = Math.max(1, ...safeMetricas.map(item => Number(item.volumen_total || 0)));
    const serieParaVista = safeSerieTiempo.slice(-15);
    const maxPesoSerie = Math.max(1, ...serieParaVista.map(item => Number(item.peso_total || 0)));
    const maxVolumenSerie = Math.max(1, ...serieParaVista.map(item => Number(item.volumen_total || 0)));
    const totalPesoGlobal = safeMetricas.reduce((acc, item) => acc + Number(item.peso_total || 0), 0);
    const totalVolumenGlobal = safeMetricas.reduce((acc, item) => acc + Number(item.volumen_total || 0), 0);
    const top5Peso = [...safeMetricas]
        .sort((a, b) => Number(b.peso_total || 0) - Number(a.peso_total || 0))
        .slice(0, 5);
    const top5Volumen = [...safeMetricas]
        .sort((a, b) => Number(b.volumen_total || 0) - Number(a.volumen_total || 0))
        .slice(0, 5);

    // aqui saco el producto con mayor numero de preventas confirmadas
    // hago una copia con [...] para no alterar el arreglo original al ordenar
    const topProductoConfirmaciones = safeRendimientoProductos.length > 0
        ? [...safeRendimientoProductos].sort((a, b) => Number(b.preventas_confirmadas || 0) - Number(a.preventas_confirmadas || 0))[0]
        : null;

    // aqui saco el producto con mayor peso total acumulado
    const topProductoPeso = safeRendimientoProductos.length > 0
        ? [...safeRendimientoProductos].sort((a, b) => Number(b.peso_total || 0) - Number(a.peso_total || 0))[0]
        : null;

    // aqui saco el producto con mayor volumen total acumulado
    const topProductoVolumen = safeRendimientoProductos.length > 0
        ? [...safeRendimientoProductos].sort((a, b) => Number(b.volumen_total || 0) - Number(a.volumen_total || 0))[0]
        : null;

    // aqui tomo solo los primeros 5 productos del ranking general
    // esto sirve para mostrar una tabla rapida sin saturar la pantalla
    const top5Productos = [...safeRendimientoProductos].slice(0, 5);

    // aqui intento encontrar la campania seleccionada dentro del catalogo
    // esto sirve para mostrar su nombre arriba en la vista si el usuario eligio una
    const campaniaSeleccionada = safeCampanias.find((campania) =>
        String(campania.id_campania) === String(filtroIdCampania)
    ) || null;

    // aqui construyo un texto sencillo para mostrar el contexto actual
    // si hay campania seleccionada, muestro su nombre
    // si no, dejo una leyenda general
    const etiquetaContextoCampania = campaniaSeleccionada
        ? `Campaña: ${campaniaSeleccionada.nombre}`
        : 'Vista general de campañas';

    // aqui preparo los primeros 10 productos para la grafica de confirmaciones
    // los ordeno de mayor a menor segun cuantas preventas confirmadas tienen
    const top10ProductosGrafica = [...safeRendimientoProductos]
        .sort((a, b) => Number(b.preventas_confirmadas || 0) - Number(a.preventas_confirmadas || 0))
        .slice(0, 10);

    // aqui saco solo los nombres de producto para usarlos como etiquetas en la grafica
    const labelsGraficaConfirmaciones = top10ProductosGrafica.map((item) => item.producto);

    // aqui saco solo los valores numericos de confirmaciones
    const dataGraficaConfirmaciones = top10ProductosGrafica.map((item) => Number(item.preventas_confirmadas || 0));

    // aqui preparo los primeros 10 productos ordenados por peso total
    const top10ProductosPeso = [...safeRendimientoProductos]
        .sort((a, b) => Number(b.peso_total || 0) - Number(a.peso_total || 0))
        .slice(0, 10);

    // aqui saco los nombres de producto para la grafica de peso
    const labelsGraficaPeso = top10ProductosPeso.map((item) => item.producto);

    // aqui saco los valores numericos del peso total por producto
    const dataGraficaPeso = top10ProductosPeso.map((item) => Number(item.peso_total || 0));

    // aqui preparo los primeros 10 productos ordenados por volumen total
    const top10ProductosVolumen = [...safeRendimientoProductos]
        .sort((a, b) => Number(b.volumen_total || 0) - Number(a.volumen_total || 0))
        .slice(0, 10);

    // aqui saco los nombres de producto para la grafica de volumen
    const labelsGraficaVolumen = top10ProductosVolumen.map((item) => item.producto);

    // aqui saco los valores numericos del volumen total por producto
    const dataGraficaVolumen = top10ProductosVolumen.map((item) => Number(item.volumen_total || 0));

    // aqui preparo las fechas de la serie temporal para la grafica de tendencia
    const labelsGraficaTendencia = serieParaVista.map((item) => item.fecha);

    // aqui saco la cantidad de reservas confirmadas por fecha
    const dataTendenciaConfirmaciones = serieParaVista.map((item) => Number(item.total_reservas || 0));

    // aqui saco el peso total acumulado por fecha
    const dataTendenciaPeso = serieParaVista.map((item) => Number(item.peso_total || 0));

    // aqui saco el volumen total acumulado por fecha
    const dataTendenciaVolumen = serieParaVista.map((item) => Number(item.volumen_total || 0));

%>

<section class="admin-shell">
    <div class="admin-hero admin-hero-campaigns">
        <div>
            <span class="admin-eyebrow">Logística</span>
            <h2 class="admin-title">Métricas Consolidadas</h2>
            <p class="admin-subtitle">
                Consulta el peso y volumen consolidado de reservas confirmadas por campaña o cuenta.
            </p>
        </div>
        <div class="admin-hero-note">
            <span><%= etiquetaContextoCampania %></span>
            <strong><%= filtroAgruparPor === 'cuenta' ? 'Cuenta' : 'Campaña' %></strong>
            <small>Periodo del <%= filtroFechaInicio %> al <%= filtroFechaFin %>.</small>
        </div>
    </div>

    <div class="admin-table-card mb-4">
        <div class="admin-table-head">
            <div>
                <h4>Contexto de consulta</h4>
                <p>Esta vista toma el periodo actual y el criterio de agrupación para interpretar el rendimiento logístico.</p>
            </div>
            <span class="admin-table-pill">Resumen</span>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="small text-muted mb-1">Campaña visible</div>
                <strong><%= etiquetaContextoCampania %></strong>
            </div>
            <div class="col-md-4">
                <div class="small text-muted mb-1">Periodo consultado</div>
                <strong><%= filtroFechaInicio %> al <%= filtroFechaFin %></strong>
            </div>
            <div class="col-md-4">
                <div class="small text-muted mb-1">Agrupación activa</div>
                <strong><%= filtroAgruparPor === 'cuenta' ? 'Cuenta' : 'Campaña' %></strong>
            </div>
        </div>
    </div>

    <% if (safePageMessage) { %>
        <div class="alert alert-<%= safePageMessage.tipo %>" role="alert">
            <%= safePageMessage.texto %>
        </div>
    <% } %>

    <div class="admin-table-card">
        <div class="admin-table-head">
            <div>
                <h4>Filtros de consulta</h4>
                <p>Selecciona periodo, agrupación y filtros opcionales para consolidar métricas logísticas.</p>
            </div>
            <span class="admin-table-pill">Estatus: Confirmadas</span>
        </div>

        <form method="GET" action="/logistica/metricas" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Fecha inicio</label>
                <input
                    type="date"
                    name="fecha_inicio"
                    class="form-control"
                    value="<%= filtroFechaInicio %>"
                    required>
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha fin</label>
                <input
                    type="date"
                    name="fecha_fin"
                    class="form-control"
                    value="<%= filtroFechaFin %>"
                    required>
            </div>
            <div class="col-md-3">
                <label class="form-label">Agrupar por</label>
                <select name="agrupar_por" class="form-select">
                    <option value="campania" <%= filtroAgruparPor === 'campania' ? 'selected' : '' %>>Campaña</option>
                    <option value="cuenta" <%= filtroAgruparPor === 'cuenta' ? 'selected' : '' %>>Cuenta</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Campaña</label>
                <select name="id_campania" class="form-select">
                    <option value="">Todas</option>
                    <% safeCampanias.forEach((campania) => { %>
                        <option
                            value="<%= campania.id_campania %>"
                            <%= String(filtroIdCampania) === String(campania.id_campania) ? 'selected' : '' %>>
                            <%= campania.nombre %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Cuenta</label>
                <select name="id_cuenta" class="form-select">
                    <option value="">Todas</option>
                    <% safeCuentas.forEach((cuenta) => { %>
                        <option
                            value="<%= cuenta.id_cuenta %>"
                            <%= String(filtroIdCuenta) === String(cuenta.id_cuenta) ? 'selected' : '' %>>
                            <%= cuenta.nombre %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button class="btn admin-action-btn" type="submit">Consultar</button>
                <button type="button" id="btnLimpiarLogistica" class="btn btn-outline-secondary">Limpiar</button>
            </div>
        </form>
    </div>

    <div class="admin-stats-grid">
        <article class="admin-stat-card admin-stat-accent">
            <span class="admin-stat-label">Peso total</span>
            <strong><%= formatDecimal(safeResumen.totalPeso) %> kg</strong>
            <p>Peso consolidado de productos reservados.</p>
        </article>
        <article class="admin-stat-card">
            <span class="admin-stat-label">Volumen total</span>
            <strong><%= formatDecimal(safeResumen.totalVolumen) %> m³</strong>
            <p>Volumen consolidado para planeación logística.</p>
        </article>
        <article class="admin-stat-card admin-stat-accent">
            <span class="admin-stat-label">Reservas confirmadas</span>
            <strong><%= formatInteger(safeResumen.totalReservas) %></strong>
            <p>Reservas únicas incluidas en la consulta.</p>
        </article>
        <article class="admin-stat-card">
            <span class="admin-stat-label">Importe productos</span>
            <strong>$<%= formatDecimal(safeResumen.totalImporte) %></strong>
            <p>Suma del subtotal de productos reservados.</p>
        </article>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Producto más confirmado</h4>
                        <p>Producto con mayor número de preventas confirmadas en el periodo.</p>
                    </div>
                    <span class="admin-table-pill">Confirmaciones</span>
                </div>

                <% if (topProductoConfirmaciones) { %>
                    <div class="d-flex flex-column gap-2">
                        <strong><%= topProductoConfirmaciones.producto %></strong>
                        <span class="text-muted">SKU: <%= topProductoConfirmaciones.sku %></span>
                        <span><strong><%= formatInteger(topProductoConfirmaciones.preventas_confirmadas) %></strong> preventas confirmadas</span>
                        <span><%= formatInteger(topProductoConfirmaciones.unidades_confirmadas) %> unidades</span>
                        <span><%= formatInteger(topProductoConfirmaciones.cuentas_con_movimiento) %> cuentas con movimiento</span>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">No hay datos de productos para este periodo.</p>
                <% } %>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Producto con mayor peso</h4>
                        <p>Producto que genera la mayor carga total en kilogramos.</p>
                    </div>
                    <span class="admin-table-pill">Peso</span>
                </div>

                <% if (topProductoPeso) { %>
                    <div class="d-flex flex-column gap-2">
                        <strong><%= topProductoPeso.producto %></strong>
                        <span class="text-muted">SKU: <%= topProductoPeso.sku %></span>
                        <span><strong><%= formatDecimal(topProductoPeso.peso_total) %> kg</strong></span>
                        <span><%= formatInteger(topProductoPeso.preventas_confirmadas) %> preventas confirmadas</span>
                        <span><%= formatInteger(topProductoPeso.unidades_confirmadas) %> unidades</span>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">No hay datos de peso por producto.</p>
                <% } %>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Producto con mayor volumen</h4>
                        <p>Producto que ocupa el mayor volumen total dentro del periodo.</p>
                    </div>
                    <span class="admin-table-pill">Volumen</span>
                </div>

                <% if (topProductoVolumen) { %>
                    <div class="d-flex flex-column gap-2">
                        <strong><%= topProductoVolumen.producto %></strong>
                        <span class="text-muted">SKU: <%= topProductoVolumen.sku %></span>
                        <span><strong><%= formatDecimal(topProductoVolumen.volumen_total) %> m³</strong></span>
                        <span><%= formatInteger(topProductoVolumen.preventas_confirmadas) %> preventas confirmadas</span>
                        <span><%= formatInteger(topProductoVolumen.unidades_confirmadas) %> unidades</span>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">No hay datos de volumen por producto.</p>
                <% } %>
            </div>
        </div>
    </div>

    <div class="admin-table-card mb-4">
        <div class="admin-table-head">
            <div>
                <h4>Rendimiento por producto</h4>
                <p>Resumen rápido de productos de la campaña activa o seleccionada.</p>
            </div>
            <span class="admin-table-pill"><%= formatInteger(safeRendimientoProductos.length) %> productos</span>
        </div>

        <div class="admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>SKU</th>
                        <th>Preventas confirmadas</th>
                        <th>Unidades</th>
                        <th>Peso total</th>
                        <th>Volumen total</th>
                        <th>Cuentas</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (top5Productos.length > 0) { %>
                        <% top5Productos.forEach((item) => { %>
                            <tr>
                                <td><strong><%= item.producto %></strong></td>
                                <td><%= item.sku %></td>
                                <td><%= formatInteger(item.preventas_confirmadas) %></td>
                                <td><%= formatInteger(item.unidades_confirmadas) %></td>
                                <td><%= formatDecimal(item.peso_total) %> kg</td>
                                <td><%= formatDecimal(item.volumen_total) %> m³</td>
                                <td><%= formatInteger(item.cuentas_con_movimiento) %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center">
                                No existen productos confirmados para los filtros seleccionados.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Comparativo logístico</h4>
                        <p>Peso y volumen por <%= filtroAgruparPor === 'cuenta' ? 'cuenta' : 'campaña' %>.</p>
                    </div>
                    <span class="admin-table-pill">Lectura rápida</span>
                </div>

                <% if (safeMetricas.length > 0) { %>
                    <div class="vstack gap-3">
                        <% safeMetricas.forEach((item) => {
                            const peso = Number(item.peso_total || 0);
                            const volumen = Number(item.volumen_total || 0);
                            const pesoPct = Math.max(0, Math.min(100, (peso / maxPesoComparativo) * 100));
                            const volumenPct = Math.max(0, Math.min(100, (volumen / maxVolumenComparativo) * 100));
                        %>
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong><%= item.agrupacion || 'Sin agrupación' %></strong>
                                    <small class="text-muted">Res: <%= formatInteger(item.total_reservas) %></small>
                                </div>
                                <div class="small text-muted mb-1">Peso: <%= formatDecimal(peso) %> kg</div>
                                <div class="progress mb-2" role="progressbar" aria-label="Peso total">
                                    <div class="progress-bar bg-primary" style="width: <%= pesoPct.toFixed(2) %>%"></div>
                                </div>
                                <div class="small text-muted mb-1">Volumen: <%= formatDecimal(volumen) %> m³</div>
                                <div class="progress" role="progressbar" aria-label="Volumen total">
                                    <div class="progress-bar bg-warning text-dark" style="width: <%= volumenPct.toFixed(2) %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">Sin datos para graficar.</p>
                <% } %>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Tendencia por fecha</h4>
                        <p>Comportamiento del periodo en confirmaciones, peso y volumen.</p>
                    </div>
                    <span class="admin-table-pill">Serie temporal</span>
                </div>

                <% if (serieParaVista.length > 0) { %>
                    <div style="position: relative; min-height: 360px;">
                        <canvas id="chartTendenciaLogistica"></canvas>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">Sin datos históricos para graficar.</p>
                <% } %>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Top 5 por peso</h4>
                        <p>Participación de las <%= filtroAgruparPor === 'cuenta' ? 'cuentas' : 'campañas' %> con mayor peso.</p>
                    </div>
                    <span class="admin-table-pill">Ranking</span>
                </div>

                <% if (top5Peso.length > 0) { %>
                    <div class="vstack gap-3">
                        <% top5Peso.forEach((item, index) => {
                            const peso = Number(item.peso_total || 0);
                            const participacion = totalPesoGlobal > 0 ? (peso / totalPesoGlobal) * 100 : 0;
                        %>
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong><%= index + 1 %>. <%= item.agrupacion || 'Sin agrupación' %></strong>
                                    <small class="text-muted"><%= formatDecimal(participacion) %>%</small>
                                </div>
                                <div class="small text-muted mb-1"><%= formatDecimal(peso) %> kg</div>
                                <div class="progress" role="progressbar" aria-label="Participación de peso">
                                    <div class="progress-bar bg-primary" style="width: <%= Math.max(0, Math.min(100, participacion)).toFixed(2) %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">Sin datos para calcular top por peso.</p>
                <% } %>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Top 5 por volumen</h4>
                        <p>Participación de las <%= filtroAgruparPor === 'cuenta' ? 'cuentas' : 'campañas' %> con mayor volumen.</p>
                    </div>
                    <span class="admin-table-pill">Ranking</span>
                </div>

                <% if (top5Volumen.length > 0) { %>
                    <div class="vstack gap-3">
                        <% top5Volumen.forEach((item, index) => {
                            const volumen = Number(item.volumen_total || 0);
                            const participacion = totalVolumenGlobal > 0 ? (volumen / totalVolumenGlobal) * 100 : 0;
                        %>
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong><%= index + 1 %>. <%= item.agrupacion || 'Sin agrupación' %></strong>
                                    <small class="text-muted"><%= formatDecimal(participacion) %>%</small>
                                </div>
                                <div class="small text-muted mb-1"><%= formatDecimal(volumen) %> m³</div>
                                <div class="progress" role="progressbar" aria-label="Participación de volumen">
                                    <div class="progress-bar bg-warning text-dark" style="width: <%= Math.max(0, Math.min(100, participacion)).toFixed(2) %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">Sin datos para calcular top por volumen.</p>
                <% } %>
            </div>
        </div>
    </div>

    <div class="admin-table-card mb-4">
        <div class="admin-table-head">
            <div>
                <h4>Preventas confirmadas por producto</h4>
                <p>Top 10 productos con mayor número de confirmaciones dentro del periodo consultado.</p>
            </div>
            <span class="admin-table-pill">Gráfica principal</span>
        </div>

        <% if (top10ProductosGrafica.length > 0) { %>
            <div style="position: relative; min-height: 360px;">
                <canvas id="chartConfirmacionesProducto"></canvas>
            </div>
        <% } else { %>
            <p class="text-center text-muted mt-3 mb-0">No hay productos suficientes para generar la gráfica.</p>
        <% } %>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Peso total por producto</h4>
                        <p>Top 10 productos con mayor carga acumulada en kilogramos.</p>
                    </div>
                    <span class="admin-table-pill">Peso</span>
                </div>

                <% if (top10ProductosPeso.length > 0) { %>
                    <div style="position: relative; min-height: 360px;">
                        <canvas id="chartPesoProducto"></canvas>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">No hay datos suficientes para la gráfica de peso.</p>
                <% } %>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="admin-table-card h-100">
                <div class="admin-table-head">
                    <div>
                        <h4>Volumen total por producto</h4>
                        <p>Top 10 productos con mayor volumen acumulado en el periodo.</p>
                    </div>
                    <span class="admin-table-pill">Volumen</span>
                </div>

                <% if (top10ProductosVolumen.length > 0) { %>
                    <div style="position: relative; min-height: 360px;">
                        <canvas id="chartVolumenProducto"></canvas>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted mt-3 mb-0">No hay datos suficientes para la gráfica de volumen.</p>
                <% } %>
            </div>
        </div>
    </div>

    <div class="admin-table-card">
        <div class="admin-table-head">
            <div>
                <h4>Detalle consolidado</h4>
                <p>Resultados agrupados por <%= filtroAgruparPor === 'cuenta' ? 'cuenta' : 'campaña' %>.</p>
            </div>
            <span class="admin-table-pill"><%= formatInteger(safeMetricas.length) %> registros</span>
        </div>
        <div class="admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th><%= filtroAgruparPor === 'cuenta' ? 'Cuenta' : 'Campaña' %></th>
                        <th>Reservas</th>
                        <th>Productos</th>
                        <th>Peso total</th>
                        <th>Volumen total</th>
                        <th>Importe productos</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (safeMetricas.length > 0) { %>
                        <% safeMetricas.forEach((item) => { %>
                            <tr>
                                <td>
                                    <strong><%= item.agrupacion || 'Sin agrupación' %></strong>
                                </td>
                                <td><%= formatInteger(item.total_reservas) %></td>
                                <td><%= formatInteger(item.total_productos) %></td>
                                <td><%= formatDecimal(item.peso_total) %> kg</td>
                                <td><%= formatDecimal(item.volumen_total) %> m³</td>
                                <td>$<%= formatDecimal(item.importe_productos) %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center">
                                No existen métricas logísticas para los filtros seleccionados.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</section>

<% if (top10ProductosGrafica.length > 0 || top10ProductosPeso.length > 0 || top10ProductosVolumen.length > 0 || serieParaVista.length > 0) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const formatChartNumber = (value, decimals = 0) => {
            const safeValue = Number(value || 0);
            if (!Number.isFinite(safeValue)) {
                return decimals > 0 ? (0).toFixed(decimals) : '0';
            }

            return decimals > 0 ? safeValue.toFixed(decimals) : String(Math.round(safeValue));
        };

        // aqui busco el canvas de confirmaciones
        const canvas = document.getElementById('chartConfirmacionesProducto');

        // aqui busco el canvas de peso por producto
        const canvasPeso = document.getElementById('chartPesoProducto');

        // aqui busco el canvas de volumen por producto
        const canvasVolumen = document.getElementById('chartVolumenProducto');

        // aqui busco el canvas de tendencia por fecha
        const canvasTendencia = document.getElementById('chartTendenciaLogistica');

        // si el canvas no existe por alguna razon, termino sin romper la vista
        if (canvas) {
            // aqui creo la grafica horizontal con Chart.js
            new Chart(canvas, {
                type: 'bar',
                data: {
                    // aqui van los nombres de producto como etiquetas
                    labels: <%- JSON.stringify(labelsGraficaConfirmaciones) %>,
                    datasets: [
                        {
                            // aqui defino el nombre de la serie de datos
                            label: 'Preventas confirmadas',

                            // aqui van los valores numericos de confirmaciones
                            data: <%- JSON.stringify(dataGraficaConfirmaciones) %>,

                            // aqui defino el color visual de las barras
                            backgroundColor: 'rgba(13, 110, 253, 0.72)',

                            // aqui redondeo ligeramente las puntas para que se vea mas limpio
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    // aqui hago que la grafica se adapte al espacio disponible
                    responsive: true,

                    // aqui la pongo horizontal para que se lean mejor los nombres largos
                    indexAxis: 'y',

                    plugins: {
                        // aqui oculto la leyenda porque solo hay una serie
                        legend: { display: false },

                        // aqui pongo un titulo arriba de la grafica
                        title: {
                            display: true,
                            text: 'Top productos por preventas confirmadas',
                            font: { size: 14 }
                        },

                        // aqui personalizo el tooltip para que el texto se vea mas natural
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${formatChartNumber(ctx.parsed.x)} confirmaciones`
                            }
                        }
                    },

                    scales: {
                        // aqui obligo a que el eje X empiece en cero
                        x: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                callback: (value) => formatChartNumber(value)
                            }
                        }
                    }
                }
            });
        }

        // aqui creo la grafica horizontal de peso por producto
        if (canvasPeso) {
            new Chart(canvasPeso, {
                type: 'bar',
                data: {
                    // aqui van los nombres de producto para la grafica de peso
                    labels: <%- JSON.stringify(labelsGraficaPeso) %>,
                    datasets: [
                        {
                            // aqui defino la serie para el peso total acumulado
                            label: 'Peso total (kg)',

                            // aqui van los valores numericos del peso por producto
                            data: <%- JSON.stringify(dataGraficaPeso) %>,

                            // aqui uso un color verde para distinguirlo de confirmaciones
                            backgroundColor: 'rgba(25, 135, 84, 0.72)',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    indexAxis: 'y',
                    plugins: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: 'Top productos por peso total',
                            font: { size: 14 }
                        },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${formatChartNumber(ctx.parsed.x, 2)} kg`
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                callback: (value) => formatChartNumber(value, 2)
                            }
                        }
                    }
                }
            });
        }

        // aqui creo la grafica horizontal de volumen por producto
        if (canvasVolumen) {
            new Chart(canvasVolumen, {
                type: 'bar',
                data: {
                    // aqui van los nombres de producto para la grafica de volumen
                    labels: <%- JSON.stringify(labelsGraficaVolumen) %>,
                    datasets: [
                        {
                            // aqui defino la serie para el volumen total acumulado
                            label: 'Volumen total (m³)',

                            // aqui van los valores numericos del volumen por producto
                            data: <%- JSON.stringify(dataGraficaVolumen) %>,

                            // aqui uso color amarillo para separar visualmente esta grafica
                            backgroundColor: 'rgba(255, 193, 7, 0.72)',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    indexAxis: 'y',
                    plugins: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: 'Top productos por volumen total',
                            font: { size: 14 }
                        },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${formatChartNumber(ctx.parsed.x, 2)} m³`
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                callback: (value) => formatChartNumber(value, 2)
                            }
                        }
                    }
                }
            });
        }

        // aqui creo la grafica de lineas para ver el comportamiento del periodo
        if (canvasTendencia) {
            new Chart(canvasTendencia, {
                type: 'line',
                data: {
                    // aqui van las fechas del periodo como etiquetas del eje X
                    labels: <%- JSON.stringify(labelsGraficaTendencia) %>,
                    datasets: [
                        {
                            // aqui dibujo la linea de confirmaciones por fecha
                            label: 'Confirmaciones',
                            data: <%- JSON.stringify(dataTendenciaConfirmaciones) %>,
                            borderColor: 'rgba(13, 110, 253, 1)',
                            backgroundColor: 'rgba(13, 110, 253, 0.15)',
                            tension: 0.25,
                            fill: false,
                            yAxisID: 'yConfirmaciones'
                        },
                        {
                            // aqui dibujo la linea de peso total por fecha
                            label: 'Peso total (kg)',
                            data: <%- JSON.stringify(dataTendenciaPeso) %>,
                            borderColor: 'rgba(25, 135, 84, 1)',
                            backgroundColor: 'rgba(25, 135, 84, 0.15)',
                            tension: 0.25,
                            fill: false,
                            yAxisID: 'yCarga'
                        },
                        {
                            // aqui dibujo la linea de volumen total por fecha
                            label: 'Volumen total (m³)',
                            data: <%- JSON.stringify(dataTendenciaVolumen) %>,
                            borderColor: 'rgba(255, 193, 7, 1)',
                            backgroundColor: 'rgba(255, 193, 7, 0.15)',
                            tension: 0.25,
                            fill: false,
                            yAxisID: 'yCarga'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Tendencia de confirmaciones, peso y volumen',
                            font: { size: 14 }
                        }
                    },
                    scales: {
                        yConfirmaciones: {
                            type: 'linear',
                            position: 'left',
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                callback: (value) => formatChartNumber(value)
                            },
                            title: {
                                display: true,
                                text: 'Confirmaciones'
                            }
                        },
                        yCarga: {
                            type: 'linear',
                            position: 'right',
                            beginAtZero: true,
                            grid: {
                                drawOnChartArea: false
                            },
                            ticks: {
                                callback: (value) => formatChartNumber(value, 2)
                            },
                            title: {
                                display: true,
                                text: 'Peso / Volumen'
                            }
                        }
                    }
                }
            });
        }
    });
</script>
<% } %>
<script>
document.getElementById('btnLimpiarLogistica')?.addEventListener('click', () => { location.href = '/logistica/metricas'; });
</script>
