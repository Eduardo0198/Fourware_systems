<%- include('../includes/admin/pageIntro', {
    title: 'Reporte Consolidado de Preventas',
    subtitle: 'Genera un archivo con las reservas confirmadas dentro de un rango de fechas. Los campos marcados con * son obligatorios.'
}) %>

<%- include('../includes/shared/pageMessage', { pageMessage }) %>

<div class="card p-4 mb-4">
    <form id="formReportes" method="post" action="/admin/reportes" novalidate>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Fecha inicial <span class="text-danger">*</span></label>
                <input type="date" name="fecha_inicio" class="form-control" value="<%= formData.fecha_inicio || '' %>" data-hint="Primer día del rango a consultar.">
                <div class="invalid-feedback">La fecha inicial es obligatoria.</div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Fecha final <span class="text-danger">*</span></label>
                <input type="date" name="fecha_fin" class="form-control" value="<%= formData.fecha_fin || '' %>" data-hint="Último día del rango. Debe ser igual o posterior a la fecha inicial.">
                <div class="invalid-feedback">La fecha final es obligatoria y debe ser posterior a la inicial.</div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Campaña</label>
                <select name="id_campania" class="form-select" data-hint="Deja en blanco para incluir todas las campañas.">
                    <option value="">Todas las campañas</option>
                    <% campanias.forEach((campania) => { %>
                        <option
                            value="<%= campania.id_campania %>"
                            <%= String(formData.id_campania || '') === String(campania.id_campania) ? 'selected' : '' %>>
                            <%= campania.nombre %>
                        </option>
                    <% }) %>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Tipo de reporte <span class="text-danger">*</span></label>
                <select name="tipo_reporte" id="tipoReporte" class="form-select" data-hint="General incluye todas las reservas. Los otros filtran por cuenta o concesionario.">
                    <option value="general"        <%= formData.tipo_reporte === 'general'        ? 'selected' : '' %>>General</option>
                    <option value="cuenta"         <%= formData.tipo_reporte === 'cuenta'         ? 'selected' : '' %>>Por cuenta</option>
                    <option value="concesionario"  <%= formData.tipo_reporte === 'concesionario'  ? 'selected' : '' %>>Por concesionario</option>
                </select>
                <div class="invalid-feedback">Selecciona un tipo de reporte.</div>
            </div>

            <div class="col-md-4 mb-3" id="filtroCuentaWrap">
                <label class="form-label">Cuenta <span class="text-danger">*</span></label>
                <select name="id_cuenta" id="filtroCuenta" class="form-select" data-hint="Cuenta distribuidora a filtrar en el reporte.">
                    <option value="">-- Selecciona una cuenta --</option>
                    <% cuentas.forEach((cuenta) => { %>
                        <option
                            value="<%= cuenta.id_cuenta %>"
                            <%= String(formData.id_cuenta || '') === String(cuenta.id_cuenta) ? 'selected' : '' %>>
                            <%= cuenta.nombre %>
                        </option>
                    <% }) %>
                </select>
                <div class="invalid-feedback">Debes seleccionar una cuenta.</div>
            </div>

            <div class="col-md-4 mb-3" id="filtroConcesionarioWrap">
                <label class="form-label">Concesionario <span class="text-danger">*</span></label>
                <select name="correo_concesionario" id="filtroConcesionario" class="form-select" data-hint="Concesionario específico a incluir en el reporte.">
                    <option value="">-- Selecciona un concesionario --</option>
                    <% concesionarios.forEach((concesionario) => { %>
                        <option
                            value="<%= concesionario.correo %>"
                            <%= String(formData.correo_concesionario || '') === String(concesionario.correo) ? 'selected' : '' %>>
                            <%= concesionario.nombre %> | <%= concesionario.correo %>
                        </option>
                    <% }) %>
                </select>
                <div class="invalid-feedback">Debes seleccionar un concesionario.</div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Formato de descarga <span class="text-danger">*</span></label>
                <select name="formato" class="form-select" data-hint="CSV para hojas de cálculo. Excel para formato con estilo visual.">
                    <option value="">-- Selecciona un formato --</option>
                    <option value="csv"  <%= formData.formato === 'csv'  ? 'selected' : '' %>>CSV</option>
                    <option value="xlsx" <%= formData.formato === 'xlsx' ? 'selected' : '' %>>Excel (.xlsx)</option>
                </select>
                <div class="invalid-feedback">Selecciona un formato de descarga.</div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Generar reporte</button>
            <a href="/admin" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        </div>
    </form>
</div>

<div class="card p-4">
    <h4 class="mb-3">Columnas incluidas en el reporte</h4>
    <div class="d-flex flex-wrap gap-2">
        <span class="badge bg-secondary">Folio</span>
        <span class="badge bg-secondary">Cuenta</span>
        <span class="badge bg-secondary">Distribuidor</span>
        <span class="badge bg-secondary">Fecha de reserva</span>
        <span class="badge bg-secondary">Estatus</span>
        <span class="badge bg-secondary">Subtotal</span>
        <span class="badge bg-secondary">IVA</span>
        <span class="badge bg-secondary">Total</span>
        <span class="badge bg-secondary">Peso total</span>
        <span class="badge bg-secondary">Volumen total</span>
        <span class="badge bg-secondary">Campaña</span>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tipoReporte          = document.getElementById('tipoReporte');
    const filtroCuentaWrap     = document.getElementById('filtroCuentaWrap');
    const filtroCuenta         = document.getElementById('filtroCuenta');
    const filtroConcesionarioWrap = document.getElementById('filtroConcesionarioWrap');
    const filtroConcesionario  = document.getElementById('filtroConcesionario');

    function actualizarFiltros() {
        const tipo = tipoReporte.value;
        filtroCuentaWrap.style.display        = tipo === 'cuenta'        ? '' : 'none';
        filtroConcesionarioWrap.style.display = tipo === 'concesionario' ? '' : 'none';
        filtroCuenta.required        = tipo === 'cuenta';
        filtroConcesionario.required = tipo === 'concesionario';
        if (tipo !== 'cuenta')        filtroCuenta.value = '';
        if (tipo !== 'concesionario') filtroConcesionario.value = '';
    }

    tipoReporte.addEventListener('change', actualizarFiltros);
    actualizarFiltros();

    document.getElementById('formReportes').addEventListener('submit', function (e) {
        let valido = true;
        this.querySelectorAll('input, select').forEach((c) => c.classList.remove('is-invalid'));

        const fechaInicio = this.querySelector('[name="fecha_inicio"]');
        const fechaFin    = this.querySelector('[name="fecha_fin"]');
        const formato     = this.querySelector('[name="formato"]');

        if (!fechaInicio.value) { fechaInicio.classList.add('is-invalid'); valido = false; }
        if (!fechaFin.value)    { fechaFin.classList.add('is-invalid');    valido = false; }
        if (!formato.value)     { formato.classList.add('is-invalid');     valido = false; }

        if (fechaInicio.value && fechaFin.value && fechaFin.value < fechaInicio.value) {
            fechaFin.classList.add('is-invalid');
            valido = false;
        }

        const tipo = tipoReporte.value;
        if (tipo === 'cuenta' && !filtroCuenta.value) {
            filtroCuenta.classList.add('is-invalid'); valido = false;
        }
        if (tipo === 'concesionario' && !filtroConcesionario.value) {
            filtroConcesionario.classList.add('is-invalid'); valido = false;
        }

        if (!valido) e.preventDefault();
    });
});
</script>
