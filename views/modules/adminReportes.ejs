<h2 class="mb-4">
Reportes consolidados
</h2>
<p class="text-muted">
Vista resumida del estado actual del modulo administrativo mientras la persistencia real sigue en proceso de integracion.
</p>

<div class="stats-grid mb-4">
    <div class="stat-card">
        <span>Total campanas</span>
        <strong><%= metrics.totalCampaigns %></strong>
    </div>
    <div class="stat-card">
        <span>Campanas vigentes</span>
        <strong><%= metrics.validCampaigns %></strong>
    </div>
    <div class="stat-card">
        <span>Productos registrados</span>
        <strong><%= metrics.totalProducts %></strong>
    </div>
    <div class="stat-card">
        <span>Productos inactivos</span>
        <strong><%= metrics.inactiveProducts %></strong>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h4 class="mb-3">
            Campanas
            </h4>
            <ul class="list-group list-group-flush">
                <% campaigns.forEach((campaign) => { %>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span><%= campaign.name %></span>
                    <span class="text-muted"><%= campaign.statusLabel %></span>
                </li>
                <% }) %>
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h4 class="mb-3">
            Ultimos productos
            </h4>
            <% if (recentProducts.length) { %>
            <ul class="list-group list-group-flush">
                <% recentProducts.forEach((product) => { %>
                <li class="list-group-item px-0">
                    <strong><%= product.commercialName %></strong>
                    <div class="text-muted"><%= product.sku %> | <%= product.campaignName %></div>
                </li>
                <% }) %>
            </ul>
            <% } else { %>
            <p class="text-muted mb-0">
            Sin productos registrados por ahora.
            </p>
            <% } %>
        </div>
    </div>
</div>
