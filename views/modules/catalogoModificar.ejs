<h2>Modificar Producto</h2>
<p class="text-muted">
Selecciona un producto para editar su información.
</p>
<div class="card p-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Campaña</th>
                    <th>Estatus</th>
                </tr>
            </thead>
            <tbody>
                <% productos.forEach((producto) => { %>
                    <tr>
                        <td><strong><%= producto.SKU %></strong></td>
                        <td><%= producto.nombre_comercial %></td>
                        <td>$<%= Number(producto.precio_unitario).toFixed(2) %></td>
                        <td><%= producto.nombre_campania || 'Sin campaña' %></td>
                        <td><%= producto.estatusTexto %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
