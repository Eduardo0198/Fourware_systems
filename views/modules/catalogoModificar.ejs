<h2 class="mb-4">Modificar atributos de un producto</h2>

<% if (pageMessage) { %>
    <div class="alert alert-<%= pageMessage.tipo %>">
        <%= pageMessage.texto %>
    </div>
<% } %>

<div class="card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="mb-1">Productos registrados</h4>
            <p class="text-muted mb-0">Selecciona un producto para editar sus atributos.</p>
        </div>
        <div class="w-100" style="max-width: 360px;">
            <input id="buscarProductoModificar" type="text" class="form-control"
                   placeholder="Buscar por SKU, nombre o campaña">
        </div>
    </div>

    <% if (!productos.length) { %>
        <p class="text-center text-muted py-4">No hay productos registrados en el catálogo.</p>
    <% } %>

    <div class="row g-3" id="catalogoModificarGrid">
        <% productos.forEach((producto) => { %>
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 catalogo-modificar-card-col"
                 data-sku="<%= producto.SKU %>"
                 data-search="<%= [producto.SKU, producto.nombre_comercial, producto.nombre_campania || '', producto.estatusTexto].join(' ').toLowerCase() %>">
                <div class="card h-100 shadow-sm catalogo-product-card <%= formData && formData.sku === producto.SKU ? 'border-primary' : '' %>"
                     style="<%= formData && formData.sku === producto.SKU ? 'box-shadow: 0 0 0 3px rgba(13,110,253,.25) !important;' : '' %>">
                    <img src="<%= producto.imagen || '/img/ppg-logo.png' %>"
                         class="card-img-top"
                         style="height:160px; object-fit:contain; background:#f8fafc;"
                         onerror="this.src='/img/ppg-logo.png'">
                    <div class="card-body d-flex flex-column p-3">
                        <h6 class="card-title mb-1 fw-bold" style="font-size:.9rem;"><%= producto.nombre_comercial %></h6>
                        <p class="text-muted mb-1" style="font-size:.78rem;">SKU: <strong><%= producto.SKU %></strong></p>
                        <p class="text-muted mb-2" style="font-size:.78rem;"><%= producto.nombre_campania || 'Sin campaña' %></p>
                        <div class="mb-3">
                            <span class="badge <%= producto.activo ? 'bg-success' : 'bg-secondary' %>">
                                <%= producto.estatusTexto %>
                            </span>
                        </div>
                        <div class="mt-auto d-flex gap-2">
                            <% if (producto.activo) { %>
                                <a href="/admin/catalogo/modificar?sku=<%= encodeURIComponent(producto.SKU) %>#formularioEdicionProducto"
                                   class="btn btn-sm btn-primary flex-fill">
                                    <i class="bi bi-pencil me-1"></i>Modificar
                                </a>
                            <% } else { %>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" disabled>
                                    No disponible
                                </button>
                            <% } %>
                            <form method="post" action="/admin/catalogo/eliminar/<%= encodeURIComponent(producto.SKU) %>" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('¿Eliminar este producto? Si tiene historial, solo se retirará para conservar sus registros.')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <p id="catalogoModificarSinResultados" class="text-center text-muted py-4 d-none">
        Búsqueda sin resultados.
    </p>
</div>

<div class="card p-4 catalogo-modificar-form-card" id="formularioEdicionProducto">
    <% if (formData && formData.sku) { %>
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-3">
            <div>
                <h4 class="mb-1">Formulario de edición</h4>
                <p class="text-muted mb-0">
                    Edita los atributos del producto seleccionado y confirma la actualización.
                </p>
            </div>
            <a href="/admin/catalogo/modificar" class="btn btn-outline-secondary">
                Limpiar selección
            </a>
        </div>

        <p class="text-muted mb-3">Los campos marcados con <span class="text-danger">*</span> son obligatorios.</p>
        <form id="formModificarProducto" method="post" action="/admin/catalogo/modificar/<%= encodeURIComponent(formData.sku) %>" enctype="multipart/form-data" novalidate>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">SKU</label>
                    <input type="text" name="sku" class="form-control" value="<%= formData.sku || '' %>" readonly data-hint="El SKU es un identificador permanente y no puede modificarse.">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre comercial <span class="text-danger">*</span></label>
                    <input type="text" name="nombre_comercial" class="form-control" value="<%= formData.nombre_comercial || '' %>" placeholder="Ej. Pintura Látex Interior Blanco" data-hint="Nombre con el que el producto aparece en el catálogo.">
                    <div class="invalid-feedback">El nombre comercial es obligatorio.</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Descripción <span class="text-danger">*</span></label>
                <textarea name="descripcion" class="form-control" rows="3" placeholder="Ej. Pintura de alta cobertura para interiores, resistente a la humedad." data-hint="Describe las características principales del producto."><%= formData.descripcion || '' %></textarea>
                <div class="invalid-feedback">La descripción es obligatoria.</div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Presentación de venta <span class="text-danger">*</span></label>
                    <input type="text" name="unidad_venta" class="form-control" value="<%= formData.unidad_venta || '' %>" placeholder="Ej. Cubeta 19L" data-hint="Cómo se vende el producto (cubeta, caja, rollo, etc.).">
                    <div class="invalid-feedback">La presentación de venta es obligatoria.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Unidad de medida <span class="text-danger">*</span></label>
                    <input type="text" name="medida_primaria" class="form-control" value="<%= formData.medida_primaria || '' %>" placeholder="Ej. Litro" data-hint="Unidad con la que se mide el producto (litros, kg, metros, piezas).">
                    <div class="invalid-feedback">La unidad de medida es obligatoria.</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Precio unitario ($) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0.01" name="precio_unitario" class="form-control" value="<%= formData.precio_unitario || '' %>" placeholder="Ej. 450.00" data-hint="Precio de venta en pesos mexicanos.">
                    <div class="invalid-feedback">Ingresa un precio mayor a cero.</div>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Peso unitario (kg) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0.01" name="peso_unitario" class="form-control" value="<%= formData.peso_unitario || '' %>" placeholder="Ej. 22.50" data-hint="Peso del producto en kilogramos.">
                    <div class="invalid-feedback">Ingresa un peso mayor a cero.</div>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Volumen unitario (L) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0.01" name="volumen_unitario" class="form-control" value="<%= formData.volumen_unitario || '' %>" placeholder="Ej. 19.00" data-hint="Volumen del producto en litros.">
                    <div class="invalid-feedback">Ingresa un volumen mayor a cero.</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Imagen del producto <span class="text-danger">*</span></label>
                    <div class="mb-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="tipoImagen" id="tipoImagenArchivoMod" value="archivo" checked>
                            <label class="form-check-label" for="tipoImagenArchivoMod">Subir archivo</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="tipoImagen" id="tipoImagenUrlMod" value="url">
                            <label class="form-check-label" for="tipoImagenUrlMod">Usar URL</label>
                        </div>
                    </div>
                    <input type="file" name="imagenArchivo" id="inputArchivoMod" class="form-control" accept="image/jpeg,image/png,image/webp" data-hint="Formatos permitidos: JPG, PNG, WEBP. Tamaño máximo 2 MB.">
                    <input type="text" name="imagen" id="inputUrlMod" class="form-control" style="display:none;" value="<%= formData.imagen || '' %>" placeholder="https://ejemplo.com/imagen.jpg" data-hint="Ingresa la dirección web completa de la imagen del producto.">
                    <div class="invalid-feedback" id="errorImagenMod">Selecciona una imagen o ingresa una URL válida.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaña asociada <span class="text-danger">*</span></label>
                    <select name="id_campania" class="form-select" data-hint="Campaña de preventa a la que pertenece el producto.">
                        <option value="">-- Selecciona una campaña --</option>
                        <% campanias.forEach((campania) => { %>
                            <option
                                value="<%= campania.id_campania %>"
                                <%= String(formData.id_campania || '') === String(campania.id_campania) ? 'selected' : '' %>>
                                <%= campania.nombre %> | <%= campania.estatusTexto %> | <%= campania.fecha_inicio_texto %> - <%= campania.fecha_fin_texto %>
                            </option>
                        <% }) %>
                    </select>
                    <div class="invalid-feedback">Debes seleccionar una campaña.</div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Actualizar producto</button>
                <a href="/admin/catalogo" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver al catálogo</a>
            </div>
        </form>
    <% } else { %>
        <h4 class="mb-2">Formulario de edición</h4>
        <p class="text-muted mb-0">
            Selecciona un producto activo del listado para cargar sus atributos actuales y comenzar la edición.
        </p>
    <% } %>
</div>

<script>
const formMod = document.getElementById('formModificarProducto');
if (formMod) {
    const mensajesMod = {
        nombre_comercial: 'El nombre comercial es obligatorio.',
        descripcion:      'La descripción es obligatoria.',
        unidad_venta:     'La presentación de venta es obligatoria.',
        medida_primaria:  'La unidad de medida es obligatoria.',
        precio_unitario:  'Ingresa un precio mayor a cero.',
        peso_unitario:    'Ingresa un peso mayor a cero.',
        volumen_unitario: 'Ingresa un volumen mayor a cero.',
        id_campania:      'Debes seleccionar una campaña.'
    };

    formMod.addEventListener('submit', function (e) {
        let valido = true;
        formMod.querySelectorAll('input, select, textarea').forEach((c) => c.classList.remove('is-invalid'));

        Object.entries(mensajesMod).forEach(([nombre]) => {
            const campo = formMod.querySelector(`[name="${nombre}"]`);
            if (!campo || !campo.value.trim()) {
                campo?.classList.add('is-invalid');
                valido = false;
            }
        });

        const esArchivo = document.getElementById('tipoImagenArchivoMod').checked;
        const archivo = document.getElementById('inputArchivoMod');
        const url = document.getElementById('inputUrlMod');
        if (esArchivo && !archivo.files.length) {
            archivo.classList.add('is-invalid');
            valido = false;
        } else if (!esArchivo && !url.value.trim()) {
            url.classList.add('is-invalid');
            valido = false;
        }

        if (!valido) e.preventDefault();
    });
}

document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('buscarProductoModificar');
    const cols = Array.from(document.querySelectorAll('.catalogo-modificar-card-col'));
    const sinResultados = document.getElementById('catalogoModificarSinResultados');
    const formulario = document.getElementById('formularioEdicionProducto');
    const skuSeleccionado = '<%= formData && formData.sku ? formData.sku : "" %>';

    if (skuSeleccionado && formulario && window.location.hash === '#formularioEdicionProducto') {
        formulario.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    if (!input) return;

    input.addEventListener('input', () => {
        const termino = input.value.trim().toLowerCase();
        let visibles = 0;

        cols.forEach((col) => {
            const coincide = !termino || col.dataset.search.includes(termino);
            col.style.display = coincide ? '' : 'none';
            if (coincide) visibles++;
        });

        sinResultados.classList.toggle('d-none', visibles > 0 || !termino);
    });
});

document.querySelectorAll('input[name="tipoImagen"]').forEach((radio) => {
    radio.addEventListener('change', function () {
        const esArchivo = this.value === 'archivo';
        document.getElementById('inputArchivoMod').style.display = esArchivo ? '' : 'none';
        document.getElementById('inputUrlMod').style.display = esArchivo ? 'none' : '';
        document.getElementById('inputArchivoMod').required = esArchivo;
        document.getElementById('inputUrlMod').required = !esArchivo;
    });
});
</script>
