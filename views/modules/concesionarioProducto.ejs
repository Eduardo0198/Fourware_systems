<% const _soloLectura = typeof soloLectura !== 'undefined' ? soloLectura : false; %>
<% const _correoActual = typeof usuarioCorreo !== 'undefined' ? usuarioCorreo : null; %>
<% function getImgUrl(url) {
    if (!url || url === 'producto.png') {
        return '/img/ppg-logo.png';
    }
    return url;
} %>
<% function renderStars(puntaje) {
    const valor = Number(puntaje || 0);
    let html = '';
    for (let index = 1; index <= 5; index += 1) {
        html += index <= Math.round(valor) ? '★' : '☆';
    }
    return html;
} %>
<%
function formatCurrency(value) {
    return Number(value || 0).toLocaleString('es-MX', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
}
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <h2 class="mb-0">Detalle del Producto</h2>
    <a href="/concesionario/catalogo" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver al catálogo
    </a>
</div>
<hr>

<div class="row g-4 align-items-start">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center justify-content-center">
        <% if (producto.imagenes && producto.imagenes.length > 1) { %>
            <div id="productoCarousel" class="carousel slide w-100" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <% producto.imagenes.forEach((img, index) => { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                            <img src="<%= getImgUrl(img) %>" class="d-block mx-auto img-fluid" alt="<%= producto.nombre %>">
                        </div>
                    <% }); %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#productoCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#productoCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        <% } else { 
            let singleImg = (producto.imagenes && producto.imagenes[0]) || producto.imagen;
        %>
            <img src="<%= getImgUrl(singleImg) %>" alt="<%= producto.nombre %>" class="img-fluid d-block mx-auto">
        <% } %>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 d-flex flex-column gap-4">
                <div>
                    <h3 class="fw-bold mb-3"><%= producto.nombre %></h3>
                    <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                        <div class="list-group-item d-flex flex-column flex-sm-row gap-2">
                            <span class="fw-semibold text-primary-emphasis flex-shrink-0" style="min-width: 150px;">Descripción:</span>
                            <span class="text-body-secondary"><%= producto.descripcion || 'Sin descripción' %></span>
                        </div>
                        <div class="list-group-item d-flex flex-column flex-sm-row gap-2 bg-primary-subtle">
                            <span class="fw-semibold text-primary-emphasis flex-shrink-0" style="min-width: 150px;">Precio unitario:</span>
                            <span class="text-body-secondary">$<%= formatCurrency(producto.precio_unitario) %></span>
                        </div>
                        <div class="list-group-item d-flex flex-column flex-sm-row gap-2">
                            <span class="fw-semibold text-primary-emphasis flex-shrink-0" style="min-width: 150px;">Unidad de venta:</span>
                            <span class="text-body-secondary"><%= producto.unidad_venta || 'No especificada' %></span>
                        </div>
                        <div class="list-group-item d-flex flex-column flex-sm-row gap-2 bg-primary-subtle">
                            <span class="fw-semibold text-primary-emphasis flex-shrink-0" style="min-width: 150px;">Peso unitario:</span>
                            <span class="text-body-secondary"><%= producto.peso_unitario %> kg</span>
                        </div>
                        <div class="list-group-item d-flex flex-column flex-sm-row gap-2">
                            <span class="fw-semibold text-primary-emphasis flex-shrink-0" style="min-width: 150px;">Volumen unitario:</span>
                            <span class="text-body-secondary"><%= producto.volumen_unitario %> m³</span>
                        </div>
                        <div class="list-group-item d-flex flex-column flex-sm-row gap-2 bg-primary-subtle">
                            <span class="fw-semibold text-primary-emphasis flex-shrink-0" style="min-width: 150px;">Medida primaria:</span>
                            <span class="text-body-secondary"><%= producto.medida_primaria %></span>
                        </div>
                        <div class="list-group-item d-flex flex-column flex-sm-row gap-2">
                            <span class="fw-semibold text-primary-emphasis flex-shrink-0" style="min-width: 150px;">SKU:</span>
                            <span class="text-body-secondary"><%= producto.SKU %></span>
                        </div>
                    </div>
                </div>

        <% if (!_soloLectura) { %>
        <div id="alertaCarrito" class="d-none" role="alert"></div>

        <div class="mt-2">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div>
                    <label class="form-label fw-semibold mb-1 d-block">Cantidad</label>
                    <div class="d-flex align-items-center gap-0 border rounded-3 overflow-hidden" style="width:fit-content;">
                        <button type="button" id="btnMenos" class="btn btn-outline-secondary border-0 px-3 py-2 fs-5 lh-1" style="border-radius:0;">−</button>
                        <input type="number" id="cantidad" value="1" min="1"
                               class="px-2 py-2 fw-bold text-center border-0 bg-transparent"
                               style="width:56px; font-size:1.1rem;">
                        <button type="button" id="btnMas" class="btn btn-outline-secondary border-0 px-3 py-2 fs-5 lh-1" style="border-radius:0;">+</button>
                    </div>
                </div>
                <div class="mt-auto">
                    <button id="btnAgregarCarrito" class="btn btn-primary px-4">
                        <i class="bi bi-cart-plus me-1"></i>Agregar al carrito
                    </button>
                </div>
            </div>
        </div>

        <script>
        (function () {
            const inputCantidad = document.getElementById('cantidad');

            function getQty() { return Math.max(1, parseInt(inputCantidad.value, 10) || 1); }

            document.getElementById('btnMenos').addEventListener('click', () => {
                const q = getQty();
                if (q > 1) inputCantidad.value = q - 1;
            });
            document.getElementById('btnMas').addEventListener('click', () => {
                inputCantidad.value = getQty() + 1;
            });
            inputCantidad.addEventListener('blur', () => {
                inputCantidad.value = getQty();
            });
        })();

        document.getElementById('btnAgregarCarrito').addEventListener('click', async () => {
            const btn = document.getElementById('btnAgregarCarrito');
            const cantidad = document.getElementById('cantidad').value.trim();
            const sku = '<%= producto.SKU %>';
            const returnTo = '<%= returnTo || "/concesionario/catalogo" %>';

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Agregando...';

            try {
                const body = new URLSearchParams({ sku, cantidad, return_to: returnTo });
                const res = await fetch('/concesionario/carrito/agregar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString()
                });

                const data = await res.json();

                if (data.ok) {
                    const cartIcon = document.getElementById('cartHeaderIcon');
                    let badge = cartIcon ? cartIcon.querySelector('.badge') : null;
                    if (cartIcon) {
                        if (!badge) {
                            badge = document.createElement('span');
                            badge.className = 'position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger';
                            badge.style.cssText = 'font-size:0.6rem;min-width:18px';
                            cartIcon.appendChild(badge);
                        }
                        badge.textContent = data.carritoCount;
                    }
                    mostrarAlerta('success', 'Producto agregado correctamente al carrito.');
                } else {
                    mostrarAlerta('danger', data.mensaje);
                }
            } catch (e) {
                mostrarAlerta('danger', 'Error al conectar con el servidor. Intente nuevamente.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cart-plus me-1"></i>Agregar al carrito';
            }
        });

        function mostrarAlerta(tipo, mensaje) {
            const alerta = document.getElementById('alertaCarrito');
            alerta.className = `alert alert-${tipo} alert-dismissible fade show`;
            alerta.innerHTML = `${mensaje} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        }
        </script>
        <% } %>
            </div>
        </div>
    </div>
</div>

<hr>
<section class="reviews-showcase" id="reseñas-producto">
    <div class="reviews-showcase-head">
        <div>
            <span class="reviews-eyebrow">Opinión del cliente</span>
            <h4>Reseñas</h4>
        </div>
        <a href="#formulario-resena" class="btn btn-dark reviews-cta-btn">Escriba una reseña</a>
    </div>

    <div class="reviews-showcase-grid">
        <section class="reviews-panel">
            <h5>Muestra de puntuación</h5>
            <p>Selecciona una fila para identificar cómo se distribuyen las reseñas del producto.</p>

            <div class="reviews-distribution-list">
                <% distribucionConPorcentaje.forEach((item) => { %>
                    <div class="reviews-distribution-row">
                        <span class="reviews-distribution-label"><%= item.estrella %>★</span>
                        <div class="reviews-progress-track" aria-hidden="true">
                            <span class="reviews-progress-fill" style="width: <%= item.porcentaje %>%"></span>
                        </div>
                        <span class="reviews-distribution-total"><%= item.total %></span>
                    </div>
                <% }); %>
            </div>
        </section>

        <section class="reviews-panel reviews-summary-panel">
            <h5>Calificaciones promedio del cliente</h5>

            <div class="reviews-average-block">
                <span class="reviews-average-label">General</span>
                <div class="reviews-average-stars" aria-label="Promedio general de <%= resumenCalificaciones.promedio_general || 0 %> de 5">
                    <span class="reviews-average-stars-visual"><%- renderStars(resumenCalificaciones.promedio_general) %></span>
                    <strong><%= Number(resumenCalificaciones.promedio_general || 0).toFixed(1) %></strong>
                </div>
            </div>

            <div class="reviews-summary-metrics">
                <div class="reviews-summary-metric">
                    <span>Total de reseñas</span>
                    <strong><%= resumenCalificaciones.total_resenas || 0 %></strong>
                </div>
                <div class="reviews-summary-metric">
                    <span>Producto evaluado</span>
                    <strong><%= producto.SKU %></strong>
                </div>
                <div class="reviews-summary-metric">
                    <span>Estado del producto</span>
                    <strong><%= producto.activo ? 'Disponible' : 'Sin preventa' %></strong>
                </div>
            </div>
        </section>
    </div>

    <% if (!_soloLectura) { %>
    <div class="reviews-composer-card" id="formulario-resena">
        <div class="reviews-composer-copy">
            <span class="reviews-compose-kicker">Comparte tu experiencia</span>
            <h5>Califica este producto como en un ecommerce</h5>
            <p>Selecciona estrellas y deja un comentario para ayudar a otros concesionarios a tomar una mejor decisión.</p>
        </div>

        <div id="resena-alerta" class="d-none mb-3"></div>

        <form id="formResena" class="reviews-form">
            <input type="hidden" name="sku" value="<%= producto.SKU %>">
            <input type="hidden" name="id_calificacion" id="resenaIdCalificacion" value="">
            <div class="reviews-star-picker-block">
                <span class="form-label">Tu calificación</span>
                <div class="reviews-star-picker" role="radiogroup" aria-label="Selecciona una calificación de 1 a 5 estrellas">
                    <input type="radio" id="estrella5" name="calificacion" value="5" required>
                    <label for="estrella5" title="5 estrellas">★</label>
                    <input type="radio" id="estrella4" name="calificacion" value="4">
                    <label for="estrella4" title="4 estrellas">★</label>
                    <input type="radio" id="estrella3" name="calificacion" value="3">
                    <label for="estrella3" title="3 estrellas">★</label>
                    <input type="radio" id="estrella2" name="calificacion" value="2">
                    <label for="estrella2" title="2 estrellas">★</label>
                    <input type="radio" id="estrella1" name="calificacion" value="1">
                    <label for="estrella1" title="1 estrella">★</label>
                </div>
                <small>Haz clic en las estrellas para puntuar el producto.</small>
            </div>

            <div class="mb-3">
                <label for="comentario" class="form-label">Comentario</label>
                <textarea id="comentario" name="comentario" class="form-control reviews-textarea" rows="4" maxlength="1000" placeholder="¿Qué te gustó del producto, el acabado o su rendimiento?"></textarea>
            </div>

            <button type="submit" id="btnEnviarResena" class="btn btn-success reviews-submit-btn">Enviar calificación</button>
        </form>
    </div>

    <% } %>

    <section class="reviews-list-section">
        <div class="reviews-list-head">
            <div>
                <h5>Opiniones recientes</h5>
                <p>Estas reseñas se almacenan en la preventa del producto actual.</p>
            </div>
            <span class="reviews-total-pill"><%= resumenCalificaciones.total_resenas || 0 %> reseñas</span>
        </div>

        <% if (resenas && resenas.length > 0) { %>
            <div class="reviews-list-grid">
                <% resenas.forEach((resena) => { %>
                    <article class="review-card" data-id="<%= resena.id_calificacion %>">
                        <div class="review-card-head">
                            <div>
                                <strong><%= resena.nombre || resena.correo %></strong>
                                <span><%= resena.correo %></span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="review-card-date"><%= resena.fecha %></span>
                                <% if (!_soloLectura && resena.correo === _correoActual) { %>
                                <button type="button"
                                        class="btn btn-link p-0 text-primary fw-semibold text-decoration-none btn-editar-resena"
                                        data-id="<%= resena.id_calificacion %>"
                                        data-estrellas="<%= resena.estrellas %>"
                                        data-comentario="<%= (resena.comentario || '').replace(/"/g, '&quot;') %>">
                                    Editar
                                </button>
                                <button type="button"
                                        class="btn btn-link p-0 text-danger fw-semibold text-decoration-none btn-eliminar-resena"
                                        data-id="<%= resena.id_calificacion %>">
                                    Eliminar
                                </button>
                                <% } %>
                            </div>
                        </div>

                        <div class="review-card-stars" aria-label="Calificación de <%= resena.estrellas %> estrellas">
                            <span class="review-stars-display"><%- renderStars(resena.estrellas) %></span>
                            <strong class="review-stars-num"><%= resena.estrellas %>.0</strong>
                        </div>

                        <p class="review-card-comment">
                            <%= resena.comentario && resena.comentario.trim() ? resena.comentario : 'El usuario calificó este producto sin dejar comentario adicional.' %>
                        </p>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div class="reviews-empty-state">
                <strong>Aún no hay reseñas para este producto.</strong>
                <p>Haz la primera calificación y verás aquí el historial de opiniones.</p>
            </div>
        <% } %>
    </section>
</section>

<!-- Modal confirmar eliminar reseña -->
<div class="modal fade" id="modalEliminarResena" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 px-4 pt-4 pb-2" style="background:linear-gradient(135deg,#7f1d1d,#b91c1c);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:44px;height:44px;background:rgba(255,255,255,0.15);">
                        <i class="bi bi-trash3-fill text-white fs-5"></i>
                    </div>
                    <h5 class="modal-title text-white fw-bold mb-0">Eliminar reseña</h5>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <p class="mb-0 fw-semibold text-dark">¿Estás seguro de que deseas eliminar tu reseña? Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarEliminarResena" class="btn btn-danger rounded-pill px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-trash3-fill"></i> Sí, eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const form          = document.getElementById('formResena');
    const idField       = document.getElementById('resenaIdCalificacion');
    const alerta        = document.getElementById('resena-alerta');
    const btnEnviar     = document.getElementById('btnEnviarResena');
    let resenaIdPendiente = null;

    function mostrarAlerta(tipo, texto) {
        if (!alerta) return;
        alerta.className = `alert alert-${tipo}`;
        alerta.textContent = texto;
        alerta.classList.remove('d-none');
    }

    function renderStarsText(n) {
        let s = '';
        for (let i = 1; i <= 5; i++) s += i <= n ? '★' : '☆';
        return s;
    }

    // ── EDITAR ────────────────────────────────────────────────────────────────
    document.querySelectorAll('.btn-editar-resena').forEach(btn => {
        btn.addEventListener('click', () => {
            const id        = btn.dataset.id;
            const estrellas = Number(btn.dataset.estrellas);
            const comentario = btn.dataset.comentario || '';

            if (idField) idField.value = id;

            const radio = form?.querySelector(`input[name="calificacion"][value="${estrellas}"]`);
            if (radio) radio.checked = true;

            const textarea = form?.querySelector('textarea[name="comentario"]');
            if (textarea) textarea.value = comentario;

            if (btnEnviar) btnEnviar.textContent = 'Actualizar reseña';

            const formulario = document.getElementById('formulario-resena');
            if (formulario) formulario.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    });

    // Limpia modo edición al resetear el form
    if (form) {
        form.addEventListener('reset', () => {
            if (idField) idField.value = '';
            if (btnEnviar) btnEnviar.textContent = 'Enviar calificación';
        });
    }

    // Intercepta submit: crea o edita según idField
    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const calificacion = form.querySelector('input[name="calificacion"]:checked');
            if (!calificacion) {
                mostrarAlerta('warning', 'Selecciona una calificación antes de enviar.');
                return;
            }
            if (btnEnviar) { btnEnviar.disabled = true; btnEnviar.textContent = 'Guardando...'; }

            const esEdicion = !!idField?.value;
            const endpoint  = esEdicion ? '/concesionario/producto/resena/editar' : '/concesionario/producto/calificar';
            try {
                const body = new URLSearchParams(new FormData(form));
                const res  = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: body.toString()
                });
                const data = await res.json();
                mostrarAlerta(data.ok ? 'success' : 'danger', data.mensaje);
                if (data.ok) {
                    if (esEdicion) {
                        const card = document.querySelector(`.review-card[data-id="${idField.value}"]`);
                        if (card) {
                            const starsEl = card.querySelector('.review-stars-display');
                            const numEl   = card.querySelector('.review-stars-num');
                            const comentEl = card.querySelector('.review-card-comment');
                            const n = Number(calificacion.value);
                            if (starsEl) starsEl.textContent = renderStarsText(n);
                            if (numEl)   numEl.textContent   = n + '.0';
                            if (comentEl) {
                                const c = form.querySelector('textarea[name="comentario"]').value.trim();
                                comentEl.textContent = c || 'El usuario calificó este producto sin dejar comentario adicional.';
                            }
                            const editBtn = card.querySelector('.btn-editar-resena');
                            if (editBtn) { editBtn.dataset.estrellas = n; editBtn.dataset.comentario = form.querySelector('textarea[name="comentario"]').value; }
                        }
                    }
                    form.reset();
                    setTimeout(() => alerta?.classList.add('d-none'), 4000);
                }
            } catch {
                mostrarAlerta('danger', 'Error al conectar con el servidor.');
            } finally {
                if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = idField?.value ? 'Actualizar reseña' : 'Enviar calificación'; }
            }
        });
    }

    // ── ELIMINAR ──────────────────────────────────────────────────────────────
    document.querySelectorAll('.btn-eliminar-resena').forEach(btn => {
        btn.addEventListener('click', () => {
            resenaIdPendiente = btn.dataset.id;
            const modal = document.getElementById('modalEliminarResena');
            if (modal) bootstrap.Modal.getOrCreateInstance(modal).show();
        });
    });

    document.getElementById('btnConfirmarEliminarResena')?.addEventListener('click', async () => {
        if (!resenaIdPendiente) return;
        const btnConfirmar = document.getElementById('btnConfirmarEliminarResena');
        if (btnConfirmar) btnConfirmar.disabled = true;

        try {
            const res  = await fetch('/concesionario/producto/resena/eliminar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: `id_calificacion=${encodeURIComponent(resenaIdPendiente)}`
            });
            const data = await res.json();
            const modal = bootstrap.Modal.getInstance(document.getElementById('modalEliminarResena'));
            if (modal) modal.hide();

            if (data.ok) {
                const card = document.querySelector(`.review-card[data-id="${resenaIdPendiente}"]`);
                if (card) card.remove();
                const pill = document.querySelector('.reviews-total-pill');
                if (pill) {
                    const n = parseInt(pill.textContent) - 1;
                    pill.textContent = `${n >= 0 ? n : 0} reseñas`;
                }
            }
        } catch {
            /* silencioso — el modal se cierra y la card permanece */
        } finally {
            if (btnConfirmar) btnConfirmar.disabled = false;
            resenaIdPendiente = null;
        }
    });
})();
</script>
