<h2 class="mb-4">
Bitacora de Auditoria
</h2>
<p class="text-muted">
Registro de operaciones administrativas ejecutadas en el entorno mock.
</p>

<div class="card p-4">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Modulo</th>
                    <th>Accion</th>
                    <th>Resultado</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach((log) => { %>
                <tr>
                    <td><%= log.formattedTimestamp %></td>
                    <td><%= log.user %></td>
                    <td><%= log.module %></td>
                    <td>
                        <strong><%= log.action %></strong>
                        <div class="small text-muted"><%= log.details %></div>
                    </td>
                    <td>
                        <span class="badge <%= log.result === 'OK' ? 'bg-success' : 'bg-danger' %>">
                            <%= log.result %>
                        </span>
                    </td>
                    <td><%= log.ipAddress %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
