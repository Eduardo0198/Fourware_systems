<% const filtrosVista = typeof filtros !== 'undefined' ? filtros : {}; %>
<% const registrosVista = Array.isArray(registros) ? registros : []; %>
<% const totalVista = typeof totalRegistros !== 'undefined' ? totalRegistros : 0; %>
<%
    function formatearIp(ip) {
        if (!ip) return 'N/D';
        const valor = String(ip).trim();
        return valor === '::1' ? '127.0.0.1 (localhost)' : valor;
    }
%>

<section class="audit-shell">
    <div class="audit-hero">
        <div>
            <span class="audit-eyebrow">Administrador</span>
            <h2 class="audit-title">Bitácora de Auditoría</h2>
            <p class="audit-subtitle">
                Consulta acciones del sistema, filtra eventos clave y revisa el origen de cada operación.
            </p>
        </div>
        <div class="audit-total-card">
            <span class="audit-total-label">Registros visibles</span>
            <strong><%= totalVista %></strong>
            <small><%= registrosVista.length > 0 ? 'Orden descendente por fecha' : 'Sin resultados cargados' %></small>
        </div>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-<%= mensaje.tipo %> audit-message" role="alert">
            <%= mensaje.texto %>
        </div>
    <% } %>

    <div class="audit-filters-card">
        <div class="audit-card-head">
            <div>
                <h5>Filtros de consulta</h5>
                <p>Refina la búsqueda por usuario o rango de fechas.</p>
            </div>
            <span class="audit-chip">Vista profesional</span>
        </div>
        <form id="formAuditoria" method="GET" action="/admin/auditoria" class="audit-filters-grid" novalidate>
            <input type="hidden" name="consultar" value="1">
            <label class="audit-field">
                <span>Usuario (correo electrónico)</span>
                <input
                    type="text"
                    id="usuario"
                    name="usuario"
                    class="form-control"
                    placeholder="Ej. admin@ppg.com"
                    value="<%= filtrosVista.correo || '' %>"
                    data-hint="Deja vacío para consultar todos los usuarios."
                >
            </label>
            <label class="audit-field">
                <span>Fecha de inicio</span>
                <input
                    type="date"
                    id="fecha_inicio"
                    name="fecha_inicio"
                    class="form-control"
                    value="<%= filtrosVista.fechaInicio || '' %>"
                    data-hint="Fecha desde la que deseas ver eventos."
                >
            </label>
            <label class="audit-field">
                <span>Fecha de fin</span>
                <input
                    type="date"
                    id="fecha_fin"
                    name="fecha_fin"
                    class="form-control"
                    value="<%= filtrosVista.fechaFin || '' %>"
                    data-hint="Debe ser igual o posterior a la fecha de inicio."
                >
                <div class="invalid-feedback">La fecha de fin no puede ser anterior a la de inicio.</div>
            </label>
            <div class="audit-actions">
                <button type="submit" class="btn btn-primary audit-primary-btn">
                    <i class="bi bi-search"></i>
                    Consultar
                </button>
                <button type="button" id="btnLimpiarAuditoria" class="btn btn-outline-secondary audit-secondary-btn">
                    Limpiar
                </button>
            </div>
        </form>
    </div>

    <div class="audit-results-card">
        <div class="audit-card-head">
            <div>
                <h5>Resultados de la consulta</h5>
                <p>Eventos ordenados del más reciente al más antiguo.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="audit-total-pill" id="auditTotalPill">Total: <%= totalVista %></span>
                <a id="auditExportLink"
                   href="/admin/auditoria/exportar?usuario=<%= encodeURIComponent(filtrosVista.correo || '') %>&fecha_inicio=<%= filtrosVista.fechaInicio || '' %>&fecha_fin=<%= filtrosVista.fechaFin || '' %>"
                   class="btn btn-sm audit-primary-btn"
                   style="<%= registrosVista.length === 0 ? 'display:none' : '' %>">
                    <i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel
                </a>
            </div>
        </div>

        <div id="auditResultsContent">
        <% if (registrosVista.length > 0) { %>
            <div class="audit-scroll-top" id="auditScrollTop">
                <div class="audit-scroll-inner" id="auditScrollInner"></div>
            </div>
            <div class="audit-table-wrap" id="auditTableWrap">
                <table class="table audit-table align-middle mb-0" id="auditTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>IP de origen</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% registrosVista.forEach((registro) => { %>
                            <tr>
                                <td>
                                    <span class="audit-log-id">#<%= registro.id_log %></span>
                                </td>
                                <td class="audit-date-cell"><%= registro.fecha %></td>
                                <td>
                                    <span class="audit-user-pill"><%= registro.correo || 'N/D' %></span>
                                </td>
                                <td class="audit-action-cell"><%= registro.accion %></td>
                                <td>
                                    <span class="audit-ip-pill"><%= formatearIp(registro.ip_origen) %></span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="audit-empty-state">
                <div class="audit-empty-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <h4>Sin registros para mostrar</h4>
                <p>
                    <%= estadoConsulta === 'sin-resultados'
                        ? 'No hay registros para los filtros seleccionados. Ajusta los criterios y vuelve a consultar.'
                        : 'Todavía no se han cargado eventos para esta vista.' %>
                </p>
            </div>
        <% } %>
        </div>
    </div>
</section>

<script>
(function () {
    const form        = document.getElementById('formAuditoria');
    const campoFf     = document.getElementById('fecha_fin');
    const btnLimpiar  = document.getElementById('btnLimpiarAuditoria');
    const totalPill   = document.getElementById('auditTotalPill');
    const totalHero   = document.querySelector('.audit-total-card strong');
    const exportLink  = document.getElementById('auditExportLink');
    const content     = document.getElementById('auditResultsContent');

    function escapeHtml(v) {
        return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function formatearIp(ip) {
        if (!ip) return 'N/D';
        const v = String(ip).trim();
        return v === '::1' ? '127.0.0.1 (localhost)' : v;
    }

    function initScrollSync() {
        const scrollTop   = document.getElementById('auditScrollTop');
        const scrollInner = document.getElementById('auditScrollInner');
        const tableWrap   = document.getElementById('auditTableWrap');
        const table       = document.getElementById('auditTable');
        if (!scrollTop || !tableWrap || !table) return;

        function sincronizarAncho() { scrollInner.style.width = table.scrollWidth + 'px'; }
        sincronizarAncho();
        new ResizeObserver(sincronizarAncho).observe(table);

        let syncingTop = false, syncingWrap = false;
        scrollTop.addEventListener('scroll', () => {
            if (syncingWrap) return;
            syncingTop = true; tableWrap.scrollLeft = scrollTop.scrollLeft; syncingTop = false;
        });
        tableWrap.addEventListener('scroll', () => {
            if (syncingTop) return;
            syncingWrap = true; scrollTop.scrollLeft = tableWrap.scrollLeft; syncingWrap = false;
        });
    }

    function buildTabla(registros) {
        const filas = registros.map(r => `
            <tr>
                <td><span class="audit-log-id">#${escapeHtml(r.id_log)}</span></td>
                <td class="audit-date-cell">${escapeHtml(r.fecha)}</td>
                <td><span class="audit-user-pill">${escapeHtml(r.correo || 'N/D')}</span></td>
                <td class="audit-action-cell">${escapeHtml(r.accion)}</td>
                <td><span class="audit-ip-pill">${escapeHtml(formatearIp(r.ip_origen))}</span></td>
            </tr>`).join('');

        return `
            <div class="audit-scroll-top" id="auditScrollTop">
                <div class="audit-scroll-inner" id="auditScrollInner"></div>
            </div>
            <div class="audit-table-wrap" id="auditTableWrap">
                <table class="table audit-table align-middle mb-0" id="auditTable">
                    <thead>
                        <tr>
                            <th>ID</th><th>Fecha</th><th>Usuario</th><th>Acción</th><th>IP de origen</th>
                        </tr>
                    </thead>
                    <tbody>${filas}</tbody>
                </table>
            </div>`;
    }

    function buildVacio() {
        return `
            <div class="audit-empty-state">
                <div class="audit-empty-icon"><i class="bi bi-journal-text"></i></div>
                <h4>Sin registros para mostrar</h4>
                <p>No hay registros para los filtros seleccionados. Ajusta los criterios y vuelve a consultar.</p>
            </div>`;
    }

    function actualizarResultados(data) {
        const total = data.totalRegistros || 0;
        if (totalPill)  totalPill.textContent  = 'Total: ' + total;
        if (totalHero)  totalHero.textContent  = total;

        if (exportLink) {
            if (total > 0) {
                const p = new URLSearchParams({
                    usuario:       form.usuario.value,
                    fecha_inicio:  form.fecha_inicio.value,
                    fecha_fin:     form.fecha_fin.value
                });
                exportLink.href = '/admin/auditoria/exportar?' + p.toString();
                exportLink.style.display = '';
            } else {
                exportLink.style.display = 'none';
            }
        }

        if (content) {
            content.innerHTML = total > 0 ? buildTabla(data.registros) : buildVacio();
            if (total > 0) initScrollSync();
        }
    }

    async function ejecutarConsulta(e) {
        const fi = document.getElementById('fecha_inicio').value;
        const ff = document.getElementById('fecha_fin').value;
        campoFf.classList.remove('is-invalid');
        if (fi && ff && ff < fi) {
            campoFf.classList.add('is-invalid');
            if (e) e.preventDefault();
            return;
        }
        if (e) e.preventDefault();

        const params = new URLSearchParams(new FormData(form));
        try {
            const r = await fetch('/admin/auditoria?' + params.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await r.json();
            actualizarResultados(data);
        } catch {
            if (content) content.innerHTML = buildVacio();
        }
    }

    form.addEventListener('submit', ejecutarConsulta);

    if (btnLimpiar) {
        btnLimpiar.addEventListener('click', () => {
            form.usuario.value       = '';
            form.fecha_inicio.value  = '';
            form.fecha_fin.value     = '';
            ejecutarConsulta(null);
        });
    }

    initScrollSync();
})();
</script>
