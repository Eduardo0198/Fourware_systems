<% const filtrosVista = typeof filtros !== 'undefined' ? filtros : {}; %>
<% const registrosVista = Array.isArray(registros) ? registros : []; %>
<% const totalVista = typeof totalRegistros !== 'undefined' ? totalRegistros : 0; %>
<%
    function formatearIp(ip) {
        if (!ip) return 'N/D';
        const valor = String(ip).trim();
        return valor === '::1' ? '127.0.0.1 (localhost)' : valor;
    }
%>

<section class="audit-shell">
    <div class="audit-hero">
        <div>
            <span class="audit-eyebrow">Administrador</span>
            <h2 class="audit-title">Bitácora de Auditoría</h2>
            <p class="audit-subtitle">
                Consulta acciones del sistema, filtra eventos clave y revisa el origen de cada operación.
            </p>
        </div>
        <div class="audit-total-card">
            <span class="audit-total-label">Registros visibles</span>
            <strong><%= totalVista %></strong>
            <small><%= registrosVista.length > 0 ? 'Orden descendente por fecha' : 'Sin resultados cargados' %></small>
        </div>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-<%= mensaje.tipo %> audit-message" role="alert">
            <%= mensaje.texto %>
        </div>
    <% } %>

    <div class="audit-filters-card">
        <div class="audit-card-head">
            <div>
                <h5>Filtros de consulta</h5>
                <p>Refina la búsqueda por usuario o rango de fechas.</p>
            </div>
            <span class="audit-chip">Vista profesional</span>
        </div>
        <form method="GET" action="/admin/auditoria" class="audit-filters-grid">
            <input type="hidden" name="consultar" value="1">
            <label class="audit-field">
                <span>Usuario</span>
                <input
                    type="text"
                    id="usuario"
                    name="usuario"
                    class="form-control"
                    placeholder="correo@ppg.com"
                    value="<%= filtrosVista.correo || '' %>"
                >
            </label>
            <label class="audit-field">
                <span>Fecha de inicio</span>
                <input
                    type="date"
                    id="fecha_inicio"
                    name="fecha_inicio"
                    class="form-control"
                    value="<%= filtrosVista.fechaInicio || '' %>"
                >
            </label>
            <label class="audit-field">
                <span>Fecha de fin</span>
                <input
                    type="date"
                    id="fecha_fin"
                    name="fecha_fin"
                    class="form-control"
                    value="<%= filtrosVista.fechaFin || '' %>"
                >
            </label>
            <div class="audit-actions">
                <button type="submit" class="btn btn-primary audit-primary-btn">
                    <i class="bi bi-search"></i>
                    Consultar
                </button>
                <a href="/admin/auditoria" class="btn btn-outline-secondary audit-secondary-btn">
                    Limpiar
                </a>
            </div>
        </form>
    </div>

    <div class="audit-results-card">
        <div class="audit-card-head">
            <div>
                <h5>Resultados de la consulta</h5>
                <p>Eventos ordenados del más reciente al más antiguo.</p>
            </div>
            <span class="audit-total-pill">Total: <%= totalVista %></span>
        </div>

        <% if (registrosVista.length > 0) { %>
            <div class="audit-table-wrap">
                <table class="table audit-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>IP de origen</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% registrosVista.forEach((registro) => { %>
                            <tr>
                                <td>
                                    <span class="audit-log-id">#<%= registro.id_log %></span>
                                </td>
                                <td class="audit-date-cell"><%= registro.fecha %></td>
                                <td>
                                    <span class="audit-user-pill"><%= registro.correo || 'N/D' %></span>
                                </td>
                                <td class="audit-action-cell"><%= registro.accion %></td>
                                <td>
                                    <span class="audit-ip-pill"><%= formatearIp(registro.ip_origen) %></span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="audit-empty-state">
                <div class="audit-empty-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <h4>Sin registros para mostrar</h4>
                <p>
                    <%= estadoConsulta === 'sin-resultados'
                        ? 'No hay registros para los filtros seleccionados. Ajusta los criterios y vuelve a consultar.'
                        : 'Todavía no se han cargado eventos para esta vista.' %>
                </p>
            </div>
        <% } %>
    </div>
</section>
