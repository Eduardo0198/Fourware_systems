<h2 class="mb-4">
Bitácora de Auditoría
</h2>
<p class="text-muted">
Consulta de acciones realizadas por los usuarios del sistema.
</p>
<% const filtrosVista = typeof filtros !== 'undefined' ? filtros : {}; %>
<% const registrosVista = Array.isArray(registros) ? registros : []; %>
<% const totalVista = typeof totalRegistros !== 'undefined' ? totalRegistros : 0; %>

<% if (mensaje) { %>
    <div class="alert alert-<%= mensaje.tipo %> mb-4" role="alert">
        <%= mensaje.texto %>
    </div>
<% } %>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="GET" action="/admin/auditoria" class="row g-3 align-items-end">
            <input type="hidden" name="consultar" value="1">
            <div class="col-md-4">
                <label for="usuario" class="form-label">Usuario</label>
                <input
                    type="text"
                    id="usuario"
                    name="usuario"
                    class="form-control"
                    placeholder="correo@ppg.com"
                    value="<%= filtrosVista.correo || '' %>"
                >
            </div>
            <div class="col-md-3">
                <label for="fecha_inicio" class="form-label">Fecha de inicio</label>
                <input
                    type="date"
                    id="fecha_inicio"
                    name="fecha_inicio"
                    class="form-control"
                    value="<%= filtrosVista.fechaInicio || '' %>"
                >
            </div>
            <div class="col-md-3">
                <label for="fecha_fin" class="form-label">Fecha de fin</label>
                <input
                    type="date"
                    id="fecha_fin"
                    name="fecha_fin"
                    class="form-control"
                    value="<%= filtrosVista.fechaFin || '' %>"
                >
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    Consultar
                </button>
                <a href="/admin/auditoria" class="btn btn-outline-secondary">
                    Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h5 class="mb-1">Resultados de la consulta</h5>
                <p class="text-muted mb-0">
                    Registros ordenados cronológicamente de forma descendente.
                </p>
            </div>
            <span class="badge text-bg-primary fs-6">
                Total: <%= totalVista %>
            </span>
        </div>

        <% if (registrosVista.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID Log</th>
                            <th>Fecha</th>
                            <th>Correo del usuario</th>
                            <th>Acción realizada</th>
                            <th>Dirección IP de origen</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% registrosVista.forEach((registro) => { %>
                            <tr>
                                <td><%= registro.id_log %></td>
                                <td><%= registro.fecha %></td>
                                <td><%= registro.correo || 'N/D' %></td>
                                <td><%= registro.accion %></td>
                                <td><%= registro.ip_origen || 'N/D' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-4">
                <i class="bi bi-journal-text fs-1 text-muted"></i>
                <p class="text-muted mb-0 mt-2">
                    <%= estadoConsulta === 'sin-resultados'
                        ? 'No hay registros para los filtros seleccionados. Puedes ajustarlos y volver a consultar.'
                        : 'Ajusta los filtros y consulta la bitácora para visualizar registros.' %>
                </p>
            </div>
        <% } %>
    </div>
</div>
