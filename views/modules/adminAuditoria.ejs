<h2 class="mb-4">
Bitácora de Auditoría
</h2>
<p class="text-muted">
Consulta de acciones realizadas por los usuarios del sistema.
</p>
<div class="card p-4">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>IP de origen</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach((log) => { %>
                    <tr>
                        <td><%= new Date(log.fecha).toLocaleString('es-MX') %></td>
                        <td><%= log.correo || 'Sistema' %></td>
                        <td><%= log.accion %></td>
                        <td><%= log.ip_origen || '-' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
