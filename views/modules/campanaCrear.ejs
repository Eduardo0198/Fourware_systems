<%- include('../includes/admin/pageIntro', {
    title: 'Configurar Campaña',
    subtitle: 'Completa todos los campos para registrar una nueva campaña. Los campos marcados con * son obligatorios.'
}) %>

<%- include('../includes/shared/pageMessage', { pageMessage }) %>

<div class="card p-4 mb-4">
    <form id="formCrearCampana" method="post" action="/admin/campanas/crear" enctype="multipart/form-data" novalidate>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Nombre de la campaña <span class="text-danger">*</span></label>
                <input type="text" name="nombre" class="form-control" value="<%= formData.nombre || '' %>" placeholder="Ej. Preventa Primavera 2025" data-hint="Nombre con el que identificarás la campaña en el sistema.">
                <div class="invalid-feedback">El nombre de la campaña es obligatorio.</div>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Fecha de inicio <span class="text-danger">*</span></label>
                <input type="date" name="fecha_inicio" class="form-control" value="<%= formData.fecha_inicio || '' %>" data-hint="Día en que inicia la campaña de preventa.">
                <div class="invalid-feedback">La fecha de inicio es obligatoria.</div>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Fecha de fin <span class="text-danger">*</span></label>
                <input type="date" name="fecha_fin" class="form-control" value="<%= formData.fecha_fin || '' %>" data-hint="Día en que finaliza la campaña. Debe ser posterior al inicio.">
                <div class="invalid-feedback">La fecha de fin es obligatoria y debe ser posterior al inicio.</div>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Banner</label>

            <img src="" alt="" id="bannerPreview" class="rounded-3 border mb-2 d-none"
                 style="max-height:120px; max-width:100%; object-fit:cover; display:block;">

            <div class="mb-2">
                <label class="form-label small text-muted mb-1">Subir imagen desde tu equipo</label>
                <input type="file" name="bannerArchivo" id="bannerArchivo"
                       class="form-control"
                       accept="image/jpeg,image/png,image/webp"
                       data-hint="Sube un JPG, PNG o WEBP. Si subes imagen, no es necesario llenar la URL.">
            </div>

            <div>
                <label class="form-label small text-muted mb-1">O ingresa una URL</label>
                <input type="text" name="banner" id="bannerUrl" class="form-control"
                       value="<%= formData.banner || '' %>"
                       placeholder="Ej. https://dominio.com/img/banner-primavera.jpg"
                       data-hint="URL de la imagen del banner. Se ignora si subes una imagen.">
                <div class="invalid-feedback">Debes subir una imagen o ingresar una URL de banner.</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Guardar campaña</button>
            <a href="/admin/campanas" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        </div>
    </form>
</div>

<div class="card p-4">
    <h4 class="mb-3">Campañas existentes</h4>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Campaña</th>
                    <th>Vigencia</th>
                    <th>Banner</th>
                    <th>Estatus</th>
                </tr>
            </thead>
            <tbody>
                <% campanias.forEach((campania) => { %>
                    <tr>
                        <td><strong><%= campania.nombre %></strong></td>
                        <td><%= campania.fecha_inicio_texto %> - <%= campania.fecha_fin_texto %></td>
                        <td><small><%= campania.banner %></small></td>
                        <td>
                            <span class="badge <%= campania.estatus ? 'bg-success' : 'bg-secondary' %>">
                                <%= campania.estatusTexto %>
                            </span>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
    const bannerArchivo = document.getElementById('bannerArchivo');
    const bannerPreview = document.getElementById('bannerPreview');
    bannerArchivo.addEventListener('change', () => {
        const file = bannerArchivo.files[0];
        if (file) {
            bannerPreview.src = URL.createObjectURL(file);
            bannerPreview.classList.remove('d-none');
        }
    });

    const form = document.getElementById('formCrearCampana');

    form.addEventListener('submit', function (e) {
        let valido = true;
        form.querySelectorAll('input').forEach((c) => c.classList.remove('is-invalid'));

        ['nombre', 'fecha_inicio', 'fecha_fin'].forEach((nombre) => {
            const campo = form.querySelector(`[name="${nombre}"]`);
            if (!campo || !campo.value.trim()) {
                campo?.classList.add('is-invalid');
                valido = false;
            }
        });

        const tieneArchivo = bannerArchivo.files && bannerArchivo.files.length > 0;
        const urlInput = form.querySelector('[name="banner"]');
        if (!tieneArchivo && !urlInput.value.trim()) {
            urlInput.classList.add('is-invalid');
            valido = false;
        }

        const fechaInicio = form.querySelector('[name="fecha_inicio"]').value;
        const fechaFin    = form.querySelector('[name="fecha_fin"]').value;
        if (fechaInicio && fechaFin && fechaFin < fechaInicio) {
            form.querySelector('[name="fecha_fin"]').classList.add('is-invalid');
            valido = false;
        }

        if (!valido) e.preventDefault();
    });
</script>
