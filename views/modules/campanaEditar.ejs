<%- include('../includes/admin/pageIntro', {
    title: 'Editar Campaña',
    subtitle: 'Selecciona una campaña de la lista para editar sus datos. Los campos marcados con * son obligatorios.'
}) %>

<%- include('../includes/shared/pageMessage', { pageMessage }) %>

<div id="avisoActivar" class="alert alert-warning d-flex align-items-center gap-2 d-none">
    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
    <span>Ya hay una campaña activa. Desactívala primero para poder activar esta.</span>
</div>

<% const hayUnaActiva = campanias.some(c => c.estatus); %>

<% if (hayUnaActiva && !(pageMessage && pageMessage.tipo === 'success')) { %>
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4 py-2">
        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
        <span>Ya hay una campaña activa. Para activar otra, primero desactiva la que está vigente.</span>
    </div>
<% } %>

<div class="card p-4 mb-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Campaña</th>
                    <th class="text-center" style="width: 70px;"></th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Estatus</th>
                </tr>
            </thead>
            <tbody>
                <% campanias.forEach((campania) => { %>
                    <tr>
                        <td><strong><%= campania.nombre %></strong></td>
                        <td class="text-center">
                            <a
                                href="/admin/campanas/editar?id=<%= campania.id_campania %>"
                                class="btn btn-sm btn-outline-primary"
                                title="Editar campaña">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                        <td><%= campania.fecha_inicio_texto %></td>
                        <td><%= campania.fecha_fin_texto %></td>
                        <td>
                            <div class="d-flex align-items-center gap-2 campana-toggle-wrap"
                                 data-id="<%= campania.id_campania %>"
                                 data-activa="<%= campania.estatus ? 'true' : 'false' %>"
                                 data-hay-activa="<%= hayUnaActiva %>">
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input campana-toggle-input" type="checkbox" role="switch" <%= campania.estatus ? 'checked' : '' %>>
                                </div>
                                <span class="badge campana-toggle-badge <%= campania.estatus ? 'bg-success' : 'bg-secondary' %>">
                                    <%= campania.estatus ? 'Activa' : 'Inactiva' %>
                                </span>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<% if (campaniaSeleccionada) { %>
    <div class="card p-4">
        <h4 class="mb-1">Editando: <%= campaniaSeleccionada.nombre %></h4>
        <p class="text-muted mb-3">Modifica los datos de la campaña y guarda los cambios.</p>
        <form id="formEditarCampana" method="post" action="/admin/campanas/editar/<%= campaniaSeleccionada.id_campania %>" enctype="multipart/form-data" novalidate>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre de la campaña <span class="text-danger">*</span></label>
                    <input type="text" name="nombre" class="form-control"
                        value="<%= formData && formData.nombre ? formData.nombre : campaniaSeleccionada.nombre %>"
                        placeholder="Ej. Preventa Primavera 2025"
                        data-hint="Nombre con el que identificarás la campaña en el sistema.">
                    <div class="invalid-feedback">El nombre de la campaña es obligatorio.</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha de inicio <span class="text-danger">*</span></label>
                    <input type="date" name="fecha_inicio" class="form-control"
                        value="<%= formData && formData.fecha_inicio ? formData.fecha_inicio : campaniaSeleccionada.fecha_inicio_input %>"
                        data-hint="Día en que inicia la campaña.">
                    <div class="invalid-feedback">La fecha de inicio es obligatoria.</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha de fin <span class="text-danger">*</span></label>
                    <input type="date" name="fecha_fin" class="form-control"
                        value="<%= formData && formData.fecha_fin ? formData.fecha_fin : campaniaSeleccionada.fecha_fin_input %>"
                        data-hint="Debe ser posterior a la fecha de inicio.">
                    <div class="invalid-feedback">La fecha de fin es obligatoria y debe ser posterior al inicio.</div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Banner</label>

                <% const bannerActual = formData && formData.banner ? formData.banner : campaniaSeleccionada.banner; %>
                <% if (bannerActual) { %>
                    <div class="mb-2">
                        <img src="<%= bannerActual %>" alt="Banner actual"
                             id="bannerPreview"
                             class="rounded-3 border"
                             style="max-height:120px; max-width:100%; object-fit:cover; display:block;">
                    </div>
                <% } else { %>
                    <img src="" alt="" id="bannerPreview" class="rounded-3 border mb-2 d-none"
                         style="max-height:120px; max-width:100%; object-fit:cover; display:block;">
                <% } %>

                <!-- aqui dejo una decision clara para el usuario: mantener, subir archivo o usar URL -->
                <div class="mb-3">
                    <div class="form-label small text-muted mb-2">Selecciona como quieres manejar el banner</div>

                    <div class="d-flex flex-wrap gap-3">
                        <% if (bannerActual) { %>
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="modoBanner"
                                    id="modoBannerMantener"
                                    value="mantener"
                                    checked>
                                <label class="form-check-label" for="modoBannerMantener">
                                    Mantener banner actual
                                </label>
                            </div>
                        <% } %>

                        <div class="form-check">
                            <input
                                class="form-check-input"
                                type="radio"
                                name="modoBanner"
                                id="modoBannerArchivo"
                                value="archivo"
                                <%= !bannerActual ? 'checked' : '' %>>
                            <label class="form-check-label" for="modoBannerArchivo">
                                Subir imagen desde mi equipo
                            </label>
                        </div>

                        <div class="form-check">
                            <input
                                class="form-check-input"
                                type="radio"
                                name="modoBanner"
                                id="modoBannerUrl"
                                value="url">
                            <label class="form-check-label" for="modoBannerUrl">
                                Usar URL
                            </label>
                        </div>
                    </div>
                </div>

                <!-- aqui agrupo el input de archivo para mostrarlo u ocultarlo segun la opcion seleccionada -->
                <div class="mb-2" id="bloqueBannerArchivo" style="<%= bannerActual ? 'display:none;' : '' %>">
                    <label class="form-label small text-muted mb-1">Subir imagen desde tu equipo</label>
                    <input type="file" name="bannerArchivo" id="bannerArchivo"
                           class="form-control"
                           accept="image/jpeg,image/png,image/webp"
                           data-hint="Sube un JPG, PNG o WEBP. Si eliges archivo, no necesitas llenar la URL.">
                </div>

                <!-- aqui agrupo el input de URL para mostrarlo solo cuando el usuario quiera usar URL -->
                <div id="bloqueBannerUrl" style="display:none;">
                    <label class="form-label small text-muted mb-1">Ingresar URL del banner</label>
                    <input type="text" name="banner" id="bannerUrl" class="form-control"
                        value="<%= bannerActual %>"
                        placeholder="Ej. https://dominio.com/img/banner.jpg"
                        data-hint="Usa esta opcion solo si no vas a subir una imagen desde tu equipo.">
                    <div class="invalid-feedback">Debes ingresar una URL valida o elegir otra forma de banner.</div>
                </div>

                <div class="form-text mt-2">
                    Puedes conservar el banner actual, subir uno nuevo desde tu equipo o usar una URL.
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
                <a href="/admin/campanas" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver a campañas</a>
            </div>
        </form>
    </div>
<% } %>

<script>
document.querySelectorAll('.campana-toggle-wrap').forEach(wrap => {
    const checkbox = wrap.querySelector('.campana-toggle-input');
    const badge    = wrap.querySelector('.campana-toggle-badge');
    const id       = wrap.dataset.id;

    checkbox.addEventListener('change', async () => {
        const activar   = checkbox.checked;
        const hayActiva = wrap.dataset.hayActiva === 'true';

        if (activar && hayActiva) {
            checkbox.checked = false;
            const aviso = document.getElementById('avisoActivar');
            if (aviso) { aviso.classList.remove('d-none'); setTimeout(() => aviso.classList.add('d-none'), 2500); }
            return;
        }

        checkbox.disabled = true;
        const accion = activar ? 'activar' : 'desactivar';

        try {
            const res  = await fetch(`/admin/campanas/estado/${id}/${accion}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await res.json();

            if (data.ok) {
                badge.textContent = data.nuevoEstatus ? 'Activa' : 'Inactiva';
                badge.className   = `badge campana-toggle-badge ${data.nuevoEstatus ? 'bg-success' : 'bg-secondary'}`;
                wrap.dataset.activa = String(data.nuevoEstatus);
                document.querySelectorAll('.campana-toggle-wrap').forEach(w => {
                    if (w !== wrap) w.dataset.hayActiva = String(data.nuevoEstatus);
                });
            } else {
                checkbox.checked = !activar;
                const aviso = document.getElementById('avisoActivar');
                if (aviso) { aviso.textContent = data.mensaje; aviso.classList.remove('d-none'); setTimeout(() => aviso.classList.add('d-none'), 3000); }
            }
        } catch {
            checkbox.checked = !activar;
        } finally {
            checkbox.disabled = false;
        }
    });
});

<% if (campaniaSeleccionada) { %>
document.getElementById('formEditarCampana')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

const bannerArchivo = document.getElementById('bannerArchivo');
const bannerPreview = document.getElementById('bannerPreview');
const bannerUrl = document.getElementById('bannerUrl');
const bloqueBannerArchivo = document.getElementById('bloqueBannerArchivo');
const bloqueBannerUrl = document.getElementById('bloqueBannerUrl');
const radiosModoBanner = document.querySelectorAll('input[name="modoBanner"]');

// aqui cambio la interfaz segun la opcion elegida por el usuario
function actualizarModoBanner() {
    const modoSeleccionado = document.querySelector('input[name="modoBanner"]:checked')?.value || 'archivo';

    if (bloqueBannerArchivo) {
        bloqueBannerArchivo.style.display = modoSeleccionado === 'archivo' ? '' : 'none';
    }

    if (bloqueBannerUrl) {
        bloqueBannerUrl.style.display = modoSeleccionado === 'url' ? '' : 'none';
    }

    // aqui si el usuario decide mantener el banner actual, limpio errores visuales
    if (modoSeleccionado === 'mantener') {
        bannerArchivo?.classList.remove('is-invalid');
        bannerUrl?.classList.remove('is-invalid');
    }
}

radiosModoBanner.forEach((radio) => {
    radio.addEventListener('change', actualizarModoBanner);
});

actualizarModoBanner();

if (bannerArchivo && bannerPreview) {
    bannerArchivo.addEventListener('change', () => {
        const file = bannerArchivo.files[0];
        if (file) {
            const url = URL.createObjectURL(file);
            bannerPreview.src = url;
            bannerPreview.classList.remove('d-none');
        }
    });
}

const formEditar = document.getElementById('formEditarCampana');
const mensajesEditar = {
    nombre:      'El nombre de la campaña es obligatorio.',
    fecha_inicio:'La fecha de inicio es obligatoria.',
    fecha_fin:   'La fecha de fin es obligatoria.',
    banner:      'La URL del banner es obligatoria.'
};

formEditar.addEventListener('submit', function (e) {
    let valido = true;
    formEditar.querySelectorAll('input').forEach((c) => c.classList.remove('is-invalid'));

    Object.entries(mensajesEditar).forEach(([nombre]) => {
        if (nombre === 'banner') {
            const modoSeleccionado = document.querySelector('input[name="modoBanner"]:checked')?.value || 'archivo';
            const archivoInput = formEditar.querySelector('[name="bannerArchivo"]');
            const urlInput = formEditar.querySelector('[name="banner"]');
            const tieneArchivo = archivoInput && archivoInput.files && archivoInput.files.length > 0;
            const tieneUrl = urlInput && urlInput.value.trim();

            // aqui valido solo el campo que corresponde segun la opcion elegida
            if (modoSeleccionado === 'archivo' && !tieneArchivo) {
                archivoInput?.classList.add('is-invalid');
                valido = false;
            }

            if (modoSeleccionado === 'url' && !tieneUrl) {
                urlInput?.classList.add('is-invalid');
                valido = false;
            }

            // si el usuario elige mantener el actual, no obligo archivo ni URL
            return;
        }
        const campo = formEditar.querySelector(`[name="${nombre}"]`);
        if (!campo || !campo.value.trim()) {
            campo?.classList.add('is-invalid');
            valido = false;
        }
    });

    const fi = formEditar.querySelector('[name="fecha_inicio"]').value;
    const ff = formEditar.querySelector('[name="fecha_fin"]').value;
    if (fi && ff && ff < fi) {
        formEditar.querySelector('[name="fecha_fin"]').classList.add('is-invalid');
        valido = false;
    }

    if (!valido) e.preventDefault();
});
<% } %>
</script>
