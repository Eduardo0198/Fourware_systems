<%- include('../includes/admin/pageIntro', {
    title: 'Editar Campaña',
    subtitle: ''
}) %>

<%- include('../includes/shared/pageMessage', { pageMessage }) %>
<div id="avisoActivar" class="alert alert-warning d-flex align-items-center gap-2 d-none">
    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
    <span>Ya hay una campaña activa. Desactívala primero para poder activar esta.</span>
</div>

<% const hayUnaActiva = campanias.some(c => c.estatus); %>

<% if (hayUnaActiva && !(pageMessage && pageMessage.tipo === 'success')) { %>
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4 py-2">
        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
        <span>Ya hay una campaña activa. Para activar otra, primero desactiva la que está vigente.</span>
    </div>
<% } %>

<div class="card p-4 mb-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Campaña</th>
                    <th class="text-center" style="width: 70px;"></th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Estatus</th>
                </tr>
            </thead>
            <tbody>
                <% campanias.forEach((campania) => { %>
                    <tr>
                        <td><strong><%= campania.nombre %></strong></td>
                        <td class="text-center">
                            <a
                                href="/admin/campanas/editar?id=<%= campania.id_campania %>"
                                class="btn btn-sm btn-outline-primary"
                                title="Editar campaña">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                        <td><%= campania.fecha_inicio_texto %></td>
                        <td><%= campania.fecha_fin_texto %></td>
                        <td>
                            <% if (campania.estatus) { %>
                                <form method="post" action="/admin/campanas/estado/<%= campania.id_campania %>/desactivar" class="m-0 d-flex align-items-center gap-2">
                                    <div class="form-check form-switch m-0">
                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            role="switch"
                                            checked
                                            onchange="this.form.submit()">
                                    </div>
                                    <span class="badge bg-success">Activa</span>
                                </form>
                            <% } else { %>
                                <form method="post" action="/admin/campanas/estado/<%= campania.id_campania %>/activar" class="m-0 d-flex align-items-center gap-2 form-activar-campana" data-hay-activa="<%= hayUnaActiva %>">
                                    <div class="form-check form-switch m-0">
                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            role="switch"
                                            onchange="intentarActivar(this)">
                                    </div>
                                    <span class="badge bg-secondary">Inactiva</span>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<% if (campaniaSeleccionada) { %>
    <div class="card p-4">
        <h4 class="mb-3">
        Editando: <%= campaniaSeleccionada.nombre %>
        </h4>
        <form method="post" action="/admin/campanas/editar/<%= campaniaSeleccionada.id_campania %>">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre de la campaña</label>
                    <input
                        type="text"
                        name="nombre"
                        class="form-control"
                        value="<%= formData && formData.nombre ? formData.nombre : campaniaSeleccionada.nombre %>"
                        placeholder="Ej. Preventa Primavera 2025"
                        required>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha de inicio</label>
                    <input
                        type="date"
                        name="fecha_inicio"
                        class="form-control"
                        value="<%= formData && formData.fecha_inicio ? formData.fecha_inicio : campaniaSeleccionada.fecha_inicio_input %>"
                        required>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha de fin</label>
                    <input
                        type="date"
                        name="fecha_fin"
                        class="form-control"
                        value="<%= formData && formData.fecha_fin ? formData.fecha_fin : campaniaSeleccionada.fecha_fin_input %>"
                        required>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Banner</label>
                <input
                    type="text"
                    name="banner"
                    class="form-control"
                    value="<%= formData && formData.banner ? formData.banner : campaniaSeleccionada.banner %>"
                    placeholder="Ej. https://dominio.com/img/banner-primavera.jpg"
                    required>
            </div>
            <button class="btn btn-primary" type="submit">
                Guardar cambios
            </button>
        </form>
    </div>
<% } %>

<script>
function intentarActivar(checkbox) {
    const form = checkbox.closest('.form-activar-campana');
    const hayActiva = form.dataset.hayActiva === 'true';
    if (hayActiva) {
        checkbox.checked = false;
        const aviso = document.getElementById('avisoActivar');
        aviso.classList.remove('d-none');
        setTimeout(() => aviso.classList.add('d-none'), 2500);
        return;
    }
    form.submit();
}
</script>
