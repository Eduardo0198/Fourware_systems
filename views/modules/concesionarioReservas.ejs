<% function formatCurrency(value) {
    return Number(value || 0).toLocaleString('es-MX', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
} %>

<h2>Mis Reservas</h2>
<hr>

<% const alertMessage = pageMessage || mensaje || null; %>
<% if (alertMessage) { %>
    <div class="alert alert-<%= alertMessage.tipo %> mb-3" role="alert">
        <%= alertMessage.texto %>
    </div>
<% } %>

<% if (reservas && reservas.length > 0) { %>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Folio</th>
                <th>Fecha</th>
                <th>Estatus</th>
                <th>Subtotal</th>
                <th>IVA</th>
                <th>Total</th>
                <th>Límite de cancelación</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            <% reservas.forEach((reserva) => { %>
                <tr>
                    <td><strong><%= reserva.folio %></strong></td>
                    <td><%= reserva.fechaTexto %></td>
                    <td>
                        <span class="badge text-bg-<%= reserva.estatusClase %>">
                            <%= reserva.estatusTexto %>
                        </span>
                    </td>
                    <td>$<%= formatCurrency(reserva.subtotal) %></td>
                    <td>$<%= formatCurrency(reserva.iva) %></td>
                    <td>$<%= formatCurrency(reserva.total) %></td>
                    <td>
                        <% if (reserva.puedeCancelar && reserva.fechaCancelacionISO) { %>
                            <div class="cancel-countdown" data-deadline="<%= reserva.fechaCancelacionISO %>">
                                <div class="cancel-countdown-digits">
                                    <span class="cd-d">--</span><span class="cd-unit">d</span>
                                    <span class="cd-h">--</span><span class="cd-unit">h</span>
                                    <span class="cd-m">--</span><span class="cd-unit">m</span>
                                    <span class="cd-s">--</span><span class="cd-unit">s</span>
                                </div>
                            </div>
                        <% } else if (reserva.estatusNumerico === 0) { %>
                            <span class="text-muted">—</span>
                        <% } else { %>
                            <span class="text-danger small">Venció el <%= reserva.fechaCancelacionTexto %></span>
                        <% } %>
                    </td>
                    <td class="d-flex gap-2">
                        <a href="/concesionario/reserva/<%= reserva.folio %>" class="btn btn-primary btn-sm">
                            Ver detalle
                        </a>
                        <% if (reserva.puedeCancelar) { %>
                            <a href="/concesionario/cancelar-reserva?folio=<%= reserva.folio %>" class="btn btn-outline-danger btn-sm">
                                Cancelar
                            </a>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<% } else { %>
    <% if (!alertMessage) { %>
        <div class="alert alert-info">
            No existen reservas registradas para la cuenta activa.
        </div>
    <% } %>
<% } %>

<script>
document.querySelectorAll('.cancel-countdown').forEach(function (el) {
    const deadline = new Date(el.dataset.deadline).getTime();
    const dEl = el.querySelector('.cd-d');
    const hEl = el.querySelector('.cd-h');
    const mEl = el.querySelector('.cd-m');
    const sEl = el.querySelector('.cd-s');

    function pad(n) { return String(n).padStart(2, '0'); }

    function tick() {
        const dist = deadline - Date.now();
        if (dist <= 0) {
            dEl.textContent = '00'; hEl.textContent = '00';
            mEl.textContent = '00'; sEl.textContent = '00';
            clearInterval(timer);
            return;
        }
        dEl.textContent = pad(Math.floor(dist / 86400000));
        hEl.textContent = pad(Math.floor((dist / 3600000) % 24));
        mEl.textContent = pad(Math.floor((dist / 60000) % 60));
        sEl.textContent = pad(Math.floor((dist / 1000) % 60));
    }

    tick();
    var timer = setInterval(tick, 1000);
});
</script>
