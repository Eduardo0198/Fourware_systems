<% function formatCurrency(value) {
    return Number(value || 0).toLocaleString('es-MX', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
} %>

<h2>Mis Reservas</h2>
<hr>

<% const alertMessage = pageMessage || mensaje || null; %>
<% if (alertMessage) { %>
    <div class="alert alert-<%= alertMessage.tipo %> mb-3" role="alert">
        <%= alertMessage.texto %>
    </div>
<% } %>

<% if (reservas && reservas.length > 0) { %>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Folio</th>
                <th>Fecha</th>
                <th>Estatus</th>
                <th>Subtotal</th>
                <th>IVA</th>
                <th>Total</th>
                <th>Fecha límite de cancelación</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            <% reservas.forEach((reserva) => { %>
                <tr>
                    <td><strong><%= reserva.folio %></strong></td>
                    <td><%= reserva.fechaTexto %></td>
                    <td>
                        <span class="badge text-bg-<%= reserva.estatusClase %>">
                            <%= reserva.estatusTexto %>
                        </span>
                    </td>
                    <td>$<%= formatCurrency(reserva.subtotal) %></td>
                    <td>$<%= formatCurrency(reserva.iva) %></td>
                    <td>$<%= formatCurrency(reserva.total) %></td>
                    <td>
                        <% if (reserva.puedeCancelar) { %>
                            Disponible hasta <%= reserva.fechaCancelacionTexto %>
                        <% } else if (reserva.estatusNumerico === 0) { %>
                            Ya cancelada
                        <% } else { %>
                            Venció el <%= reserva.fechaCancelacionTexto %>
                        <% } %>
                    </td>
                    <td class="d-flex gap-2">
                        <a href="/concesionario/reserva/<%= reserva.folio %>" class="btn btn-primary btn-sm">
                            Ver detalle
                        </a>
                        <% if (reserva.puedeCancelar) { %>
                            <a href="/concesionario/cancelar-reserva?folio=<%= reserva.folio %>" class="btn btn-outline-danger btn-sm">
                                Cancelar
                            </a>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<% } else { %>
    <% if (!alertMessage) { %>
        <div class="alert alert-info">
            No existen reservas registradas para la cuenta activa.
        </div>
    <% } %>
<% } %>
