<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <span class="badge text-bg-light text-uppercase fw-semibold mb-2">Reserva</span>
        <h2 class="mb-1">Detalle de Reserva</h2>
        <p class="text-muted mb-0">Consulta productos, totales y acciones disponibles para esta operación.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <% if (reserva.puedeCancelar) { %>
            <a href="/concesionario/cancelar-reserva?folio=<%= reserva.folio %>" class="btn btn-danger">
                Cancelar reserva
            </a>
        <% } %>
        <a href="/concesionario/reserva/<%= reserva.folio %>/pdf" class="btn btn-outline-primary">
            Descargar PDF
        </a>
        <a href="/concesionario/reservas" class="btn btn-outline-secondary">
            Volver
        </a>
    </div>
</div>

<%- include('../includes/reservaInfoCard', {
    items: [
        {
            label: 'Folio',
            value: reserva.folio,
            valueClass: 'fw-bold'
        },
        {
            label: 'Fecha',
            value: reserva.fechaTexto
        },
        {
            label: 'Estatus',
            badge: {
                className: reserva.estatusClase,
                text: reserva.estatusTexto
            }
        },
        {
            label: 'Sucursal',
            value: reserva.fechaSucursalTexto,
            col: 'col-md-6',
            extra: {
                className: 'text-muted',
                text: reserva.direccionSucursal || 'Sin dirección registrada'
            }
        },
        {
            label: 'Límite de cancelación',
            value: reserva.fechaCancelacionTexto,
            col: 'col-md-6',
            extra: reserva.puedeCancelar
                ? {
                    className: 'text-success',
                    text: 'La reserva aún puede cancelarse dentro de la ventana configurada.'
                }
                : reserva.estatusNumerico === 0
                    ? {
                        className: 'text-danger',
                        text: 'La reserva ya fue cancelada.'
                    }
                    : {
                        className: 'text-danger',
                        text: 'La ventana de cancelación ya expiró.'
                    }
        }
    ]
}) %>

<div class="card border-0 shadow-sm mb-4 reserva-detail-table-card">
    <div class="card-body p-0">
        <div class="px-4 py-3 border-bottom bg-light-subtle">
            <h3 class="h5 mb-1">Productos de la reserva</h3>
            <p class="text-muted mb-0">Detalle por artículo, presentación y monto aplicado en la confirmación.</p>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 reserva-detail-table">
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Producto</th>
                        <th>SKU</th>
                        <th>Medida</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <% reserva.productos.forEach((producto) => { %>
                        <tr>
                            <td class="text-center reserva-product-image-cell">
                                <% if (producto.imagen) { %>
                                    <img
                                        src="<%= producto.imagen %>"
                                        alt="<%= producto.nombre_comercial || 'Producto' %>"
                                        class="img-fluid rounded border bg-white p-2 reserva-product-image"
                                        onerror="this.onerror=null;this.src='/img/ppg-logo.png';">
                                <% } else { %>
                                    <span class="text-muted small">Sin imagen</span>
                                <% } %>
                            </td>
                            <td class="fw-semibold"><%= producto.nombre_comercial || 'Producto sin nombre' %></td>
                            <td><span class="badge text-bg-light"><%= producto.SKU %></span></td>
                            <td><span class="text-muted"><%= producto.medida_primaria || 'N/D' %></span></td>
                            <td class="fw-semibold"><%= producto.cantidad %></td>
                            <td>$<%= Number(producto.precio_aplicado || 0).toFixed(2) %></td>
                            <td class="fw-bold text-primary">$<%= Number(producto.subtotal_linea || 0).toFixed(2) %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../includes/reservaInfoCard', {
    items: [
        {
            label: 'Subtotal',
            value: `$${Number(reserva.subtotal || 0).toFixed(2)}`
        },
        {
            label: 'IVA',
            value: `$${Number(reserva.iva || 0).toFixed(2)}`
        },
        {
            label: 'Total',
            value: `$${Number(reserva.total || 0).toFixed(2)}`,
            valueClass: 'fw-bold'
        }
    ]
}) %>
