<h2>Cancelar Reserva</h2>
<hr>

<div class="card border-warning shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Confirmación de cancelación</h5>
        <p class="mb-2">
            Estás por cancelar la reserva <strong><%= reserva.folio %></strong>.
        </p>
        <p class="mb-2">
            Fecha límite para cancelar: <strong><%= reserva.fechaCancelacionTexto %></strong>
        </p>
        <p class="mb-0">
            <% if (reserva.puedeCancelar) { %>
                La ventana configurada por el administrador sigue vigente y puedes continuar.
            <% } else if (reserva.estatusNumerico === 0) { %>
                Esta reserva ya se encuentra cancelada.
            <% } else { %>
                La ventana de cancelación ya expiró.
            <% } %>
        </p>
    </div>
</div>

<%- include('../includes/reservaInfoCard', {
    items: [
        {
            label: 'Total',
            value: `$${Number(reserva.total || 0).toFixed(2)}`,
            valueClass: 'fw-bold'
        },
        {
            label: 'Sucursal',
            value: reserva.fechaSucursalTexto
        },
        {
            label: 'Estatus actual',
            badge: {
                className: reserva.estatusClase,
                text: reserva.estatusTexto
            }
        }
    ]
}) %>

<div class="d-flex flex-column flex-sm-row gap-2">
    <% if (reserva.puedeCancelar) { %>
        <form method="POST" action="/concesionario/cancelar-reserva">
            <input type="hidden" name="folio" value="<%= reserva.folio %>">
            <button class="btn btn-danger" type="submit">
                Confirmar cancelación
            </button>
        </form>
    <% } %>

    <a href="/concesionario/reserva/<%= reserva.folio %>" class="btn btn-secondary">
        Volver
    </a>
</div>
