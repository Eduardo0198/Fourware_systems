<section class="admin-shell">
    <%- include('../includes/admin/hero', {
        heroClass: 'admin-hero-campaigns',
        eyebrow: 'Administrador',
        title: 'Ventana de Cancelación',
        subtitle: 'Define el temporizador operativo que controla cuántas horas tiene una reserva para cancelarse.',
        note: {
            label: 'Configuración actual',
            value: `${horasCancelacion || 24} horas`,
            help: 'Este valor se aplica al cálculo de la fecha límite de cancelación.'
        }
    }) %>

    <% if (pageMessage) { %>
        <div class="alert alert-<%= pageMessage.tipo %>" role="alert">
            <%= pageMessage.texto %>
        </div>
    <% } %>

    <div class="admin-table-card">
        <%- include('../includes/admin/tableHead', {
            title: 'Configurar temporizador',
            subtitle: 'Indica cuántas horas estarán disponibles para cancelar una reserva después de su confirmación.',
            pillText: 'Operación vigente'
        }) %>

        <form method="post" action="/admin/campanas/cancelacion" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Horas permitidas para cancelar reservas</label>
                <input
                    type="number"
                    min="1"
                    step="1"
                    name="horas_cancelacion"
                    class="form-control"
                    value="<%= horasCancelacion || 24 %>"
                    required>
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button class="btn admin-action-btn" type="submit">
                    Guardar configuración
                </button>
                <a href="/admin/campanas" class="btn btn-outline-secondary">
                    Volver a campañas
                </a>
            </div>
        </form>
    </div>
</section>
