<h2 class="mb-4">
Configurar campana activa
</h2>
<p class="text-muted">
Solo puede existir una campana activa. Para activarla, debe estar vigente dentro de la ventana de fechas configurada.
</p>

<div class="card p-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Campana</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Estado</th>
                    <th>Valida hoy</th>
                    <th>Accion</th>
                </tr>
            </thead>
            <tbody>
                <% campaigns.forEach((campaign) => { %>
                <tr>
                    <td>
                        <strong><%= campaign.name %></strong>
                        <div class="small text-muted"><%= campaign.description %></div>
                    </td>
                    <td><%= campaign.formattedStartDate %></td>
                    <td><%= campaign.formattedEndDate %></td>
                    <td>
                        <span class="badge <%= campaign.status === 'active' ? 'bg-success' : 'bg-secondary' %>">
                            <%= campaign.statusLabel %>
                        </span>
                    </td>
                    <td>
                        <span class="badge <%= campaign.isCurrentlyValid ? 'bg-info text-dark' : 'bg-light text-dark' %>">
                            <%= campaign.isCurrentlyValid ? 'Si' : 'No' %>
                        </span>
                    </td>
                    <td>
                        <% if (campaign.status === 'active') { %>
                        <form method="post" action="/admin/campanas/estado/<%= campaign.id %>/desactivar">
                            <button class="btn btn-outline-danger btn-sm" type="submit">
                            Desactivar
                            </button>
                        </form>
                        <% } else { %>
                        <form method="post" action="/admin/campanas/estado/<%= campaign.id %>/activar">
                            <button class="btn btn-outline-success btn-sm" type="submit" <%= campaign.canActivate ? '' : 'disabled' %>>
                            Activar
                            </button>
                        </form>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
