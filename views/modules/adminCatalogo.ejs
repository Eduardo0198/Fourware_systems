<section class="admin-shell">
    <%- include('../includes/admin/hero', {
        heroClass: 'admin-hero-catalog',
        eyebrow: 'Administrador',
        title: 'Gestión de Catálogo',
        subtitle: 'Centraliza el alta, mantenimiento y carga operativa de SKUs para mantener el catálogo listo para preventa.',
        note: {
            label: 'Estado del módulo',
            value: 'Catálogo operativo',
            help: 'Administra productos y vínculos con campañas vigentes.'
        }
    }) %>

    <div class="admin-stats-grid">
        <%- include('../includes/admin/statCard', {
            label: 'Productos registrados',
            value: totalProductos || 0,
            description: 'Inventario lógico disponible dentro del sistema.',
            accent: false
        }) %>
        <%- include('../includes/admin/statCard', {
            label: 'Campañas vigentes seleccionables',
            value: totalCampaniasVigentes || 0,
            description: 'Campañas activas o vigentes para asociar nuevos productos.',
            accent: true
        }) %>
    </div>

    <div class="admin-action-grid">
        <%- include('../includes/admin/actionCard', {
            iconClass: 'bi-box-seam',
            tag: 'Alta individual',
            title: 'Registrar SKU',
            description: 'Crea un producto nuevo, captura sus atributos base y asígnalo a una campaña válida.',
            href: '/admin/catalogo/registrar',
            buttonText: 'Registrar producto'
        }) %>

        <%- include('../includes/admin/actionCard', {
            iconClass: 'bi-pencil-square',
            iconVariantClass: 'admin-action-icon-alt',
            tag: 'Mantenimiento',
            title: 'Modificar atributos de un producto.',
            description: 'Actualiza información de productos ya registrados sin salir del flujo administrativo.',
            href: '/admin/catalogo/modificar',
            buttonText: 'Modificar atributos'
        }) %>

        <%- include('../includes/admin/actionCard', {
            iconClass: 'bi-cloud-arrow-up',
            iconVariantClass: 'admin-action-icon-soft',
            tag: 'Operación masiva',
            title: 'Carga masiva',
            description: 'Importa múltiples productos desde un archivo estructurado para acelerar la actualización del catálogo.',
            href: '/admin/catalogo/carga-masiva',
            buttonText: 'Subir archivo'
        }) %>
    </div>
</section>
