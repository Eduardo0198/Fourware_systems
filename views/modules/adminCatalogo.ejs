<h2 class="mb-4">
Gestión de Catálogo
</h2>
<p class="text-muted">
Administración de productos disponibles en el sistema de preventa.
</p>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3">
            <small class="text-muted">Productos registrados</small>
            <strong class="fs-4"><%= totalProductos || 0 %></strong>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <small class="text-muted">Campañas vigentes seleccionables</small>
            <strong class="fs-4"><%= totalCampaniasVigentes || 0 %></strong>
        </div>
    </div>
</div>
<div class="catalogo-grid">
    <div class="catalogo-card">
        <h5>
        Registrar SKU
        </h5>
        <p>
        Crear un nuevo producto dentro del catálogo.
        </p>
        <a href="/admin/catalogo/registrar"
        class="btn btn-primary">
        Registrar producto
        </a>
    </div>
    <div class="catalogo-card">
        <h5>
        Modificar SKU
        </h5>
        <p>
        Editar información de productos existentes.
        </p>
        <a href="/admin/catalogo/modificar"
        class="btn btn-primary">
        Modificar producto
        </a>
    </div>
    <div class="catalogo-card">
        <h5>
        Carga Masiva
        </h5>
        <p>
        Importar múltiples productos mediante archivo CSV o Excel.
        </p>
        <a href="/admin/catalogo/carga-masiva"
        class="btn btn-primary">
        Subir archivo
        </a>
    </div>
</div>
