<h2 class="mb-4">
Gestión de Campañas
</h2>
<p class="text-muted">
Administración de campañas de preventa.
</p>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3">
            <small class="text-muted">Total de campañas</small>
            <strong class="fs-4"><%= totalCampanias || 0 %></strong>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <small class="text-muted">Campañas activas hoy</small>
            <strong class="fs-4"><%= totalActivas || 0 %></strong>
        </div>
    </div>
</div>
<div class="catalogo-grid">
    <div class="catalogo-card">
        <h5>
        Crear Campaña
        </h5>
        <p>
        Registrar una nueva campaña en el sistema.
        </p>
        <a href="/admin/campanas/crear"
        class="btn btn-primary">
        Crear campaña
        </a>
    </div>
    <div class="catalogo-card">
        <h5>
        Editar Campaña
        </h5>
        <p>
        Modificar información y estatus de campañas existentes.
        </p>
        <a href="/admin/campanas/editar"
        class="btn btn-primary">
        Editar campaña
        </a>
    </div>
    <div class="catalogo-card">
        <h5>
        Ventana de Cancelación
        </h5>
        <p>
        Configurar tiempo permitido para cancelar reservas.
        </p>
        <a href="/admin/campanas/cancelacion"
        class="btn btn-primary">
        Configurar
        </a>
    </div>
</div>
<div class="card p-4 mt-4">
    <h4 class="mb-3">
    Campañas registradas
    </h4>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Campaña</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Banner</th>
                    <th>Estatus</th>
                </tr>
            </thead>
            <tbody>
                <% campanias.forEach((campania) => { %>
                    <tr>
                        <td><strong><%= campania.nombre %></strong></td>
                        <td><%= campania.fecha_inicio_texto %></td>
                        <td><%= campania.fecha_fin_texto %></td>
                        <td><small><%= campania.banner %></small></td>
                        <td>
                            <span class="badge <%= campania.estatus ? 'bg-success' : 'bg-secondary' %>">
                                <%= campania.estatusTexto %>
                            </span>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
