<section class="admin-shell">
    <%- include('../includes/admin/hero', {
        heroClass: 'admin-hero-campaigns',
        eyebrow: 'Administrador',
        title: 'Gestión de Campañas',
        subtitle: 'Supervisa la vigencia comercial del sistema, controla activaciones y mantén una sola campaña activa por temporada.',
        note: {
            label: 'Política activa',
            value: 'Una campaña activa a la vez',
            help: 'Cualquier activación adicional requiere desactivar la vigente.'
        }
    }) %>

    <div class="admin-stats-grid">
        <%- include('../includes/admin/statCard', {
            label: 'Total de campañas',
            value: totalCampanias || 0,
            description: 'Histórico registrado en el sistema de preventa.',
            accent: false
        }) %>
        <%- include('../includes/admin/statCard', {
            label: 'Campañas activas hoy',
            value: totalActivas || 0,
            description: 'Debe mantenerse en uno o cero según la temporada vigente.',
            accent: true
        }) %>
    </div>

    <div class="admin-action-grid">
        <%- include('../includes/admin/actionCard', {
            iconClass: 'bi-megaphone',
            tag: 'Configuración',
            title: 'Crear campaña',
            description: 'Registra nuevas campañas con nombre, vigencia y banner dentro del flujo administrativo.',
            href: '/admin/campanas/crear',
            buttonText: 'Crear campaña'
        }) %>

        <%- include('../includes/admin/actionCard', {
            iconClass: 'bi-sliders',
            iconVariantClass: 'admin-action-icon-alt',
            tag: 'Control operativo',
            title: 'Editar campaña',
            description: 'Modifica vigencia, banner y estatus, respetando la regla de una campaña activa por vez.',
            href: '/admin/campanas/editar',
            buttonText: 'Editar campaña'
        }) %>

        <%- include('../includes/admin/actionCard', {
            iconClass: 'bi-clock-history',
            iconVariantClass: 'admin-action-icon-soft',
            tag: 'Política de negocio',
            title: 'Ventana de cancelación',
            description: 'Consulta o configura la regla de tiempo permitida para cancelar reservas según la operación.',
            href: '/admin/campanas/cancelacion',
            buttonText: 'Configurar'
        }) %>
    </div>

    <div class="admin-table-card">
        <%- include('../includes/admin/tableHead', {
            title: 'Campañas registradas',
            subtitle: 'Resumen visual de vigencia, banner y estatus actual.',
            pillText: `Total: ${totalCampanias || 0}`
        }) %>
        <div class="admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Campaña</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Banner</th>
                        <th>Estatus</th>
                    </tr>
                </thead>
                <tbody>
                    <% campanias.forEach((campania) => { %>
                        <tr>
                            <td><strong><%= campania.nombre %></strong></td>
                            <td><%= campania.fecha_inicio_texto %></td>
                            <td><%= campania.fecha_fin_texto %></td>
                            <td><span class="admin-banner-chip"><%= campania.banner %></span></td>
                            <td>
                                <span class="admin-status-pill <%= campania.estatus ? 'is-active' : 'is-inactive' %>">
                                    <%= campania.estatusTexto %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</section>
