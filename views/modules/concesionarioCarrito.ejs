<%
function formatCurrency(value) {
    return Number(value || 0).toLocaleString('es-MX', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
}
%>

<section class="d-flex flex-column gap-4">
    <% if (mensaje) { %>
        <div class="alert alert-<%= mensaje.tipo %> mb-0" role="alert">
            <%= mensaje.texto %>
            <% if (mensaje.link && mensaje.linkTexto) { %>
                <a href="<%= mensaje.link %>" class="alert-link fw-bold ms-1"><%= mensaje.linkTexto %></a>
            <% } %>
        </div>
    <% } %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
        <div>
            <p class="cart-eyebrow">Preventa</p>
            <h2 class="display-6 fw-bold text-dark mb-0">Carrito</h2>
        </div>
        <span class="badge rounded-pill text-bg-primary px-3 py-2 fs-6 fw-semibold align-self-start align-self-md-auto">
            <%= carrito.length %> producto(s)
        </span>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="d-flex justify-content-end mb-3">
                <button type="button"
                        class="btn btn-outline-danger d-flex align-items-center gap-2"
                        <%= carrito.length === 0 ? 'disabled' : '' %>
                        data-bs-toggle="modal"
                        data-bs-target="#modalVaciarCarrito">
                    <i class="bi bi-trash3"></i>
                    Vaciar carrito
                </button>
            </div>

            <!-- Modal confirmación vaciar carrito -->
            <div class="modal fade" id="modalVaciarCarrito" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="modal-header border-0 px-4 pt-4 pb-2" style="background: linear-gradient(135deg, #7f1d1d, #b91c1c);">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;background:rgba(255,255,255,0.15);">
                                    <i class="bi bi-trash3-fill text-white fs-5"></i>
                                </div>
                                <h5 class="modal-title text-white fw-bold mb-0">Vaciar carrito</h5>
                            </div>
                            <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body px-4 py-4">
                            <p class="mb-1 fw-semibold text-dark">¿Estás seguro de que deseas vaciar el carrito?</p>
                            <p class="text-muted mb-0" style="font-size:.93rem;">
                                Se eliminarán los <strong><%= carrito.length %> producto(s)</strong> que tienes agregados. Esta acción no se puede deshacer.
                            </p>
                        </div>
                        <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                                Cancelar
                            </button>
                            <form method="POST" action="/concesionario/carrito/vaciar" class="m-0">
                                <button type="submit" class="btn btn-danger rounded-pill px-4 d-flex align-items-center gap-2">
                                    <i class="bi bi-trash3-fill"></i> Sí, vaciar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-column gap-3">
            <% if (carrito.length === 0) { %>
                <div class="cart-empty-state card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold">Tu carrito está vacío</h4>
                    <p class="text-muted">Agrega productos desde el catálogo para ver el resumen aquí.</p>
                    <a href="/concesionario/catalogo" class="btn btn-primary">
                        Ir al catálogo
                    </a>
                    </div>
                </div>
            <% } %>

            <% carrito.forEach(p => { %>
                <article class="card border-0 shadow-sm cart-item-card">
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-center">
                            <div class="col-md-3 col-lg-4 col-xl-3">
                                <div class="cart-item-media">
                                    <img src="<%= p.imagen || '/img/ppg-logo.png' %>"
                                         alt="<%= p.nombre %>"
                                         onerror="this.src='/img/ppg-logo.png'">
                                </div>
                            </div>

                            <div class="col-md-9 col-lg-8 col-xl-9">
                                <div class="d-flex flex-column gap-4">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                                        <div>
                                            <h3 class="fs-4 fw-bold text-dark mb-2"><%= p.nombre %></h3>
                                            <p class="text-muted mb-0">SKU: <%= p.sku %></p>
                                        </div>
                                        <div class="text-lg-end">
                                            <div class="fs-2 fw-bold text-dark">$<%= formatCurrency(p.precio) %></div>
                                            <div class="text-secondary fw-semibold">
                                                Total: <span id="item-total-<%= p.sku %>">$<%= formatCurrency(p.precio * p.cantidad) %></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pt-3 border-top">
                                        <div class="cart-quantity-form" data-sku="<%= p.sku %>">
                                            <button type="button"
                                                    class="cart-qty-btn cart-btn-dec"
                                                    <%= p.cantidad <= 1 ? 'disabled' : '' %>>
                                                -
                                            </button>

                                            <input type="number"
                                                   value="<%= p.cantidad %>"
                                                   min="1"
                                                   class="cart-qty-input"
                                                   data-sku="<%= p.sku %>"
                                                   data-original="<%= p.cantidad %>">

                                            <button type="button"
                                                    class="cart-qty-btn cart-btn-inc">
                                                +
                                            </button>
                                        </div>
                                        <form method="POST"
                                              action="/concesionario/carrito/eliminar"
                                              class="m-0">
                                            <input type="hidden" name="sku" value="<%= p.sku %>">
                                            <button type="submit" class="btn btn-link p-0 text-danger fw-bold text-decoration-none">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            <% }) %>
            </div>
        </div>

        <div class="col-xl-4">
        <aside class="card border-0 shadow-sm cart-summary-card">
            <div class="card-body p-4">
            <div>
                <p class="cart-eyebrow">Resumen</p>
                <h3 class="fs-2 fw-bold text-dark mb-0">Order summary</h3>
            </div>

            <div class="d-flex flex-column gap-3 border-top border-bottom py-3 my-4">
                <div class="d-flex justify-content-between align-items-center gap-3 text-secondary">
                    <span>Subtotal</span>
                    <strong id="sum-subtotal">$<%= formatCurrency(subtotal) %></strong>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3 text-secondary">
                    <span>Peso total</span>
                    <strong id="sum-peso"><%= totalPeso.toFixed(2) %> kg</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3 text-secondary">
                    <span>Volumen total</span>
                    <strong id="sum-volumen"><%= totalVolumen.toFixed(2) %> m³</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3 text-secondary">
                    <span>IVA (16%)</span>
                    <strong id="sum-iva">$<%= formatCurrency(iva) %></strong>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3 fs-5 fw-bold text-dark">
                    <span>Total</span>
                    <strong id="sum-total">$<%= formatCurrency(total) %></strong>
                </div>
            </div>

            <form method="POST" action="/concesionario/carrito/confirmar" class="d-flex flex-column gap-3" id="formConfirmar" novalidate>
                <div>
                    <label for="sucursal" class="form-label fw-semibold">Sucursal de entrega</label>
                    <select name="sucursal"
                            id="sucursal"
                            class="form-select"
                            <%= carrito.length === 0 || !sucursales || sucursales.length === 0 ? 'disabled' : '' %>>
                        <option value="">— Selecciona una sucursal —</option>
                        <% (sucursales || []).forEach(sucursal => { %>
                            <option value="<%= sucursal.id_sucursal %>">
                                <%= sucursal.nombre %><%= sucursal.municipio ? ' - ' + sucursal.municipio : '' %>
                            </option>
                        <% }) %>
                    </select>
                    <div id="sucursalError" class="alert alert-warning d-none mt-2 py-2 px-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Debes seleccionar una sucursal antes de confirmar la reserva.
                    </div>
                </div>

                <% if (!sucursales || sucursales.length === 0) { %>
                    <div class="alert alert-danger py-2 px-3 mb-0" role="alert">
                        <i class="bi bi-x-circle-fill me-1"></i>
                        No hay sucursales activas para la cuenta seleccionada.
                    </div>
                <% } %>

                <button id="btnConfirmar"
                        type="submit"
                        class="btn btn-primary cart-checkout-btn"
                        <%= carrito.length === 0 || !sucursales || sucursales.length === 0 ? 'disabled' : '' %>>
                    Confirmar reserva
                </button>
            </form>
            </div>
        </aside>
        </div>
    </div>
</section>

<script>
(function () {
    function fmt(value) {
        return Number(value || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    async function pedirActualizacion(sku, accion, cantidad) {
        const body = new URLSearchParams({ sku, accion });
        if (accion === 'establecer') body.set('cantidad', String(cantidad));
        const res = await fetch('/concesionario/carrito/actualizar-cantidad', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body.toString()
        });
        return res.json();
    }

    function aplicarRespuesta(sku, data) {
        if (data.recargar) { location.reload(); return; }
        if (!data.ok) return;

        const { nuevaCantidad, itemTotal, resumen } = data;
        const wrapper = document.querySelector(`.cart-quantity-form[data-sku="${sku}"]`);
        if (!wrapper) return;

        const input  = wrapper.querySelector('.cart-qty-input');
        const btnDec = wrapper.querySelector('.cart-btn-dec');

        input.value = nuevaCantidad;
        input.dataset.original = nuevaCantidad;
        btnDec.disabled = nuevaCantidad <= 1;

        const totalEl = document.getElementById(`item-total-${sku}`);
        if (totalEl) totalEl.textContent = '$' + fmt(itemTotal);

        document.getElementById('sum-subtotal').textContent = '$' + fmt(resumen.subtotal);
        document.getElementById('sum-peso').textContent     = resumen.totalPeso.toFixed(2) + ' kg';
        document.getElementById('sum-volumen').textContent  = resumen.totalVolumen.toFixed(2) + ' m³';
        document.getElementById('sum-iva').textContent      = '$' + fmt(resumen.iva);
        document.getElementById('sum-total').textContent    = '$' + fmt(resumen.total);
    }

    document.querySelectorAll('.cart-quantity-form').forEach(wrapper => {
        const sku   = wrapper.dataset.sku;
        const input = wrapper.querySelector('.cart-qty-input');
        const btnDec = wrapper.querySelector('.cart-btn-dec');
        const btnInc = wrapper.querySelector('.cart-btn-inc');

        async function ejecutar(accion, cantidad) {
            btnDec.disabled = true;
            btnInc.disabled = true;
            try {
                const data = await pedirActualizacion(sku, accion, cantidad);
                aplicarRespuesta(sku, data);
            } catch (e) {
                input.value = input.dataset.original;
            } finally {
                const actual = parseInt(input.value, 10);
                btnDec.disabled = actual <= 1;
                btnInc.disabled = false;
            }
        }

        btnDec.addEventListener('click', () => ejecutar('decrementar'));
        btnInc.addEventListener('click', () => ejecutar('incrementar'));

        input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); input.blur(); } });
        input.addEventListener('blur', () => {
            const val      = parseInt(input.value, 10);
            const original = parseInt(input.dataset.original, 10);
            if (isNaN(val) || val < 1) { input.value = original; return; }
            if (val === original) return;
            ejecutar('establecer', val);
        });
    });
})();

(function () {
    const form     = document.getElementById('formConfirmar');
    const select   = document.getElementById('sucursal');
    const btn      = document.getElementById('btnConfirmar');
    const errorMsg = document.getElementById('sucursalError');

    if (!form || !select || !btn) return;

    select.addEventListener('change', () => { errorMsg.classList.add('d-none'); });

    form.addEventListener('submit', (e) => {
        if (!select.value) {
            e.preventDefault();
            errorMsg.classList.remove('d-none');
            select.focus();
            select.classList.add('is-invalid');
            setTimeout(() => select.classList.remove('is-invalid'), 2000);
        }
    });
})();

(function () {
    function fmt(v) {
        return Number(v || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function actualizarResumen(resumen) {
        const s = document.getElementById('sum-subtotal');
        const p = document.getElementById('sum-peso');
        const v = document.getElementById('sum-volumen');
        const i = document.getElementById('sum-iva');
        const t = document.getElementById('sum-total');
        if (s) s.textContent = '$' + fmt(resumen.subtotal);
        if (p) p.textContent = Number(resumen.totalPeso || 0).toFixed(2) + ' kg';
        if (v) v.textContent = Number(resumen.totalVolumen || 0).toFixed(2) + ' m³';
        if (i) i.textContent = '$' + fmt(resumen.iva);
        if (t) t.textContent = '$' + fmt(resumen.total);
    }

    function mostrarVacio() {
        const lista = document.querySelector('.d-flex.flex-column.gap-3');
        if (!lista) return;
        lista.innerHTML = `
            <div class="cart-empty-state card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold">Tu carrito está vacío</h4>
                    <p class="text-muted">Agrega productos desde el catálogo para ver el resumen aquí.</p>
                    <a href="/concesionario/catalogo" class="btn btn-primary">Ir al catálogo</a>
                </div>
            </div>`;
    }

    function actualizarPill(count) {
        const pill = document.querySelector('.badge.rounded-pill.text-bg-primary');
        if (pill) pill.textContent = count + ' producto(s)';
        const btnVaciar = document.querySelector('[data-bs-target="#modalVaciarCarrito"]');
        const btnConfirmar = document.getElementById('btnConfirmar');
        const selectSucursal = document.getElementById('sucursal');
        if (count === 0) {
            if (btnVaciar) btnVaciar.disabled = true;
            if (btnConfirmar) btnConfirmar.disabled = true;
            if (selectSucursal) selectSucursal.disabled = true;
        }
    }

    document.addEventListener('submit', async function (e) {
        const form = e.target;

        if (form.matches("form[action*='carrito/eliminar']")) {
            e.preventDefault();
            const sku = form.querySelector('input[name="sku"]')?.value;
            const btn = form.querySelector('button[type="submit"]');
            if (btn) btn.disabled = true;
            try {
                const resp = await fetch('/concesionario/carrito/eliminar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: new URLSearchParams({ sku }).toString()
                });
                const data = await resp.json();
                if (!data.ok) { if (btn) btn.disabled = false; return; }
                const article = form.closest('article.cart-item-card');
                if (article) {
                    article.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                    article.style.opacity = '0';
                    article.style.transform = 'scale(0.97)';
                    setTimeout(() => article.remove(), 260);
                }
                actualizarResumen(data.resumen);
                actualizarPill(data.carritoCount);
                if (data.carritoCount === 0) setTimeout(mostrarVacio, 280);
            } catch (_) { form.submit(); }
            return;
        }

        if (form.matches("form[action*='carrito/vaciar']")) {
            e.preventDefault();
            const btn = form.querySelector('button[type="submit"]');
            if (btn) btn.disabled = true;
            try {
                const resp = await fetch('/concesionario/carrito/vaciar', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await resp.json();
                if (!data.ok) { if (btn) btn.disabled = false; return; }
                const modal = bootstrap.Modal.getInstance(document.getElementById('modalVaciarCarrito'));
                if (modal) modal.hide();
                document.querySelectorAll('article.cart-item-card').forEach(a => a.remove());
                const cero = { subtotal: 0, iva: 0, total: 0, totalPeso: 0, totalVolumen: 0 };
                actualizarResumen(cero);
                actualizarPill(0);
                mostrarVacio();
            } catch (_) { form.submit(); }
        }
    });
})();
</script>
