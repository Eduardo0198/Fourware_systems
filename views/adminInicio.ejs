<section class="d-flex flex-column gap-4">

    <%# Hero %>
    <div class="dealer-home-hero card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge text-bg-light text-uppercase fw-semibold mb-3">Panel administrativo</span>
                    <h2 class="display-6 fw-bold mb-2">Hola, <%= saludo %>.</h2>
                    <p class="lead mb-4">
                        Aquí tienes un resumen operativo del sistema. Gestiona el catálogo, las campañas y consulta la actividad reciente.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/admin/catalogo" class="btn btn-light px-4">
                            <i class="bi bi-box me-2"></i>Ir al catálogo
                        </a>
                        <a href="/admin/campanas" class="btn btn-outline-light px-4">
                            <i class="bi bi-megaphone me-2"></i>Campañas
                        </a>
                        <a href="/admin/reportes" class="btn btn-outline-light px-4">
                            <i class="bi bi-bar-chart me-2"></i>Reportes
                        </a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="dealer-home-hero-panel">
                        <div class="dealer-home-hero-item">
                            <span>Campaña vigente</span>
                            <strong><%= campania ? campania.nombre : 'Sin campaña activa' %></strong>
                        </div>
                        <div class="dealer-home-hero-item">
                            <span>Productos en catálogo</span>
                            <strong><%= productosTotal %></strong>
                        </div>
                        <div class="dealer-home-hero-item">
                            <span>Reservas confirmadas</span>
                            <strong><%= resumen.confirmadas %></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%# KPIs %>
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <article class="card border-0 shadow-sm h-100 dealer-home-stat">
                <div class="card-body">
                    <span class="dealer-home-stat-label">Reservas totales</span>
                    <strong class="dealer-home-stat-value"><%= resumen.total %></strong>
                    <p class="text-muted mb-0">Historial completo del sistema.</p>
                </div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-3">
            <article class="card border-0 shadow-sm h-100 dealer-home-stat">
                <div class="card-body">
                    <span class="dealer-home-stat-label">Confirmadas</span>
                    <strong class="dealer-home-stat-value text-success"><%= resumen.confirmadas %></strong>
                    <p class="text-muted mb-0">Preventas vigentes registradas.</p>
                </div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-3">
            <article class="card border-0 shadow-sm h-100 dealer-home-stat">
                <div class="card-body">
                    <span class="dealer-home-stat-label">Canceladas</span>
                    <strong class="dealer-home-stat-value text-secondary"><%= resumen.canceladas %></strong>
                    <p class="text-muted mb-0">Operaciones anuladas o vencidas.</p>
                </div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-3">
            <article class="card border-0 shadow-sm h-100 dealer-home-stat">
                <div class="card-body">
                    <span class="dealer-home-stat-label">Productos</span>
                    <strong class="dealer-home-stat-value text-primary"><%= productosTotal %></strong>
                    <p class="text-muted mb-0">SKUs registrados en catálogo.</p>
                </div>
            </article>
        </div>
    </div>

    <%# Actividad reciente + Acciones %>
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="h5 mb-1">Actividad reciente</h3>
                            <p class="text-muted mb-0 small">Últimas reservas registradas en el sistema.</p>
                        </div>
                        <a href="/admin/reportes" class="btn btn-outline-secondary btn-sm">
                            Ver reportes
                        </a>
                    </div>

                    <% if (reservasRecientes.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Folio</th>
                                        <th>Fecha</th>
                                        <th>Concesionario</th>
                                        <th>Cuenta</th>
                                        <th>Total</th>
                                        <th>Estatus</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% reservasRecientes.forEach(r => { %>
                                        <tr>
                                            <td class="fw-semibold text-primary"><%= r.folio %></td>
                                            <td><%= r.fechaTexto %></td>
                                            <td><%= r.concesionario %></td>
                                            <td class="text-muted small"><%= r.cuenta %></td>
                                            <td><%= r.totalTexto %></td>
                                            <td>
                                                <span class="badge text-bg-<%= r.estatusClase %>">
                                                    <%= r.estatusTexto %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="dealer-home-empty dealer-home-empty-soft">
                            <i class="bi bi-journal-x"></i>
                            <h4 class="h6">Aún no hay reservas en el sistema</h4>
                            <p class="text-muted mb-0">Las reservas confirmadas por los concesionarios aparecerán aquí.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h3 class="h5 mb-3">Acciones rápidas</h3>
                    <div class="d-grid gap-3">
                        <a href="/admin/catalogo" class="dealer-home-action text-decoration-none">
                            <div>
                                <strong>Catálogo</strong>
                                <p class="mb-0">Registra, edita o carga productos masivamente.</p>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="/admin/campanas" class="dealer-home-action text-decoration-none">
                            <div>
                                <strong>Campañas</strong>
                                <p class="mb-0">Activa, edita o cierra campañas de preventa.</p>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="/admin/reportes" class="dealer-home-action text-decoration-none">
                            <div>
                                <strong>Reportes</strong>
                                <p class="mb-0">Genera reportes de preventas por período.</p>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="/admin/auditoria" class="dealer-home-action text-decoration-none">
                            <div>
                                <strong>Bitácora</strong>
                                <p class="mb-0">Revisa la auditoría de acciones del sistema.</p>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
